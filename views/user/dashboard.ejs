<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Team Dashboard - Live Auction</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/socket.io/socket.io.js"></script>
</head>

<body style="overflow: hidden; height: 100vh; margin: 0; padding: 0; background-color: var(--bg-dark);">
    <div class="glow-orb orb-1"></div>
    <div class="glow-orb orb-2"></div>
    <%
      const unitsLocal = data.auctionDetails && data.auctionDetails.units ? data.auctionDetails.units : '₹';
      const formatCurrencyLocal = (amt) => {
        return ['₹', '$', '€', '£'].includes(unitsLocal) ? `${unitsLocal}${amt.toLocaleString()}` : `${amt.toLocaleString()} ${unitsLocal}`;
      };
    %>
    <div class="app-container" style="display: flex; flex-direction: column; height: 100vh; width: 100vw; max-width: 100%; overflow: hidden;">
        <!-- Header -->
        <header class="topbar" style="height: 60px; flex-shrink: 0; background: #0f1115 !important; border-bottom: 1px solid rgba(255,255,255,0.05) !important; padding: 0 1.5rem !important; display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 1.5rem; height: 100%;">
                <!-- Logo & League Name -->
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <% if (data.auctionDetails && data.auctionDetails.logo) { %>
                        <img src="<%= data.auctionDetails.logo %>" style="width: 32px; height: 32px; border-radius: 50%; object-fit: contain;">
                    <% } else { %>
                        <div style="font-size: 1.5rem;">🏆</div>
                    <% } %>
                    <h1 style="font-size: 1.3rem; margin: 0; font-weight: 900; color: #fff; font-family: 'Plus Jakarta Sans', sans-serif; text-transform: uppercase; letter-spacing: -0.5px;"><%= data.auctionDetails ? data.auctionDetails.name : 'ELITE PREMIER LEAGUE' %></h1>
                </div>
                
                <div style="width: 1px; height: 30px; background: rgba(255,255,255,0.1);"></div>
                
                <!-- Sponsor -->
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <div style="color: rgba(255,255,255,0.4); font-size: 0.55rem; text-transform: uppercase; line-height: 1.2; font-weight: 700;">PRESENTED<br>BY</div>
                    <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 0.3rem 1rem; border-radius: 4px; font-size: 0.65rem; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 1px; font-weight: 700;">SPONSOR</div>
                </div>
            </div>

            <!-- Center Indicators -->
            <div style="display: flex; align-items: center; gap: 0.8rem;">
                <div style="background: rgba(255,255,255,0.05); padding: 0.2rem 1.2rem; border-radius: 4px; font-size: 0.55rem; color: rgba(255,255,255,0.5); text-transform: uppercase; text-align: center; font-weight: 700; border: 1px solid rgba(255,255,255,0.1);">SIM:<br><span style="color:#fff;">SOLD</span></div>
                <div style="background: rgba(255,255,255,0.05); padding: 0.2rem 1.2rem; border-radius: 4px; font-size: 0.55rem; color: rgba(255,255,255,0.5); text-transform: uppercase; text-align: center; font-weight: 700; border: 1px solid rgba(255,255,255,0.1);">SIM:<br><span style="color:#fff;">UNSOLD</span></div>
                <div style="background: rgba(220, 38, 38, 0.15); border: 1px solid rgba(220, 38, 38, 0.3); padding: 0.4rem 1.5rem; border-radius: 20px; font-size: 0.65rem; color: rgba(255, 180, 180, 0.9); text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: center; gap: 0.5rem; font-weight: 800;">
                    <span style="width: 6px; height: 6px; background: #ef4444; border-radius: 50%; box-shadow: 0 0 5px #ef4444; animation: tvPulse 1.5s infinite;"></span> AUCTION LIVE
                </div>
            </div>

            <!-- Right Info -->
            <div style="display: flex; align-items: center; gap: 1.5rem;">
                <div style="color: rgba(255,255,255,0.5); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 700;">PLAYER <span style="color: #fff; font-size: 1rem; font-weight: 800;">#<span id="navPlayerId">--</span></span></div>
                <div style="color: rgba(255,255,255,0.5); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 700;">ROUND <span id="navRound" style="color: #fff; font-size: 1rem; font-weight: 800;">1</span></div>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <div style="color: rgba(255,255,255,0.5); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 700;">TIMER</div>
                    <div id="liveTimer" style="color: #fff; font-size: 1.2rem; font-weight: 800; font-family: monospace;">00:30</div>
                </div>
            </div>
        </header>

        <!-- Main Workspace -->
        <div style="flex: 1; overflow: hidden; height: calc(100vh - 60px);">
            <div class="grid" style="display: grid; grid-template-columns: 32% 34% 34%; height: 100%; width: 100%; gap: 1.5rem; padding: 1.5rem; background: #0f1115;">
                
                <!-- 1. Left Column: Player Profile -->
                <div style="display: flex; flex-direction: column; height: 100%; gap: 1rem; position: relative;">
                    <!-- Image Section (Top Half) -->
                    <div style="position: relative; height: 48%; width: 100%; overflow: hidden; background: #1a1c23; border: 1px solid rgba(255,255,255,0.05); border-radius: 6px;">
                        <img id="livePlayerPhoto" src="/uploads/default-player.svg" style="width: 100%; height: 100%; object-fit: cover; filter: grayscale(10%) contrast(1.1); object-position: top;">
                        
                        <div id="playerImageStatusOverlay" style="position: absolute; inset: 0; background: rgba(220, 38, 38, 0.4); mix-blend-mode: multiply; opacity: 0; transition: opacity 0.3s ease; z-index: 1;"></div>
                        <div id="playerStatusStamp" style="position: absolute; top: 45%; left: 50%; transform: translate(-50%, -50%) scale(0.8); font-size: 5rem; font-weight: 900; font-family: 'Plus Jakarta Sans', sans-serif; color: rgba(255, 180, 180, 0.95); text-shadow: 0 0 80px rgba(220, 38, 38, 1), 0 0 30px rgba(220, 38, 38, 1); letter-spacing: -2px; opacity: 0; transition: all 0.4s; z-index: 2;">UNSOLD</div>
                        
                        <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 60%; background: linear-gradient(to top, rgba(26,28,35,1) 0%, transparent 100%); z-index: 3;"></div>
                        <div style="position: absolute; bottom: 15px; left: 20px; z-index: 4;">
                            <div id="livePlayerRole" style="font-size: 0.75rem; color: rgba(255,255,255,0.6); text-transform: uppercase; font-weight: 800; letter-spacing: 1.5px; margin-bottom: 0.1rem;">BATSMAN</div>
                            <h2 id="livePlayerName" style="font-size: 2.8rem !important; margin: 0; line-height: 1; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 900; text-transform: uppercase; letter-spacing: -1px; color: #fff;">Waiting...</h2>
                        </div>
                    </div>
                    
                    <!-- Stats Grid Section (Bottom Half) -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; grid-auto-rows: min-content; gap: 0.4rem; flex: 1;">
                        <div style="background: #1a1c23; border: 1px solid rgba(255,255,255,0.03); border-radius: 4px; padding: 1rem;">
                            <div style="font-size: 0.6rem; color: rgba(255,255,255,0.5); text-transform: uppercase; font-weight: 800; margin-bottom: 0.2rem;">MATCHES</div>
                            <div style="font-size: 1.3rem; color: #fff; font-weight: 800;">234</div>
                        </div>
                        <div style="background: #1a1c23; border: 1px solid rgba(255,255,255,0.03); border-radius: 4px; padding: 1rem;">
                            <div style="font-size: 0.6rem; color: rgba(255,255,255,0.5); text-transform: uppercase; font-weight: 800; margin-bottom: 0.2rem;">RUNS</div>
                            <div style="font-size: 1.3rem; color: #fff; font-weight: 800;">7263</div>
                        </div>
                        <div style="background: #1a1c23; border: 1px solid rgba(255,255,255,0.03); border-radius: 4px; padding: 1rem;">
                            <div style="font-size: 0.6rem; color: rgba(255,255,255,0.5); text-transform: uppercase; font-weight: 800; margin-bottom: 0.2rem;">SR</div>
                            <div style="font-size: 1.3rem; color: #fff; font-weight: 800;">130.4</div>
                        </div>
                        <div style="background: #1a1c23; border: 1px solid rgba(255,255,255,0.03); border-radius: 4px; padding: 1rem;">
                            <div style="font-size: 0.6rem; color: rgba(255,255,255,0.5); text-transform: uppercase; font-weight: 800; margin-bottom: 0.2rem;">AVG</div>
                            <div style="font-size: 1.3rem; color: #fff; font-weight: 800;">37.2</div>
                        </div>
                        <div style="background: #1a1c23; border: 1px solid rgba(255,255,255,0.03); border-radius: 4px; padding: 1rem;">
                            <div style="font-size: 0.6rem; color: rgba(255,255,255,0.5); text-transform: uppercase; font-weight: 800; margin-bottom: 0.2rem;">AGE</div>
                            <div id="livePlayerAge" style="font-size: 1.3rem; color: #fff; font-weight: 800;">--</div>
                        </div>
                        <div style="background: #1a1c23; border: 1px solid rgba(255,255,255,0.03); border-radius: 4px; padding: 1rem;">
                            <div style="font-size: 0.6rem; color: rgba(255,255,255,0.5); text-transform: uppercase; font-weight: 800; margin-bottom: 0.2rem;">CATEGORY</div>
                            <div id="liveCategoryDisplay" style="font-size: 1.1rem; color: #fff; font-weight: 800;">--</div>
                        </div>
                        <div style="background: #1a1c23; border: 1px solid rgba(255,255,255,0.03); border-radius: 4px; padding: 1rem; grid-column: span 2;">
                            <div style="font-size: 0.6rem; color: rgba(255,255,255,0.5); text-transform: uppercase; font-weight: 800; margin-bottom: 0.2rem;">BASE PRICE</div>
                            <div id="liveBasePriceDisplay" style="font-size: 1.3rem; color: #fff; font-weight: 800;">--</div>
                        </div>
                    </div>
                </div>

                <!-- 2. Middle Column: Bid Panel -->
                <div style="display: flex; flex-direction: column; height: 100%; overflow: hidden; position: relative;">
                    <!-- Current Bid Block -->
                    <div style="background: #14151a; border-top: 4px solid #fbbf24; border-radius: 4px 4px 0 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem 1.5rem; margin-bottom: 0.4rem; text-align: center; border-bottom: 1px solid rgba(255,255,255,0.02);">
                        <div style="font-size: 0.75rem; color: rgba(255,255,255,0.8); text-transform: uppercase; letter-spacing: 2px; font-weight: 800; margin-bottom: 0.75rem;">CURRENT BID</div>
                        <div id="liveBidAmount" style="font-size: 3.5rem; color: #fbbf24; font-weight: 900; font-family: 'Plus Jakarta Sans', sans-serif; line-height: 1; letter-spacing: -1px; margin-bottom: 2rem;"><%= formatCurrencyLocal(data.auctionState.currentBid || 0) %></div>
                        
                        <div style="width: 100%; height: 1px; background: rgba(255,255,255,0.05); margin-bottom: 1.5rem;"></div>
                        
                        <div style="display: flex; align-items: center; gap: 1rem;">
                            <div id="currentBidderLogoBox" style="width: 45px; height: 45px; background: #1a1c23; border-radius: 6px; display: flex; align-items: center; justify-content: center;">
                                🏆
                            </div>
                            <div style="text-align: left;">
                                <div style="font-size: 0.65rem; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 1.5px; font-weight: 800; margin-bottom: 0.2rem;">CURRENT BIDDER</div>
                                <div id="liveHighestBidder" style="font-size: 1.5rem; color: #fff; font-weight: 900; text-transform: uppercase; letter-spacing: -0.5px;"><%= data.auctionState.highestBidder ? data.auctionState.highestBidder : 'NO BIDS YET' %></div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Bid History Block -->
                    <div style="background: #14151a; flex: 1; display: flex; flex-direction: column; padding: 1.5rem; overflow: hidden; border-radius: 0 0 4px 4px;">
                        <div style="font-size: 0.75rem; color: #fff; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1.5rem;">BID HISTORY</div>
                        <div id="bidHistoryList" class="sleek-scroll" style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 0;">
                            <div id="bidHistoryEmptyMsg" style="color: rgba(255,255,255,0.3); font-size: 0.8rem; font-style: italic;">Waiting for bids...</div>
                        </div>
                    </div>
                    
                    <!-- Unsold Overlay for Middle Column -->
                    <div id="bidHistoryUnsoldOverlay" style="position: absolute; inset: 0; background: rgba(20, 10, 10, 0.95); border: 1px solid rgba(220, 38, 38, 0.1); border-radius: 4px; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.3s ease; backdrop-filter: blur(4px);">
                        <div style="font-size: 0.85rem; color: rgba(220, 38, 38, 0.9); font-weight: 800; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 0.75rem;">AUCTION STATUS</div>
                        <div style="font-size: 4.5rem; color: rgba(220, 38, 38, 0.4); font-weight: 900; font-family: 'Plus Jakarta Sans', sans-serif; letter-spacing: -2px; margin-bottom: 2rem; line-height: 1;">PASSED</div>
                        <div style="background: rgba(220, 38, 38, 0.15); border: 1px solid rgba(220, 38, 38, 0.25); padding: 1rem 2rem; border-radius: 6px; font-size: 1.2rem; color: rgba(220, 38, 38, 0.9); font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase;">NO BIDS RECEIVED</div>
                    </div>
                </div>

                <!-- 3. Right Column: Team Purses -->
                <div style="display: flex; flex-direction: column; height: 100%; overflow: hidden;">
                    <div style="background: #14151a; border-radius: 6px; padding: 1.5rem; flex: 1; display: flex; flex-direction: column; border: 1px solid rgba(255,255,255,0.02);">
                        <!-- Auction Progress -->
                        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
                            <div style="font-size: 0.8rem; color: #fff; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">AUCTION PROGRESS</div>
                            <div style="font-size: 1.5rem; color: #fff; font-weight: 900;">65%</div>
                        </div>
                        <div style="height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden; margin-bottom: 2rem;">
                            <div style="background: #cbd5e1; width: 65%; height: 100%;"></div>
                        </div>

                        <div style="font-size: 0.8rem; color: #fff; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1.5rem;">TEAM PURSES</div>
                        
                        <div id="teamList" class="sleek-scroll" style="overflow-y: auto; flex: 1; display: flex; flex-direction: column; gap: 1.25rem;">
                            <% data.teams.sort((a, b) => a.name.localeCompare(b.name)).forEach((team, index) => { %>
                                <% const teamPlayers = data.players.filter(p => p.soldTo === team.name); %>
                                <div class="team-card" data-teamname="<%= team.name %>" style="display: flex; flex-direction: column; gap: 0.6rem;">
                                    <div style="display: flex; justify-content: space-between; align-items: center;">
                                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                                            <% if (team.logo) { %>
                                                <img src="<%= team.logo %>" style="width: 28px; height: 28px; background: #cbd5e1; padding: 2px; border-radius: 50%; object-fit: contain;">
                                            <% } else { %>
                                                <div style="width: 28px; height: 28px; background: #cbd5e1; color: #000; font-size: 0.5rem; font-weight: 900; display: flex; align-items: center; justify-content: center; border-radius: 50%;">IMG</div>
                                            <% } %>
                                            <div style="font-size: 1rem; color: #fff; font-weight: 800; text-transform: uppercase;"><%= team.shortName || team.name %></div>
                                        </div>
                                        <div style="font-size: 1.5rem; font-weight: 900; color: #fff;"><%= formatCurrencyLocal(team.budget) %></div>
                                    </div>
                                    
                                    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
                                        <div>
                                            <div style="font-size: 0.55rem; color: rgba(255,255,255,0.5); text-transform: uppercase; font-weight: 800; margin-bottom: 0.1rem;">MAX BID</div>
                                            <div style="font-size: 0.7rem; color: rgba(255,255,255,0.8); font-weight: 700;"><%= formatCurrencyLocal(team.budget * 0.8) %></div>
                                        </div>
                                        <div style="text-align: right;">
                                            <div style="font-size: 0.55rem; color: rgba(255,255,255,0.5); text-transform: uppercase; font-weight: 800; margin-bottom: 0.1rem;">PLAYERS</div>
                                            <div style="font-size: 0.7rem; color: rgba(255,255,255,0.8); font-weight: 700;"><%= teamPlayers.length %>/25</div>
                                        </div>
                                    </div>
                                    
                                    <!-- Progress Bar Line -->
                                    <div style="height: 4px; background: rgba(255,255,255,0.1); border-radius: 2px; overflow: hidden; margin-top: 0.2rem;">
                                        <div style="background: <%= team.color %>; height: 100%; width: <%= Math.min(100, ((teamPlayers.length / 25) * 100)) %>%;"></div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Store username in a hidden element for JS access -->
        <div id="teamNameData" data-teamname="<%= username %>" style="display: none;"></div>
    </div>
    <script>
        window.auctionCurrencyUnit = "<%= data.auctionDetails && data.auctionDetails.units ? data.auctionDetails.units : '₹' %>";
        window.auctionMaxPlayers = parseInt("<%= data.auctionDetails && data.auctionDetails.playersPerTeamMax ? data.auctionDetails.playersPerTeamMax : 15 %>", 10) || 15;
        window.auctionBaseBid = parseFloat("<%= data.auctionDetails && data.auctionDetails.baseBid ? data.auctionDetails.baseBid : 500 %>") || 500;
        window.auctionBidIncreaseBy = parseFloat("<%= data.auctionDetails && data.auctionDetails.bidIncreaseBy ? data.auctionDetails.bidIncreaseBy : 500 %>") || 500;
        window.auctionState = <%- JSON.stringify(data.auctionState) %>;
    </script>
    <script src="/js/user.js?v=<%= Date.now() %>"></script>
    <script>
        function toggleRoster(teamName) {
            const card = document.querySelector(`.team-card[data-teamname="${teamName}"]`);
            const tray = card.querySelector('.team-roster-list');
            const arrow = card.querySelector('.toggle-arrow');
            
            if (tray.style.display === 'none') {
                tray.style.display = 'flex';
                arrow.textContent = '▲';
                card.style.background = 'var(--bg-secondary)';
            } else {
                tray.style.display = 'none';
                arrow.textContent = '▼';
                card.style.background = 'var(--bg-card)';
            }
        }
    </script>
</body>
</html>
