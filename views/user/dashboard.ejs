<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Team Dashboard - Live Auction</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/socket.io/socket.io.js"></script>
</head>

<body class="live-body" style="overflow: hidden; height: 100vh; margin: 0; padding: 0; background-color: var(--bg-dark);">
    <div class="glow-orb orb-1"></div>
    <div class="glow-orb orb-2"></div>
    <%
      const unitsLocal = data.auctionDetails && data.auctionDetails.units ? data.auctionDetails.units : '₹';
      const formatCurrencyLocal = (amt) => {
        return ['₹', '$', '€', '£'].includes(unitsLocal) ? `${unitsLocal}${amt.toLocaleString()}` : `${amt.toLocaleString()} ${unitsLocal}`;
      };
    %>
    <div class="app-container" id="liveAppContainer" style="display: flex; flex-direction: column; height: 100vh; width: 100%; max-width: 100%; overflow: hidden;">
        <!-- Header -->
        <header class="topbar live-topbar" style="height: 60px; flex-shrink: 0; background: #0f1115 !important; border-bottom: 1px solid rgba(255,255,255,0.05) !important; padding: 0 1.5rem !important; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;">
            <!-- Left Section: League, Timer & Sponsor -->
            <div class="live-topbar-left" style="display: flex; align-items: center; gap: 1.5rem; height: 100%;">
                <!-- Logo & League Name -->
                <div class="live-league-name" style="display: flex; align-items: center; gap: 0.75rem;">
                    <% if (data.auctionDetails && data.auctionDetails.logo) { %>
                        <img src="<%= data.auctionDetails.logo %>" style="width: 32px; height: 32px; border-radius: 50%; object-fit: contain;">
                    <% } else { %>
                        <div style="font-size: 1.5rem;">🏆</div>
                    <% } %>
                    <div style="display: flex; flex-direction: column; max-width: 260px;">
                        <h1 class="league-title-broadcast" style="font-size: 1.05rem; margin: 0; font-weight: 900; text-transform: uppercase; letter-spacing: -0.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= data.auctionDetails ? data.auctionDetails.name : 'ELITE PREMIER LEAGUE' %>"><%= data.auctionDetails ? data.auctionDetails.name : 'ELITE PREMIER LEAGUE' %></h1>
                        <div style="font-size: 0.85rem; font-weight: 800; color: #fbbf24; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= data.auctionDetails && data.auctionDetails.season ? data.auctionDetails.season : '2026' %></div>
                    </div>
                </div>
                
                <!-- ROUND & TIMER -->
                <div id="navRoundTimerWrapper" class="live-round-timer" style="display: flex; align-items: center; border-left: 1px solid rgba(255,255,255,0.08); padding-left: 1.25rem;">
                    <div style="display: flex; flex-direction: column; justify-content: center;">
                        <div style="color: rgba(255,255,255,0.5); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 700;">ROUND</div>
                        <div id="navRound" style="color: #fff; font-size: 1.1rem; font-weight: 900; font-family: 'Plus Jakarta Sans', sans-serif;"><%= (data.auctionState && data.auctionState.round) ? data.auctionState.round : 1 %></div>
                    </div>
                    
                    <div style="display: flex; flex-direction: column; justify-content: center; margin-left: 1rem;">
                        <div style="color: rgba(255,255,255,0.5); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 700;">TIMER</div>
                        <div id="liveTimer" style="color: #fff; font-size: 1.1rem; font-weight: 900; font-family: monospace;">00:30</div>
                    </div>
                </div>
                
                <!-- Sponsor (Full width & clear visibility) -->
                <div class="live-header-sponsor" style="display: flex; align-items: center; gap: 0.6rem; border-left: 1px solid rgba(255,255,255,0.08); padding-left: 1.25rem;">
                    <div style="color: rgba(255,255,255,0.4); font-size: 0.55rem; text-transform: uppercase; line-height: 1.2; font-weight: 700;">PRESENTED<br>BY</div>
                    <div id="liveSponsorContainer" style="display: flex; align-items: center;">
                        <% if (data.auctionDetails && data.auctionDetails.sponsorLogo) { %>
                            <img id="liveSponsorLogoImg" src="<%= data.auctionDetails.sponsorLogo %>" alt="<%= (data.auctionDetails && data.auctionDetails.sponsorName) ? data.auctionDetails.sponsorName : 'Sponsor' %>" style="max-height: 38px; max-width: 140px; object-fit: contain; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.5));">
                        <% } else if (data.auctionDetails && data.auctionDetails.sponsorName) { %>
                            <div id="liveSponsorNameText" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 0.3rem 1rem; border-radius: 4px; font-size: 0.7rem; color: #fbbf24; text-transform: uppercase; letter-spacing: 1px; font-weight: 800;"><%= data.auctionDetails.sponsorName %></div>
                        <% } else { %>
                            <div id="liveSponsorDefault" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 0.3rem 1rem; border-radius: 4px; font-size: 0.65rem; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 1px; font-weight: 700;">SPONSOR</div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Right Section: Navigation Options & Indicators -->
            <div class="live-topbar-right" style="display: flex; align-items: center; gap: 0.75rem; margin-left: auto;">
                
                <!-- Desktop Navigation Options Tabs -->
                <div id="navCenterHome" class="live-nav-tabs" style="display: flex; align-items: center; gap: 0.65rem;">
                    <div id="tabLiveBid" onclick="toggleLiveBidView()" style="cursor: pointer; border: 1px solid #fbbf24; border-radius: 6px; padding: 0.25rem 0.9rem; color: #fbbf24; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; text-align: center; transition: all 0.2s; white-space: nowrap;">LIVE<br>BID</div>
                    <div id="tabPlayerList" onclick="togglePlayerListView()" style="cursor: pointer; border: 1px solid transparent; border-radius: 6px; padding: 0.25rem 0.9rem; color: rgba(255,255,255,0.5); font-size: 0.7rem; font-weight: 800; text-transform: uppercase; text-align: center; transition: all 0.2s; white-space: nowrap;">PLAYER<br>LIST</div>
                    <div id="tabTeamView" onclick="toggleTeamView()" style="cursor: pointer; border: 1px solid transparent; border-radius: 6px; padding: 0.25rem 0.9rem; color: rgba(255,255,255,0.5); font-size: 0.7rem; font-weight: 800; text-transform: uppercase; text-align: center; transition: all 0.2s; white-space: nowrap;">TEAM<br>VIEW</div>
                </div>

                <div class="live-nav-divider" style="width: 1px; height: 28px; background: rgba(255,255,255,0.1);"></div>

                <!-- Shared Auction Live Indicator -->
                <div id="navIndicatorLive" onclick="toggleLiveBidView()" style="cursor: pointer; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); padding: 0.25rem 1.1rem; border-radius: 20px; font-size: 0.6rem; color: rgba(167, 243, 208, 0.95); text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: center; gap: 0.5rem; font-weight: 800; transition: all 0.3s; text-align: left; white-space: nowrap; box-shadow: 0 0 10px rgba(16, 185, 129, 0.15);">
                    <span id="navIndicatorLiveDot" style="width: 6px; height: 6px; background: #10b981; border-radius: 50%; box-shadow: 0 0 8px #10b981, 0 0 14px rgba(16, 185, 129, 0.5); animation: liveGreenPulse 1.2s infinite ease-in-out;"></span> 
                    <div class="live-indicator-text-desktop">AUCTION<br><span style="color:#10b981; font-weight: 900;">LIVE</span></div>
                    <div class="live-indicator-text-mobile" style="color: #10b981; font-weight: 900; font-size: 0.72rem; letter-spacing: 0.5px;">LIVE</div>
                </div>
                
                <!-- Player ID -->
                <div class="live-nav-player-id" style="display: flex; flex-direction: column; text-align: right; margin-left: 0.25rem; min-width: 48px;">
                    <div style="color: rgba(255,255,255,0.5); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 700;">PLAYER</div>
                    <div style="color: #fff; font-size: 1.1rem; font-weight: 900; font-family: 'Plus Jakarta Sans', sans-serif;">#<span id="navPlayerId"><%= (data.auctionState && data.auctionState.currentPlayer) ? (data.auctionState.currentPlayer.formNo || (String(data.auctionState.currentPlayer.id).length > 6 ? '..' + String(data.auctionState.currentPlayer.id).slice(-5) : data.auctionState.currentPlayer.id)) : '--' %></span></div>
                </div>

                <!-- Responsive Three Lines Hamburger Menu Button -->
                <button type="button" id="mobileMenuBtn" class="mobile-menu-btn" onclick="toggleMobileNavMenu()" aria-label="Toggle Navigation Menu" title="Menu">
                    <span class="hamburger-bar"></span>
                    <span class="hamburger-bar"></span>
                    <span class="hamburger-bar"></span>
                </button>
            </div>
        </header>

        <!-- Mobile Navigation Drawer & Backdrop ("Three Lines" Menu) -->
        <div id="mobileNavBackdrop" class="mobile-nav-backdrop" onclick="closeMobileNavMenu()"></div>
        <div id="mobileNavDrawer" class="mobile-nav-drawer">
            <div class="mobile-nav-header">
                <div class="mobile-nav-title">
                    <span style="color: #fbbf24; font-size: 1.25rem;">⚡</span>
                    <span>AUCTION OPTIONS</span>
                </div>
                <button type="button" class="mobile-nav-close" onclick="closeMobileNavMenu()" aria-label="Close Menu">✕</button>
            </div>
            
            <div class="mobile-nav-menu-list">
                <button type="button" id="mobileTabLiveBid" class="mobile-nav-item active" onclick="selectMobileTab('live')">
                    <span class="nav-icon">⚡</span>
                    <div class="nav-text">
                        <span class="nav-title">LIVE BID</span>
                        <span class="nav-desc">Real-time player bidding & stage</span>
                    </div>
                    <span class="nav-badge live-badge">LIVE</span>
                </button>

                <button type="button" id="mobileTabPlayerList" class="mobile-nav-item" onclick="selectMobileTab('players')">
                    <span class="nav-icon">📋</span>
                    <div class="nav-text">
                        <span class="nav-title">PLAYER LIST</span>
                        <span class="nav-desc">Full player roster, base price & sold status</span>
                    </div>
                    <span class="nav-badge count-badge" id="mobilePlayersCount"><%= data.players ? data.players.length : 0 %></span>
                </button>

                <button type="button" id="mobileTabTeamView" class="mobile-nav-item" onclick="selectMobileTab('teams')">
                    <span class="nav-icon">🛡️</span>
                    <div class="nav-text">
                        <span class="nav-title">TEAM VIEW</span>
                        <span class="nav-desc">Franchise squads, purse budgets & rosters</span>
                    </div>
                    <span class="nav-badge count-badge" id="mobileTeamsCount"><%= data.teams ? data.teams.length : 0 %></span>
                </button>
            </div>

            <div class="mobile-nav-footer">
                <div style="font-size: 0.65rem; color: rgba(255,255,255,0.4); text-transform: uppercase; font-weight: 700; margin-bottom: 0.3rem;">LEAGUE / TOURNAMENT</div>
                <div style="color: #fbbf24; font-weight: 800; font-size: 0.95rem; font-family: 'Plus Jakarta Sans', sans-serif;"><%= data.auctionDetails ? data.auctionDetails.name : 'ELITE PREMIER LEAGUE' %></div>
                <div style="font-size: 0.75rem; color: rgba(255,255,255,0.6); margin-top: 0.2rem;">Season <%= data.auctionDetails && data.auctionDetails.season ? data.auctionDetails.season : '2026' %></div>
            </div>
        </div>

        <script>
            window.playersCache = <%- JSON.stringify(data.players || []) %>;
            window.teamsCache = <%- JSON.stringify(data.teams || []) %>;
            window.categoriesCache = <%- JSON.stringify(data.categories || []) %>;

            function updateActiveNav(activeKey) {
                const btnLiveBid = document.getElementById('tabLiveBid');
                const btnPlayerList = document.getElementById('tabPlayerList');
                const btnTeamView = document.getElementById('tabTeamView');
                
                const mLive = document.getElementById('mobileTabLiveBid');
                const mPlayers = document.getElementById('mobileTabPlayerList');
                const mTeams = document.getElementById('mobileTabTeamView');

                if (btnLiveBid) {
                    btnLiveBid.style.borderColor = activeKey === 'live' ? '#fbbf24' : 'transparent';
                    btnLiveBid.style.color = activeKey === 'live' ? '#fbbf24' : 'rgba(255,255,255,0.5)';
                }
                if (btnPlayerList) {
                    btnPlayerList.style.borderColor = activeKey === 'players' ? '#fbbf24' : 'transparent';
                    btnPlayerList.style.color = activeKey === 'players' ? '#fbbf24' : 'rgba(255,255,255,0.5)';
                }
                if (btnTeamView) {
                    btnTeamView.style.borderColor = activeKey === 'teams' ? '#fbbf24' : 'transparent';
                    btnTeamView.style.color = activeKey === 'teams' ? '#fbbf24' : 'rgba(255,255,255,0.5)';
                }

                if (mLive) mLive.classList.toggle('active', activeKey === 'live');
                if (mPlayers) mPlayers.classList.toggle('active', activeKey === 'players');
                if (mTeams) mTeams.classList.toggle('active', activeKey === 'teams');
            }
            
            function toggleLiveBidView() {
                const mainGrid = document.getElementById('mainGrid');
                const playerListContainer = document.getElementById('playerListContainer');
                const teamViewContainer = document.getElementById('teamViewContainer');
                const navCenterHome = document.getElementById('navCenterHome');
                const bidHistoryColumn = document.getElementById('bidHistoryColumn');
                const navRoundTimerWrapper = document.getElementById('navRoundTimerWrapper');
                
                const isMobile = window.innerWidth <= 1080;
                if (navCenterHome) navCenterHome.style.display = isMobile ? 'none' : 'flex';
                if (navRoundTimerWrapper) navRoundTimerWrapper.style.display = isMobile ? 'none' : 'flex';
                if (playerListContainer) playerListContainer.style.display = 'none';
                if (teamViewContainer) teamViewContainer.style.display = 'none';
                
                if (mainGrid) {
                    mainGrid.style.display = isMobile ? 'flex' : 'grid';
                    if (!isMobile) {
                        mainGrid.style.gridTemplateColumns = 'minmax(0, 1fr) minmax(0, 1.05fr) minmax(0, 1fr)';
                    } else {
                        mainGrid.style.gridTemplateColumns = '';
                    }
                }
                if (bidHistoryColumn) {
                    bidHistoryColumn.style.display = 'flex';
                }
                updateActiveNav('live');
                window.scrollTo({ top: 0, behavior: 'instant' });
            }
            
            function togglePlayerListView() {
                const navRoundTimerWrapper = document.getElementById('navRoundTimerWrapper');
                const navCenterLive = document.getElementById('navCenterLive');
                const mainGrid = document.getElementById('mainGrid');
                const playerListContainer = document.getElementById('playerListContainer');
                const teamViewContainer = document.getElementById('teamViewContainer');
                const navCenterHome = document.getElementById('navCenterHome');
                
                const isMobile = window.innerWidth <= 1080;
                if (navRoundTimerWrapper) navRoundTimerWrapper.style.display = 'none';
                if (navCenterLive) navCenterLive.style.display = 'none';
                if (navCenterHome) navCenterHome.style.display = isMobile ? 'none' : 'flex';
                
                if (mainGrid) mainGrid.style.display = 'none';
                if (teamViewContainer) teamViewContainer.style.display = 'none';
                
                if (playerListContainer) {
                    playerListContainer.style.display = 'block';
                    if (typeof renderPlayerListTable === 'function') renderPlayerListTable();
                }
                updateActiveNav('players');
                window.scrollTo({ top: 0, behavior: 'instant' });
            }
            
            function toggleTeamView() {
                const navRoundTimerWrapper = document.getElementById('navRoundTimerWrapper');
                const navCenterLive = document.getElementById('navCenterLive');
                const mainGrid = document.getElementById('mainGrid');
                const playerListContainer = document.getElementById('playerListContainer');
                const teamViewContainer = document.getElementById('teamViewContainer');
                const navCenterHome = document.getElementById('navCenterHome');
                
                const isMobile = window.innerWidth <= 1080;
                if (navRoundTimerWrapper) navRoundTimerWrapper.style.display = 'none';
                if (navCenterLive) navCenterLive.style.display = 'none';
                if (navCenterHome) navCenterHome.style.display = isMobile ? 'none' : 'flex';
                
                if (mainGrid) mainGrid.style.display = 'none';
                if (playerListContainer) playerListContainer.style.display = 'none';
                
                if (teamViewContainer) {
                    teamViewContainer.style.display = 'block';
                    if (typeof renderTeamViewGrid === 'function') renderTeamViewGrid();
                }
                updateActiveNav('teams');
                window.scrollTo({ top: 0, behavior: 'instant' });
            }

            function toggleMobileNavMenu() {
                const drawer = document.getElementById('mobileNavDrawer');
                const backdrop = document.getElementById('mobileNavBackdrop');
                const btn = document.getElementById('mobileMenuBtn');
                if (!drawer) return;
                const isOpen = drawer.classList.contains('open');
                if (isOpen) {
                    closeMobileNavMenu();
                } else {
                    drawer.classList.add('open');
                    if (backdrop) backdrop.classList.add('open');
                    if (btn) btn.classList.add('open');
                    document.body.style.overflow = 'hidden';
                }
            }

            function closeMobileNavMenu() {
                const drawer = document.getElementById('mobileNavDrawer');
                const backdrop = document.getElementById('mobileNavBackdrop');
                const btn = document.getElementById('mobileMenuBtn');
                if (drawer) drawer.classList.remove('open');
                if (backdrop) backdrop.classList.remove('open');
                if (btn) btn.classList.remove('open');
                if (window.innerWidth <= 1080) {
                    document.body.style.overflowY = 'auto';
                }
            }

            function selectMobileTab(tab) {
                if (tab === 'live') {
                    toggleLiveBidView();
                } else if (tab === 'players') {
                    togglePlayerListView();
                } else if (tab === 'teams') {
                    toggleTeamView();
                }
                closeMobileNavMenu();
            }
        </script>

        <!-- Main Workspace -->
        <div id="liveMainWorkspace" style="flex: 1; overflow: hidden; height: calc(100vh - 60px - 42px); position: relative;">
            
            <!-- PLAYER DATABASE LIST VIEW -->
            <div id="playerListContainer" style="display: none; height: 100%; overflow-y: auto; padding: 1.5rem; background: #0f1115;">
                <div class="panel" style="background: #14151a; border-radius: 12px; padding: 1.5rem; border: 1px solid rgba(255,255,255,0.05);">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem;">
                        <h2 style="font-size: 1.2rem; color: #fff; margin: 0; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">PLAYER DATABASE</h2>
                        <div style="font-size: 0.75rem; color: #fbbf24; background: rgba(251, 191, 36, 0.08); border: 1px solid rgba(251, 191, 36, 0.2); padding: 0.35rem 0.75rem; border-radius: 20px; display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700;">
                            <span>💡</span> Tap any player to view details & stats
                        </div>
                    </div>

                    <!-- Quick KPI Summary Chips -->
                    <div class="player-kpi-chips">
                        <div class="player-kpi-chip">
                            <span class="kpi-label">👥 Total Players</span>
                            <span id="kpiTotalPlayers" class="kpi-value"><%= (data.players || []).length %></span>
                        </div>
                        <div class="player-kpi-chip">
                            <span class="kpi-label">🟢 Available</span>
                            <span id="kpiAvailablePlayers" class="kpi-value" style="color: #38bdf8;"><%= (data.players || []).filter(p => !p.status || p.status === 'available').length %></span>
                        </div>
                        <div class="player-kpi-chip">
                            <span class="kpi-label">🏆 Sold</span>
                            <span id="kpiSoldPlayers" class="kpi-value" style="color: #10b981;"><%= (data.players || []).filter(p => p.status === 'sold').length %></span>
                        </div>
                        <div class="player-kpi-chip">
                            <span class="kpi-label">💰 Total Spent</span>
                            <span id="kpiTotalSpent" class="kpi-value" style="color: #fbbf24;"><%= formatCurrencyLocal((data.players || []).filter(p => p.status === 'sold').reduce((sum, p) => sum + (p.soldPrice || 0), 0)) %></span>
                        </div>
                    </div>

                    <!-- Instant Search & Filter Bar -->
                    <div class="player-list-filters-bar" style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
                        <div style="position: relative; flex: 1; min-width: 220px; max-width: 360px;">
                            <input type="text" id="livePlayerSearchInput" oninput="if(typeof filterLivePlayerTable === 'function') filterLivePlayerTable(this.value);" placeholder="🔍 Search by name, role, #ID or UID..." class="player-search-box">
                        </div>

                        <!-- Live Categories Filter Dropdown -->
                        <div class="player-category-filter-box" style="display: flex; align-items: center; gap: 0.4rem;">
                            <label for="liveCategoryFilterSelect" style="font-size: 0.7rem; color: #fbbf24; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap;">CATEGORY:</label>
                            <select id="liveCategoryFilterSelect" onchange="if(typeof setLivePlayerCategoryFilter === 'function') setLivePlayerCategoryFilter(this.value);" style="background: #1e222d; border: 1px solid rgba(251, 191, 36, 0.35); color: #fbbf24; font-size: 0.78rem; font-weight: 800; padding: 0.45rem 0.85rem; border-radius: 8px; cursor: pointer; outline: none; transition: all 0.2s;">
                                <option value="all">⚡ ALL CATEGORIES</option>
                                <% if (data.categories && data.categories.length > 0) { %>
                                    <% data.categories.forEach(cat => { %>
                                        <option value="<%= cat.id %>"><%= cat.name %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>

                        <div class="player-status-pills">
                            <button type="button" class="status-filter-pill active" data-status="all" onclick="if(typeof setLivePlayerStatusFilter === 'function') setLivePlayerStatusFilter('all', this);">All (<span id="countFilterAll"><%= (data.players || []).length %></span>)</button>
                            <button type="button" class="status-filter-pill" data-status="available" onclick="if(typeof setLivePlayerStatusFilter === 'function') setLivePlayerStatusFilter('available', this);">Available (<span id="countFilterAvailable"><%= (data.players || []).filter(p => !p.status || p.status === 'available').length %></span>)</button>
                            <button type="button" class="status-filter-pill" data-status="sold" onclick="if(typeof setLivePlayerStatusFilter === 'function') setLivePlayerStatusFilter('sold', this);">Sold (<span id="countFilterSold"><%= (data.players || []).filter(p => p.status === 'sold').length %></span>)</button>
                            <button type="button" class="status-filter-pill" data-status="unsold" onclick="if(typeof setLivePlayerStatusFilter === 'function') setLivePlayerStatusFilter('unsold', this);">Unsold (<span id="countFilterUnsold"><%= (data.players || []).filter(p => p.status === 'unsold').length %></span>)</button>
                        </div>
                    </div>

                    <div class="player-list-table-scroll">
                        <table id="livePlayerListTable" class="player-list-table" style="width: 100%; border-collapse: collapse; text-align: left;">
                            <thead>
                                <tr style="border-bottom: 1.5px solid rgba(251, 191, 36, 0.3);">
                                    <th style="padding: 0.85rem 1rem; color: #fbbf24; font-size: 0.72rem; text-transform: uppercase; font-weight: 800; letter-spacing: 0.5px;">Real Player ID</th>
                                    <th style="padding: 0.85rem 1rem; color: #94a3b8; font-size: 0.72rem; text-transform: uppercase; font-weight: 800; letter-spacing: 0.5px;">Unique ID (Short)</th>
                                    <th style="padding: 0.85rem 1rem; color: rgba(255,255,255,0.7); font-size: 0.72rem; text-transform: uppercase; font-weight: 800;">Player Info</th>
                                    <th style="padding: 0.85rem 1rem; color: rgba(255,255,255,0.7); font-size: 0.72rem; text-transform: uppercase; font-weight: 800;">Role</th>
                                    <th style="padding: 0.85rem 1rem; color: rgba(255,255,255,0.7); font-size: 0.72rem; text-transform: uppercase; font-weight: 800;">Base Price</th>
                                    <th style="padding: 0.85rem 1rem; color: rgba(255,255,255,0.7); font-size: 0.72rem; text-transform: uppercase; font-weight: 800;">Status</th>
                                    <th style="padding: 0.85rem 1rem; color: rgba(255,255,255,0.7); font-size: 0.72rem; text-transform: uppercase; font-weight: 800;">Sold To / Price</th>
                                </tr>
                            </thead>
                            <tbody id="playerListTableBody">
                                <% if (data.players && data.players.length > 0) { %>
                                    <% data.players.forEach(p => { 
                                        let statusColor = '#fbbf24';
                                        if (p.status === 'sold') statusColor = '#10b981';
                                        if (p.status === 'unsold') statusColor = '#ef4444';
                                        let roleIcon = '⚾';
                                        if (p.role === 'Batsman') roleIcon = '🏏';
                                        if (p.role === 'Bowler') roleIcon = '🥎';
                                        if (p.role === 'All Rounder' || p.role === 'All-Rounder') roleIcon = '⚡';
                                        let paddedId = p.id || '00';
                                        if (!isNaN(paddedId) && paddedId.toString().length < 3) {
                                             paddedId = paddedId.toString().padStart(3, '0');
                                        }
                                        let realUploadedId = p.formNo ? String(p.formNo).trim() : paddedId;
                                        let shortUid = String(p.id).length > 6 ? '..' + String(p.id).slice(-5) : p.id;
                                        const team = p.soldTo && data.teams ? data.teams.find(t => t.name === p.soldTo) : null;
                                    %>
                                        <tr class="clickable-player-row" onclick="openLivePlayerDetailsModal('<%= p.id %>')" style="border-bottom: 1px solid rgba(255,255,255,0.05); cursor: pointer; transition: background 0.15s;">
                                            <td class="col-real-id" style="padding: 0.85rem 1rem;">
                                                <span class="badge-real-id" style="font-weight: 900; color: #fbbf24; font-size: 1.05rem; font-family: monospace; background: rgba(251,191,36,0.1); padding: 0.25rem 0.6rem; border-radius: 6px; border: 1px solid rgba(251,191,36,0.25);">#<%= realUploadedId %></span>
                                            </td>
                                            <td class="col-uid" style="padding: 0.85rem 1rem;">
                                                <span class="badge-uid" style="font-size: 0.75rem; color: #94a3b8; font-family: monospace; background: rgba(255,255,255,0.06); padding: 0.25rem 0.55rem; border-radius: 4px; border: 1px solid rgba(255,255,255,0.1);" title="DB Unique ID: <%= p.id %>">UID: <%= shortUid %></span>
                                            </td>
                                            <td class="col-player-info" style="padding: 0.85rem 1rem;">
                                                <div style="display: flex; align-items: center; gap: 0.8rem;">
                                                    <img src="<%= p.photo || '/uploads/default-player.svg' %>" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(255,255,255,0.1); background: #1a1c23;">
                                                    <span style="color: #fff; font-weight: 800; font-size: 0.95rem;"><%= p.name %></span>
                                                </div>
                                            </td>
                                            <td class="col-role" style="padding: 0.85rem 1rem;">
                                                <div style="display: inline-flex; align-items: center; gap: 0.4rem; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 0.2rem 0.6rem; border-radius: 20px; font-size: 0.75rem; color: rgba(255,255,255,0.8);">
                                                    <span><%= roleIcon %></span> <%= p.role %>
                                                </div>
                                            </td>
                                            <td class="col-base-price" style="padding: 0.85rem 1rem; color: rgba(255,255,255,0.6); font-size: 0.85rem;"><%= formatCurrencyLocal(p.basePrice || 0) %></td>
                                            <td class="col-status" style="padding: 0.85rem 1rem; font-weight: 800; font-size: 0.85rem; color: <%= statusColor %>; text-transform: uppercase;">
                                                <%= p.status || 'available' %>
                                            </td>
                                            <td class="col-sold" style="padding: 0.85rem 1rem;">
                                                <% if (p.status === 'sold' && p.soldTo) { %>
                                                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                                                        <% if (team && team.logo) { %>
                                                            <img src="<%= team.logo %>" style="width:24px; height:24px; border-radius:50%; object-fit:contain; background:#fff; padding:2px;">
                                                        <% } %>
                                                        <span style="font-weight: 800; color: #fff; font-size: 0.85rem;"><%= formatCurrencyLocal(p.soldPrice || 0) %></span>
                                                    </div>
                                                <% } else { %>
                                                    -
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="7" style="padding: 2.5rem; text-align: center; color: rgba(255,255,255,0.4);">No players loaded in database.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TEAM VIEW GRID -->
            <div id="teamViewContainer" style="display: none; height: 100%; overflow-y: auto; padding: 1.5rem; background: #0f1115;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.5rem;">
                    <div>
                        <h2 style="font-size: 1.5rem; color: #fff; margin: 0 0 0.5rem 0; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 900; text-transform: uppercase; letter-spacing: 0.5px;">FRANCHISE OVERVIEW</h2>
                        <div id="teamViewSubtitle" style="color: rgba(255,255,255,0.6); font-size: 0.85rem;">Live roster and purse status for all participating teams.</div>
                    </div>
                    <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); padding: 0.5rem 1rem; border-radius: 6px; display: flex; align-items: center; gap: 0.5rem;">
                        <span style="color: rgba(255,255,255,0.5); font-size: 0.75rem; text-transform: uppercase; font-weight: 800;">Total Spent</span>
                        <%
                            const spentTotal = (data.players || []).filter(p => p.status === 'sold').reduce((sum, p) => sum + (p.soldPrice || 0), 0);
                        %>
                        <span id="teamViewTotalSpent" style="color: #fff; font-size: 1.25rem; font-weight: 900; font-family: 'Plus Jakarta Sans', sans-serif;"><%= formatCurrencyLocal(spentTotal) %></span>
                    </div>
                </div>
                <div id="teamViewGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem;">
                    <% if (data.teams && data.teams.length > 0) { 
                        const maxPlayers = (data.auctionDetails && data.auctionDetails.playersPerTeamMax) ? data.auctionDetails.playersPerTeamMax : 25;
                        const baseBid = (data.auctionDetails && data.auctionDetails.baseBid) ? data.auctionDetails.baseBid : 100000;
                        data.teams.forEach((team, index) => {
                            const teamPlayers = data.players ? data.players.filter(p => p.soldTo === team.name) : [];
                            const rosterCount = teamPlayers.length;
                            const reserve = Math.max(0, (maxPlayers - rosterCount) * baseBid);
                            const maxBid = Math.max(0, team.budget - reserve);
                    %>
                        <div class="team-card" data-teamname="<%= team.name %>" data-roster-count="<%= rosterCount %>" onclick="window.toggleRoster('<%= team.name %>')" style="cursor: pointer; background: #101115; border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem; touch-action: manipulation; transition: all 0.2s ease;">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                <% if (team.logo) { %>
                                    <img src="<%= team.logo %>" style="width: 32px; height: 32px; object-fit: contain;">
                                <% } else { %>
                                    <div style="width:32px; height:32px; background:rgba(255,255,255,0.1); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:0.6rem; color:#fff; font-weight:800;">IMG</div>
                                <% } %>
                                <div style="background: rgba(255,255,255,0.05); padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; color: rgba(255,255,255,0.7); font-weight: 800; font-family: monospace;">#<%= index + 1 %></div>
                            </div>
                            
                            <div style="font-size: 1.05rem; font-weight: 800; color: #fff; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= team.name %>"><%= team.name %></div>
                            
                            <div style="display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.8rem;">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <span style="color: rgba(255,255,255,0.6);">Purse</span>
                                    <span style="color: #fbbf24; font-weight: 800; font-size: 0.9rem;"><%= formatCurrencyLocal(team.budget) %></span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <span style="color: rgba(255,255,255,0.6);">Reserve</span>
                                    <span style="color: #fff; font-weight: 800;"><%= formatCurrencyLocal(reserve) %></span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <span style="color: rgba(255,255,255,0.6);">Roster</span>
                                    <span style="color: #fff; font-weight: 800;"><%= rosterCount %>/<%= maxPlayers %></span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <span style="color: rgba(255,255,255,0.6);">Max Bid</span>
                                    <span style="color: #fff; font-weight: 800;"><%= formatCurrencyLocal(maxBid) %></span>
                                </div>
                            </div>
                            
                            <div style="height: 4px; background: rgba(255,255,255,0.1); border-radius: 2px; margin-top: auto;">
                                <div style="background: <%= team.color || '#e11d48' %>; height: 100%; width: <%= Math.min(100, (rosterCount / maxPlayers) * 100) %>%;"></div>
                            </div>

                            <!-- Interactive Toggle Button -->
                            <div class="team-card-toggle-bar" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; padding: 0.45rem; text-align: center; color: #fbbf24; font-weight: 800; font-size: 0.72rem; letter-spacing: 0.5px; transition: all 0.2s;">
                                <span class="toggle-text"><%= teamPlayers.length > 0 ? '▾ VIEW SQUAD (' + teamPlayers.length + ')' : '▾ EMPTY SQUAD (0)' %></span>
                            </div>
                            
                            <div class="team-roster-list" style="display: none; flex-direction: column; margin-top: 0.5rem; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1rem;">
                                <div style="font-size: 0.8rem; font-weight: 800; color: rgba(255,255,255,0.5); text-transform: uppercase; margin-bottom: 0.75rem;">Drafted Players (<%= rosterCount %>)</div>
                                <% if (teamPlayers.length === 0) { %>
                                    <div style="font-size: 0.85rem; color: #64748b; font-style: italic; padding: 0.5rem 0; text-align: left;">No players drafted yet</div>
                                <% } else { %>
                                    <% teamPlayers.sort((a, b) => b.soldPrice - a.soldPrice).forEach(player => { %>
                                        <div class="team-roster-player-item" onclick="event.stopPropagation(); window.openLivePlayerDetailsModal('<%= player.id %>');" style="display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.02); padding: 0.65rem 0.85rem; border-radius: 6px; border: 1px solid <%= player.isCaptain ? 'rgba(251, 191, 36, 0.25)' : 'rgba(255,255,255,0.04)' %>; margin-bottom: 0.4rem; cursor: pointer; transition: all 0.15s ease;" onmouseover="this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.background='rgba(255,255,255,0.02)'">
                                            <div style="display: flex; flex-direction: column; text-align: left; gap: 2px;">
                                                <span style="font-size: 0.88rem; font-weight: 700; color: <%= player.isCaptain ? '#fbbf24' : '#e2e8f0' %>;"><%= player.name %> <%= player.isCaptain ? '👑' : '' %></span>
                                                <span style="font-size: 0.72rem; color: #94a3b8; text-transform: uppercase; font-weight: 600;"><%= player.role %> • #<%= player.formNo || player.id %></span>
                                            </div>
                                            <div style="display: flex; align-items: center; text-align: right;">
                                                <span style="font-size: 0.95rem; font-weight: 900; color: #10b981; font-family: 'Plus Jakarta Sans', monospace;"><%= formatCurrencyLocal(player.soldPrice) %></span>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } %>
                            </div>
                        </div>
                    <% }) } %>
                </div>
            </div>

            <!-- LIVE BIDDING GRID VIEW -->
            <div id="mainGrid" class="grid live-main-grid" style="display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr) minmax(0, 1fr); height: 100%; width: 100%; box-sizing: border-box; gap: 1.25rem; padding: 1.25rem; background: #0f1115; transition: all 0.3s;">
                
                <!-- 1. Left Column: Player Profile -->
                <div id="playerProfileColumn" class="live-player-col" style="display: flex; flex-direction: column; height: 100%; gap: 1rem; position: relative;">
                    <!-- Image Section (Top Half) -->
                    <div class="live-player-img-box" style="position: relative; height: 50%; min-height: 250px; width: 100%; overflow: hidden; background: radial-gradient(circle at 50% 30%, #202430 0%, #0d0f14 100%); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.5);">
                        <!-- Floating Real ID Tag -->
                        <div class="live-player-form-badge">
                            <span style="width: 6px; height: 6px; background: #fbbf24; border-radius: 50%; box-shadow: 0 0 6px #fbbf24;"></span>
                            FORM #<span id="livePlayerImgFormNo"><%= data.auctionState.currentPlayer ? (data.auctionState.currentPlayer.formNo || (String(data.auctionState.currentPlayer.id).length > 6 ? '..' + String(data.auctionState.currentPlayer.id).slice(-5) : data.auctionState.currentPlayer.id)) : '--' %></span>
                        </div>
                        
                        <!-- Floating Role Tag -->
                        <div id="livePlayerFloatingRole" class="live-player-floating-role">
                            <span id="livePlayerRoleIcon"><%= data.auctionState.currentPlayer && (data.auctionState.currentPlayer.role === 'Batsman' ? '🏏' : data.auctionState.currentPlayer.role === 'Bowler' ? '🥎' : (data.auctionState.currentPlayer.role === 'All Rounder' || data.auctionState.currentPlayer.role === 'All-Rounder') ? '⚡' : (data.auctionState.currentPlayer.role === 'Wicket Keeper' || data.auctionState.currentPlayer.role === 'Wicketkeeper' || data.auctionState.currentPlayer.role === 'Wicket-Keeper') ? '🧤' : '⚾') %></span>
                            <span id="livePlayerRoleText"><%= data.auctionState.currentPlayer ? data.auctionState.currentPlayer.role : 'BATSMAN' %></span>
                        </div>

                        <!-- Captain Badge -->
                        <div id="livePlayerCaptainBadge" style="display: <%= (data.auctionState.currentPlayer && data.auctionState.currentPlayer.isCaptain) ? 'flex' : 'none' %>; position: absolute; top: 12px; right: 12px; background: linear-gradient(135deg, rgba(251, 191, 36, 0.95), rgba(245, 158, 11, 0.95)); color: #000; font-size: 0.68rem; font-weight: 900; padding: 0.25rem 0.65rem; border-radius: 20px; z-index: 5; box-shadow: 0 2px 8px rgba(0,0,0,0.4); text-transform: uppercase; letter-spacing: 0.5px; align-items: center; gap: 0.3rem;">
                            👑 CAPTAIN
                        </div>

                        <!-- Spotlight Sweep Effect -->
                        <div class="player-spotlight-sweep"></div>

                        <%
                          const currPhoto = (data.auctionState.currentPlayer && data.auctionState.currentPlayer.photo) ? (data.auctionState.currentPlayer.photo.startsWith('http') ? data.auctionState.currentPlayer.photo : (data.auctionState.currentPlayer.photo.startsWith('/') ? data.auctionState.currentPlayer.photo : '/' + data.auctionState.currentPlayer.photo)) : '/uploads/default-player.svg';
                        %>
                        <img id="livePlayerPhoto" src="<%= currPhoto %>" onerror="this.onerror=null; this.src='/uploads/default-player.svg';" alt="Player Photo" style="width: 100%; height: 100%; object-fit: cover; object-position: center 15%; display: block; transition: all 0.3s ease;">
                        
                        <div id="playerImageStatusOverlay" style="position: absolute; inset: 0; background: rgba(220, 38, 38, 0.4); mix-blend-mode: multiply; opacity: 0; transition: opacity 0.3s ease; z-index: 1;"></div>
                        <div id="playerStatusStamp" style="position: absolute; top: 45%; left: 50%; transform: translate(-50%, -50%) scale(0.8); font-size: 5rem; font-weight: 900; font-family: 'Plus Jakarta Sans', sans-serif; color: rgba(255, 180, 180, 0.95); text-shadow: 0 0 80px rgba(220, 38, 38, 1), 0 0 30px rgba(220, 38, 38, 1); letter-spacing: -2px; opacity: 0; transition: all 0.4s; z-index: 2;">UNSOLD</div>
                        
                        <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 38%; background: linear-gradient(to top, rgba(15,17,21,0.98) 0%, rgba(15,17,21,0.6) 55%, transparent 100%); z-index: 3;"></div>
                        <div style="position: absolute; bottom: 12px; left: 16px; right: 16px; z-index: 4;">
                            <div id="livePlayerRole" style="font-size: 0.72rem; color: #fbbf24; text-transform: uppercase; font-weight: 800; letter-spacing: 1.5px; margin-bottom: 0.15rem;"><%= data.auctionState.currentPlayer ? (data.auctionState.currentPlayer.role || 'CRICKETER') : 'CRICKETER' %></div>
                            <h2 id="livePlayerName" style="font-size: clamp(1.4rem, 3.2vw, 2.4rem) !important; margin: 0; line-height: 1.05; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 900; text-transform: uppercase; letter-spacing: -1px; color: #fff; text-shadow: 0 2px 10px rgba(0,0,0,0.8); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= data.auctionState.currentPlayer ? data.auctionState.currentPlayer.name : 'Waiting...' %></h2>
                        </div>
                    </div>
                    
                    <!-- Stats Grid Section (Bottom Half) -->
                    <div class="live-player-stats-grid" style="display: grid; grid-template-columns: 1fr 1fr; grid-auto-rows: 1fr; gap: 0.45rem;">
                        <div style="background: #1a1c23; border: 1px solid rgba(255,255,255,0.04); border-radius: 6px; padding: 0.65rem 0.75rem; display: flex; flex-direction: column; justify-content: center; min-height: 52px; box-sizing: border-box;">
                            <div id="liveStatLabel1" style="font-size: 0.6rem; color: rgba(255,255,255,0.5); text-transform: uppercase; font-weight: 800; letter-spacing: 0.5px; margin-bottom: 0.2rem;">BATTING</div>
                            <div id="livePlayerMatches" style="font-size: 0.95rem; color: #fff; font-weight: 800; line-height: 1.2; word-break: break-word;"><%= (data.auctionState.currentPlayer && data.auctionState.currentPlayer.specification1) ? data.auctionState.currentPlayer.specification1 : (data.auctionState.currentPlayer && data.auctionState.currentPlayer.matches ? data.auctionState.currentPlayer.matches : 'Right Hand Bat') %></div>
                        </div>
                        <div style="background: #1a1c23; border: 1px solid rgba(255,255,255,0.04); border-radius: 6px; padding: 0.65rem 0.75rem; display: flex; flex-direction: column; justify-content: center; min-height: 52px; box-sizing: border-box;">
                            <div id="liveStatLabel2" style="font-size: 0.6rem; color: rgba(255,255,255,0.5); text-transform: uppercase; font-weight: 800; letter-spacing: 0.5px; margin-bottom: 0.2rem;">BOWLING</div>
                            <div id="livePlayerRuns" style="font-size: 0.95rem; color: #fff; font-weight: 800; line-height: 1.2; word-break: break-word;"><%= (data.auctionState.currentPlayer && data.auctionState.currentPlayer.specification2) ? data.auctionState.currentPlayer.specification2 : (data.auctionState.currentPlayer && data.auctionState.currentPlayer.runs ? data.auctionState.currentPlayer.runs : '--') %></div>
                        </div>
                        <div style="background: #1a1c23; border: 1px solid rgba(255,255,255,0.04); border-radius: 6px; padding: 0.65rem 0.75rem; display: flex; flex-direction: column; justify-content: center; min-height: 52px; box-sizing: border-box;">
                            <div id="liveStatLabel3" style="font-size: 0.6rem; color: rgba(255,255,255,0.5); text-transform: uppercase; font-weight: 800; letter-spacing: 0.5px; margin-bottom: 0.2rem;"><%= (data.auctionState.currentPlayer && (data.auctionState.currentPlayer.specification3 || data.auctionState.currentPlayer.detail || data.auctionState.currentPlayer.customTag)) ? 'SPECIALTY' : 'PLAYING ROLE' %></div>
                            <div id="livePlayerSR" style="font-size: 0.95rem; color: #fff; font-weight: 800; line-height: 1.2; word-break: break-word;"><%= data.auctionState.currentPlayer ? (data.auctionState.currentPlayer.specification3 || data.auctionState.currentPlayer.detail || data.auctionState.currentPlayer.customTag || data.auctionState.currentPlayer.role || '--') : '--' %></div>
                        </div>
                        <div style="background: #1a1c23; border: 1px solid rgba(255,255,255,0.04); border-radius: 6px; padding: 0.65rem 0.75rem; display: flex; flex-direction: column; justify-content: center; min-height: 52px; box-sizing: border-box;">
                            <div id="liveStatLabel4" style="font-size: 0.6rem; color: rgba(255,255,255,0.5); text-transform: uppercase; font-weight: 800; letter-spacing: 0.5px; margin-bottom: 0.2rem;"><%= (data.auctionState.currentPlayer && data.auctionState.currentPlayer.age) ? 'AGE' : 'KIT SIZE' %></div>
                            <div id="livePlayerAge" style="font-size: 0.95rem; color: #fff; font-weight: 800; line-height: 1.2;">
                                <% if (data.auctionState.currentPlayer && data.auctionState.currentPlayer.age) { %>
                                    <%= data.auctionState.currentPlayer.age %> YRS
                                <% } else if (data.auctionState.currentPlayer && (data.auctionState.currentPlayer.tshirtSize || data.auctionState.currentPlayer.trouserSize)) { %>
                                    <%= data.auctionState.currentPlayer.tshirtSize || '--' %> / <%= data.auctionState.currentPlayer.trouserSize || '--' %>
                                <% } else { %>
                                    --
                                <% } %>
                            </div>
                        </div>
                        <div style="background: #1a1c23; border: 1px solid rgba(255,255,255,0.04); border-radius: 6px; padding: 0.65rem 0.75rem; display: flex; flex-direction: column; justify-content: center; min-height: 52px; box-sizing: border-box;">
                            <div style="font-size: 0.6rem; color: rgba(255,255,255,0.5); text-transform: uppercase; font-weight: 800; letter-spacing: 0.5px; margin-bottom: 0.2rem;">CATEGORY</div>
                            <div id="liveCategoryDisplay" style="font-size: 0.95rem; color: #38bdf8; font-weight: 800;"><%= data.auctionState.activeCategoryName || (data.auctionState.currentPlayer && data.auctionState.currentPlayer.category_id) || 'OPEN POOL' %></div>
                        </div>
                        <div class="live-stat-base-price" style="background: #1a1c23; border: 1px solid rgba(255,255,255,0.04); border-radius: 6px; padding: 0.65rem 0.75rem; grid-column: span 1; display: flex; flex-direction: column; justify-content: center; min-height: 52px; box-sizing: border-box;">
                            <div style="font-size: 0.6rem; color: rgba(255,255,255,0.5); text-transform: uppercase; font-weight: 800; letter-spacing: 0.5px; margin-bottom: 0.2rem;">BASE PRICE</div>
                            <div id="liveBasePriceDisplay" style="font-size: 0.95rem; color: #10b981; font-weight: 800;"><%= formatCurrencyLocal(data.auctionState.currentPlayer ? (data.auctionState.currentPlayer.basePrice || 0) : (data.auctionDetails && data.auctionDetails.baseBid ? data.auctionDetails.baseBid : 1000)) %></div>
                        </div>
                    </div>

                    <!-- Supplementary Player Meta Strip (Real Phone & Apparel Data) -->
                    <div class="live-player-extra-meta" style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); padding: 0.45rem 0.75rem; border-radius: 8px; font-size: 0.75rem; box-sizing: border-box; width: 100%;">
                        <div style="display: flex; align-items: center; gap: 0.35rem; color: rgba(255,255,255,0.7); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
