    <script src="/js/user.js?v=<%= Date.now() %>"></script>
    <!-- Live Player Details Modal -->
    <div id="livePlayerModalOverlay" class="live-player-modal-overlay" onclick="if(event.target === this) closeLivePlayerModal();" style="display: none;">
        <div class="live-player-modal-dialog">
            <button type="button" class="live-player-modal-close" onclick="closeLivePlayerModal()" aria-label="Close Profile">✕</button>
            
