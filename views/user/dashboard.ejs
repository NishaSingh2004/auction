                                            <div style="font-size: 0.75rem; color: rgba(255,255,255,0.85); font-weight: 700;"><%= rosterCount %>/<%= maxPlayersConfig %></div>
                                        </div>
                                    </div>
                                    
                                    <!-- Progress Bar Line -->
                                    <div style="height: 4px; background: rgba(255,255,255,0.1); border-radius: 2px; overflow: hidden; margin-top: 0.2rem;">
                                        <div style="background: <%= team.color || '#e11d48' %>; height: 100%; width: <%= Math.min(100, ((rosterCount / maxPlayersConfig) * 100)) %>%;"></div>
                                    </div>
                                </div>
                            <% }) %>
