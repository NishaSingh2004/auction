    <script>
        window.openLivePlayerDetailsModal = function(playerId) {
            const list = window.playersCache || [];
            const player = list.find(p => String(p.id) === String(playerId) || String(p.formNo) === String(playerId));
            if (!player) return;

            const modal = document.getElementById('livePlayerModalOverlay');
            if (!modal) return;

            const modalImg = document.getElementById('modalPlayerImg');
            if (modalImg) modalImg.src = player.photo || '/uploads/default-player.svg';

            const modalName = document.getElementById('modalPlayerName');
            if (modalName) modalName.textContent = player.name;

            const modalFormNo = document.getElementById('modalPlayerFormNo');
            const realUploadedId = player.formNo ? String(player.formNo).trim() : (player.id || '--');
            if (modalFormNo) modalFormNo.textContent = '#' + realUploadedId;

            const modalUid = document.getElementById('modalPlayerUid');
            const shortUid = String(player.id).length > 6 ? '..' + String(player.id).slice(-5) : player.id;
            if (modalUid) modalUid.textContent = 'UID: ' + shortUid;

            const modalRole = document.getElementById('modalPlayerRole');
            let roleIcon = '⚾';
            if (player.role === 'Batsman') roleIcon = '🏏';
            if (player.role === 'Bowler') roleIcon = '🥎';
            if (player.role === 'All Rounder' || player.role === 'All-Rounder') roleIcon = '⚡';
            if (modalRole) modalRole.innerHTML = `${roleIcon} ${player.role || 'Player'}`;

            const modalStatus = document.getElementById('modalPlayerStatus');
            const formatCurr = typeof formatCurrency === 'function' ? formatCurrency : (val) => '₹' + Number(val).toLocaleString();
            
            if (modalStatus) {
                if (player.status === 'sold') {
                    const team = (window.teamsCache || []).find(t => t.name === player.soldTo);
                    const teamLogo = team && team.logo ? `<img src="${team.logo}" style="width:20px;height:20px;border-radius:50%;object-fit:contain;background:#fff;padding:2px;vertical-align:middle;margin-right:4px;">` : '';
                    modalStatus.innerHTML = `<span style="background: rgba(16, 185, 129, 0.2); border: 1px solid rgba(16, 185, 129, 0.4); color: #10b981; padding: 0.35rem 0.85rem; border-radius: 20px; font-weight: 800; display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.8rem;">SOLD TO ${teamLogo}${player.soldTo} • ${formatCurr(player.soldPrice || 0)}</span>`;
                } else if (player.status === 'unsold') {
                    modalStatus.innerHTML = `<span style="background: rgba(239, 68, 68, 0.2); border: 1px solid rgba(239, 68, 68, 0.4); color: #ef4444; padding: 0.35rem 0.85rem; border-radius: 20px; font-weight: 800; font-size: 0.8rem;">UNSOLD</span>`;
                } else {
                    modalStatus.innerHTML = `<span style="background: rgba(251, 191, 36, 0.2); border: 1px solid rgba(251, 191, 36, 0.4); color: #fbbf24; padding: 0.35rem 0.85rem; border-radius: 20px; font-weight: 800; font-size: 0.8rem;">AVAILABLE</span>`;
                }
            }

            const modalBasePrice = document.getElementById('modalPlayerBasePrice');
            if (modalBasePrice) modalBasePrice.textContent = formatCurr(player.basePrice || 0);

            const modalCat = document.getElementById('modalPlayerCategory');
            if (modalCat) modalCat.textContent = player.category_id || player.category || '--';

            const modalAge = document.getElementById('modalPlayerAge');
            if (modalAge) modalAge.textContent = player.age || '--';

            const modalMatches = document.getElementById('modalPlayerMatches');
            if (modalMatches) modalMatches.textContent = player.matches || '--';

            const modalRuns = document.getElementById('modalPlayerRuns');
            if (modalRuns) modalRuns.textContent = player.runs || '--';

            const modalSR = document.getElementById('modalPlayerSR');
            if (modalSR) modalSR.textContent = player.strikeRate || '--';

            const modalAvg = document.getElementById('modalPlayerAvg');
            if (modalAvg) modalAvg.textContent = player.average || '--';

            modal.style.display = 'flex';
        };

        window.closeLivePlayerModal = function() {
            const modal = document.getElementById('livePlayerModalOverlay');
            if (modal) modal.style.display = 'none';
        };

        const liveExpandedTeams = new Set();
        window.toggleRoster = function(teamName) {
            const wasExpanded = liveExpandedTeams.has(teamName);
            if (wasExpanded) {
                liveExpandedTeams.delete(teamName);
            } else {
                liveExpandedTeams.add(teamName);
            }
            const isNowExpanded = !wasExpanded;
            const cards = document.querySelectorAll('.team-card[data-teamname="' + teamName + '"]');
            cards.forEach(card => {
                const roster = card.querySelector('.team-roster-list');
                const toggleBar = card.querySelector('.team-card-toggle-bar .toggle-text');
                const count = card.dataset.rosterCount || 0;
                if (roster) {
                    roster.style.display = isNowExpanded ? 'flex' : 'none';
                    if (toggleBar) {
                        toggleBar.textContent = isNowExpanded ? ('▴ HIDE SQUAD (' + count + ')') : ('▾ VIEW SQUAD (' + count + ')');
                    }
                    if (isNowExpanded) {
                        card.classList.add('team-card-expanded');
                        card.style.borderColor = 'rgba(251, 191, 36, 0.4)';
                    } else {
                        card.classList.remove('team-card-expanded');
                        card.style.borderColor = 'rgba(255, 255, 255, 0.05)';
                    }
                }
            });
        };

        window.removePlayerFromTeam = async function(playerId, playerName, teamName, soldPrice) {
            if (!playerId) return;
            const priceFormatted = soldPrice ? ('₹' + Number(soldPrice).toLocaleString()) : 'the amount';
            const confirmMsg = 'Are you sure you want to remove ' + (playerName || 'this player') + ' from ' + (teamName || 'this team') + '?\n\nThis will refund ' + priceFormatted + ' back to ' + (teamName || 'the team') + "\'s purse and return the player to the available pool.";
            if (!confirm(confirmMsg)) return;

            // Optimistic instant UI update
            if (window.playersCache) {
                const p = window.playersCache.find(x => String(x.id).trim() === String(playerId).trim() || (x.formNo && String(x.formNo).trim() === String(playerId).trim()));
                if (p) {
                    p.status = 'available';
                    p.soldTo = null;
                    p.soldPrice = null;
                }
            }
            if (window.teamsCache) {
                const t = window.teamsCache.find(x => x.name === teamName);
                if (t) {
                    t.budget = parseInt(t.budget || 0) + parseInt(soldPrice || 0);
                }
            }
            if (typeof renderTeamViewGrid === 'function') renderTeamViewGrid();
            if (typeof renderPlayerListTable === 'function') renderPlayerListTable();

            try {
                if (typeof socket !== 'undefined' && socket && socket.connected) {
                    socket.emit('removePlayerFromTeam', { playerId: String(playerId) });
                }
                const res = await fetch('/api/remove-player-from-team', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ playerId: String(playerId) })
                });
                const resData = await res.json();
                if (!resData.success && typeof socket !== 'undefined' && socket) {
                    socket.emit('removePlayerFromTeam', { playerId: String(playerId) });
                }
            } catch (err) {
                console.warn('API remove fallback to socket:', err);
                if (typeof socket !== 'undefined' && socket) {
                    socket.emit('removePlayerFromTeam', { playerId: String(playerId) });
                }
            }
        };

        window.handleRemovePlayerClick = function(btn) {
            if (!btn) return;
            const playerId = btn.getAttribute('data-player-id');
            const playerName = btn.getAttribute('data-player-name') || 'player';
            const teamName = btn.getAttribute('data-team-name') || 'team';
            const soldPrice = btn.getAttribute('data-sold-price') || '0';
            window.removePlayerFromTeam(playerId, playerName, teamName, soldPrice);
        };

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                window.closeLivePlayerModal();
                if (typeof closeMobileNavMenu === 'function') closeMobileNavMenu();
            }
        });
    </script>

    <!-- Broadcast Celebration Confetti Canvas -->
    <canvas id="liveConfettiCanvas" style="position: fixed; inset: 0; pointer-events: none; z-index: 999999; width: 100%; height: 100%; display: none;"></canvas>
</body>
</html>
