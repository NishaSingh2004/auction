<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1200">
    <title>Manage Players</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body style="background-color: var(--bg-dark);">
    <div class="glow-orb orb-1"></div>
    <div class="glow-orb orb-2"></div>
    <div class="dashboard-layout">
        <!-- Sidebar -->
        <aside class="sidebar">
            <h2>Admin Panel</h2>
            <ul class="nav-links">
                <li><a href="/admin/dashboard">Dashboard</a></li>
                <li><a href="/admin/teams">Manage Teams</a></li>
                <li><a href="/admin/players" class="active">Manage Players</a></li>
                <li><a href="/admin/auction">Live Auction Control</a></li>
                <li><a href="/logout" style="color: var(--danger); margin-top: auto; border-top: 1px solid var(--border-color); padding-top: 1.5rem; border-radius: 0;"><span class="icon">🚪</span> Logout</a></li>
            </ul>
        </aside>

        <!-- Main Workspace -->
        <main class="main-content">
            <header class="topbar" style="height: 60px; flex-shrink: 0;">
                <h1 style="font-size: 1.25rem; font-weight: 800; font-family: 'Plus Jakarta Sans', sans-serif;">Players Directory</h1>
            </header>
            
            <div style="padding: 2rem; display: flex; flex-direction: column; gap: 2rem;">
                <!-- Add New Player Form Panel -->
                <div class="panel" style="padding: 2rem;">
                    <h3 style="margin-bottom: 1.5rem; font-size: 1.15rem; font-weight: 800; color: var(--primary); font-family: 'Plus Jakarta Sans', sans-serif; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1px solid var(--border-color); padding-bottom: 0.6rem;">Add New Player</h3>
                    <form action="/admin/add-player" method="POST" style="display: flex; gap: 1.25rem; flex-wrap: wrap; align-items: flex-end;">
                        <div style="display: flex; flex-direction: column; gap: 0.4rem; flex: 2; min-width: 220px;">
                            <label style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px;">Player Name</label>
                            <input type="text" name="name" placeholder="Enter player full name" required class="form-control form-control-lg" style="border-radius: 10px !important;">
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 0.4rem; flex: 1; min-width: 150px;">
                            <label style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px;">Base Price</label>
                            <input type="number" name="basePrice" placeholder="Base Price" required class="form-control form-control-lg" style="border-radius: 10px !important;">
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 0.4rem; flex: 1.2; min-width: 180px;">
                            <label style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px;">Playing Role</label>
                            <select name="role" required class="form-control form-control-lg" style="cursor: pointer; appearance: none; -webkit-appearance: none; background-image: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2212%22 height=%226%22><path d=%22M0 0l6 6 6-6z%22 fill=%22%2394a3b8%22/></svg>'); background-repeat: no-repeat; background-position: right 1rem center; border-radius: 10px !important; padding-right: 2.5rem !important;">
                                <option value="Batsman">Batsman</option>
                                <option value="Bowler">Bowler</option>
                                <option value="All-Rounder">All-Rounder</option>
                                <option value="Wicket-Keeper">Wicket-Keeper</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg" style="padding: 0.8rem 2rem; font-weight: 800; border-radius: 12px;">Add Player</button>
                    </form>
                </div>
                
                <!-- Registered Players Table Panel -->
                <div class="panel" style="padding: 0; overflow: hidden;">
                    <div style="padding: 1.5rem; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
                        <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--primary); font-family: 'Plus Jakarta Sans', sans-serif; text-transform: uppercase; letter-spacing: 1px;">Registered Players</h3>
                        <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">Total Players: <span style="color: #fff; font-weight: 700;"><%= players.length %></span></span>
                    </div>
                    <div class="list-container sleek-scroll" style="max-height: 520px; overflow-y: auto;">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th style="padding: 1rem !important; border-bottom: 1px solid var(--border-color) !important; font-size: 0.75rem !important; color: #fbbf24 !important;">Real Player ID</th>
                                    <th style="padding: 1rem !important; border-bottom: 1px solid var(--border-color) !important; font-size: 0.75rem !important; color: #94a3b8 !important;">Unique ID (Short)</th>
                                    <th style="padding: 1rem !important; border-bottom: 1px solid var(--border-color) !important; font-size: 0.75rem !important;">Name</th>
                                    <th style="padding: 1rem !important; border-bottom: 1px solid var(--border-color) !important; font-size: 0.75rem !important;">Role</th>
                                    <th style="padding: 1rem !important; border-bottom: 1px solid var(--border-color) !important; font-size: 0.75rem !important;">Category</th>
                                    <th style="padding: 1rem !important; border-bottom: 1px solid var(--border-color) !important; font-size: 0.75rem !important;">Base Price</th>
                                    <th style="padding: 1rem !important; border-bottom: 1px solid var(--border-color) !important; font-size: 0.75rem !important;">Status</th>
                                    <th style="text-align: right; padding: 1rem !important; border-bottom: 1px solid var(--border-color) !important; font-size: 0.75rem !important;">Sold To</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% players.forEach(player => { %>
                                    <% 
                                        const cat = typeof categories !== 'undefined' && categories ? categories.find(c => c.id === player.category_id) : null;
                                        const catName = cat ? cat.name : 'OPEN';
                                        const shortUid = String(player.id).length > 6 ? '..' + String(player.id).slice(-5) : player.id;
                                        const realUploadedId = player.formNo ? String(player.formNo).trim() : (String(player.id).length > 6 ? '..' + String(player.id).slice(-5) : player.id);
                                    %>
                                    <tr>
                                        <td style="font-family: monospace; font-weight: 900; color: #fbbf24; padding: 1rem !important; vertical-align: middle; font-size: 0.95rem;">#<%= realUploadedId %></td>
                                        <td style="font-family: monospace; font-size: 0.75rem; color: #94a3b8; padding: 1rem !important; vertical-align: middle;"><span style="background: rgba(255,255,255,0.06); padding: 0.2rem 0.45rem; border-radius: 4px; border: 1px solid rgba(255,255,255,0.1);">UID: <%= shortUid %></span></td>
                                        <td style="font-weight: 700; padding: 1rem !important; vertical-align: middle;"><%= player.name %></td>
                                        <td style="padding: 1rem !important; vertical-align: middle;"><span style="font-size: 0.82rem; font-weight: 600; color: var(--text-muted);"><%= player.role %></span></td>
                                        <td style="padding: 1rem !important; vertical-align: middle;"><span style="font-size: 0.82rem; color: var(--primary); font-weight: 700; letter-spacing: 0.5px;"><%= catName %></span></td>
                                        <td style="font-weight: bold; padding: 1rem !important; vertical-align: middle;">$<%= player.basePrice.toLocaleString() %></td>
                                        <td style="padding: 1rem !important; vertical-align: middle;"><span class="badge badge-<%= player.status %>"><%= player.status %></span></td>
                                        <td style="text-align: right; font-weight: 700; color: var(--accent); padding: 1rem !important; vertical-align: middle;"><%= player.soldTo || '-' %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
