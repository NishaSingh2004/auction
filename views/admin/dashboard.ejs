    </div>
    
    <script>
    // Global caches are populated by EJS below in the page, but let's make sure they are accessible.
    // If window.currentPlayersDataCache isn't ready yet, it will be by the time user clicks.
    function openTeamDetailsModal(teamName) {
        if (!window.currentTeamsCache || !window.currentPlayersDataCache) return;
        
        const team = window.currentTeamsCache.find(t => t.name === teamName);
        if (!team) return;
        
        const teamPlayers = window.currentPlayersDataCache.filter(p => p.soldTo === team.name && p.status === 'sold');
        
        // Update Header
        document.getElementById('tdmName').textContent = team.shortName || team.name;
        document.getElementById('tdmSize').textContent = teamPlayers.length;
        
        const logoEl = document.getElementById('tdmLogo');
        const fbEl = document.getElementById('tdmLogoFallback');
        if (team.logo) {
            logoEl.src = team.logo;
            logoEl.style.display = 'block';
            fbEl.style.display = 'none';
        } else {
            logoEl.style.display = 'none';
            fbEl.style.display = 'flex';
            fbEl.textContent = (team.shortName || team.name).substring(0, 2).toUpperCase();
        }
        
        // Finances
        const totalSpent = teamPlayers.reduce((sum, p) => sum + (parseInt(p.soldPrice) || 0), 0);
        document.getElementById('tdmPurse').textContent = formatCurrencyLocal(team.budget);
        document.getElementById('tdmSpent').textContent = formatCurrencyLocal(totalSpent);
        
        // Roles calculation (assuming standard roles like Batsman, Bowler, All-Rounder, Wicket Keeper)
        const roleStats = {};
        teamPlayers.forEach(p => {
            const role = p.role || 'Unknown';
            roleStats[role] = (roleStats[role] || 0) + 1;
        });
        
        const rolesHtml = Object.keys(roleStats).map(role => {
            const count = roleStats[role];
            const pct = Math.round((count / Math.max(1, teamPlayers.length)) * 100);
            
            // Randomish color based on role
            let color = '#a78bfa'; // default purple
            const roleUpper = role.toUpperCase();
            if (roleUpper.includes('BAT')) color = '#93c5fd';
            if (roleUpper.includes('BOWL')) color = '#fdba74';
            if (roleUpper.includes('ALL')) color = '#86efac';
            if (roleUpper.includes('KEEP')) color = '#fca5a5';
            
            return `
                <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                    <div style="display: flex; justify-content: space-between; font-size: 0.75rem; font-weight: 700;">
                        <span style="color: rgba(255,255,255,0.8);">${role} (${count})</span>
                        <span style="color: rgba(255,255,255,0.8);">${pct}%</span>
                    </div>
                    <div style="height: 6px; background: rgba(255,255,255,0.05); border-radius: 3px; overflow: hidden;">
                        <div style="height: 100%; width: ${pct}%; background: ${color}; border-radius: 3px;"></div>
                    </div>
                </div>
            `;
        }).join('');
        
        document.getElementById('tdmRolesContainer').innerHTML = rolesHtml || '<div style="font-size: 0.75rem; color: rgba(255,255,255,0.4);">No players drafted yet.</div>';
        
        // Roster HTML
        const rosterHtml = teamPlayers.sort((a,b) => parseInt(b.soldPrice||0) - parseInt(a.soldPrice||0)).map(p => `
            <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); padding: 0.65rem 0.9rem; border-radius: 8px; display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; margin-bottom: 0.4rem;">
                <div style="display: flex; align-items: center; gap: 0.6rem;">
                    <img src="${p.photo || '/uploads/default-player.svg'}" style="width: 28px; height: 28px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(255,255,255,0.1);">
                    <div style="display: flex; flex-direction: column; text-align: left;">
                        <span style="color: #fff; font-size: 0.85rem; font-weight: 800;">${p.name} ${p.isCaptain ? '👑' : ''}</span>
                        <span style="color: rgba(255,255,255,0.5); font-size: 0.68rem; text-transform: uppercase;">${p.role || '--'} • #${p.formNo || p.id}</span>
                    </div>
                </div>
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <span style="color: #fbbf24; font-size: 0.85rem; font-weight: 900;">${formatCurrencyLocal(p.soldPrice)}</span>
                    <button type="button" onclick="window.removePlayerFromTeam('${p.id}', '${p.name.replace(/'/g, "\\'")}', '${team.name.replace(/'/g, "\\'")}', '${p.soldPrice}')" class="btn" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.35); padding: 0.25rem 0.65rem; border-radius: 6px; font-size: 0.72rem; font-weight: 800; cursor: pointer; transition: all 0.2s;" title="Remove player from ${team.name} & refund purse">
                        ✕ Remove
                    </button>
                </div>
            </div>
        `).join('');
        
        document.getElementById('tdmRosterContainer').innerHTML = rosterHtml || '<div style="font-size: 0.75rem; color: rgba(255,255,255,0.4);">Roster is empty.</div>';
        
        document.getElementById('teamDetailsModalOverlay').style.display = 'flex';
    }
    
    // Fallback formatCurrency if not defined yet
    if (typeof formatCurrencyLocal !== 'function') {
        window.formatCurrencyLocal = function(amount) {
            return '₹' + parseInt(amount).toLocaleString('en-IN');
        }
    }
    </script>
    <script>
    function triggerNextPlayer() {
        const select = document.getElementById('playerSelect');
        const startBtn = document.getElementById('startBtn');
        if (select && select.options.length > 0) {
            let currentIndex = select.selectedIndex;
            let nextIndex = currentIndex + 1;
            while (nextIndex < select.options.length && select.options[nextIndex].value === '') {
                nextIndex++;
            }
            if (nextIndex < select.options.length) {
                select.selectedIndex = nextIndex;
            } else {
                for(let i=0; i<select.options.length; i++){
                    if(select.options[i].value !== '') {
                        select.selectedIndex = i;
                        break;
                    }
                }
            }
            startBtn.click();
        }
    }
    
    function filterPlayerDropdown(val) {
        const select = document.getElementById('playerSelect');
        const filter = val.toLowerCase();
        for (let i = 0; i < select.options.length; i++) {
            const txt = select.options[i].text.toLowerCase();
            select.options[i].style.display = txt.includes(filter) ? 'block' : 'none';
        }
    }
    
    
    window.handleManualPlayerSearch = function(query) {
        const q = (query || '').trim().toLowerCase();
        const clearBtn = document.getElementById('clearPlayerSearchBtn');
        const queue = document.getElementById('leftPlayerQueue');
        const matchCountEl = document.getElementById('queueMatchCount');
        const dropdown = document.getElementById('visiblePlayerDropdown');
        
        if (clearBtn) clearBtn.style.display = q ? 'block' : 'none';

        const allPlayers = window.currentPlayersDataCache || [];
        
        // Filter dropdown options
        if (dropdown) {
            let matchCount = 0;
            Array.from(dropdown.options).forEach((opt, idx) => {
                if (idx === 0) {
                    opt.style.display = '';
                    return;
                }
                const txt = opt.textContent.toLowerCase();
                const matches = !q || txt.includes(q);
                opt.style.display = matches ? '' : 'none';
                if (matches) matchCount++;
            });
            if (matchCountEl) {
                matchCountEl.textContent = q ? (matchCount + ' found') : '';
            }
        }

        // Filter left queue list
        if (queue && allPlayers.length > 0) {
            const matches = allPlayers.filter(p => {
                if (!q) return p.status === 'available';
                const name = (p.name || '').toLowerCase();
                const formNo = String(p.formNo || '').toLowerCase();
                const role = (p.role || '').toLowerCase();
                return name.includes(q) || formNo.includes(q) || role.includes(q);
            });

            if (matches.length === 0) {
                queue.innerHTML = '<div style="text-align:center; padding: 2rem 1rem; color: rgba(255,255,255,0.4); font-size: 0.75rem;">No players found matching \'' + query + '\'</div>';
            } else {
                const displayList = q ? matches : matches.slice(0, 20);
                queue.innerHTML = displayList.map(p => {
                    const initials = (p.name || 'PL').substring(0,2).toUpperCase();
                    const statusBadge = p.status === 'available' 
                        ? '<span style="color:#10b981; font-size:0.6rem; font-weight:800;">AVAILABLE</span>'
                        : '<span style="color:#ef4444; font-size:0.6rem; font-weight:800;">' + (p.status || '').toUpperCase() + '</span>';
                    const price = window.formatCurrencyLocal ? window.formatCurrencyLocal(p.basePrice) : ('₹' + (p.basePrice || 0));

                    return `
                    <div style="background: #161821; border-radius: 8px; padding: 0.75rem; display: flex; align-items: center; gap: 0.75rem; border: 1px solid rgba(255,255,255,0.06); cursor: pointer; transition: all 0.2s;" 
                         onmouseover="this.style.borderColor='rgba(251,191,36,0.4)'; this.style.background='#1e2230';" 
                         onmouseout="this.style.borderColor='rgba(255,255,255,0.06)'; this.style.background='#161821';"
                         onclick="loadSpecificPlayer('${p.id}')">
                        <div style="width: 36px; height: 36px; background: rgba(255,255,255,0.1); border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 800; color: #fbbf24; flex-shrink: 0;">
                            ${initials}
                        </div>
                        <div style="display: flex; flex-direction: column; flex: 1; min-width: 0;">
                            <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.25rem;">
                                <span style="color: #fff; font-size: 0.8rem; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${p.name}</span>
                                <span style="font-size: 0.65rem; color: #fbbf24; font-weight: 800; font-family: monospace;">#${p.formNo || 'N/A'}</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.15rem;">
                                <span style="color: rgba(255,255,255,0.5); font-size: 0.65rem;">${p.role || 'Player'} • ${price}</span>
                                ${statusBadge}
                            </div>
                        </div>
                    </div>`;
                }).join('');
            }
        }
    };

    window.clearManualPlayerSearch = function() {
        const input = document.getElementById('manualPlayerSearchInput');
        if (input) input.value = '';
        window.handleManualPlayerSearch('');
    };

    window.refreshManualPlayerSelector = function() {
        const dropdown = document.getElementById('visiblePlayerDropdown');
        const allPlayers = window.currentPlayersDataCache || [];
        const avail = allPlayers.filter(p => p.status === 'available').sort((a,b) => a.name.localeCompare(b.name));
        
        if (dropdown) {
            const curVal = dropdown.value;
            dropdown.innerHTML = '<option value="">-- Choose Player to Start --</option>' + avail.map(p => `
                <option value="${p.id}">#${p.formNo || '?'} ${p.name} (${p.role || 'Player'})</option>
            `).join('');
            if (curVal && avail.some(p => p.id === curVal)) {
                dropdown.value = curVal;
            }
        }
        
        const searchInput = document.getElementById('manualPlayerSearchInput');
        if (searchInput && searchInput.value) {
            window.handleManualPlayerSearch(searchInput.value);
        } else {
            window.handleManualPlayerSearch('');
        }
    };

    
    function previewSponsorLogo(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const el = document.getElementById('sponsorLogoPreview');
                if (el) el.src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    function switchLeftSidebarTab(tab) {
        const tabLive = document.getElementById('tabLiveLeft');
        const tabUpcoming = document.getElementById('tabUpcomingLeft');
        const liveContainer = document.getElementById('leftLiveContainer');
        const upcomingContainer = document.getElementById('leftUpcomingContainer');
        
        if (tab === 'live') {
            if (tabLive) {
                tabLive.style.color = '#fbbf24';
                tabLive.style.borderBottom = '2px solid #fbbf24';
            }
            if (tabUpcoming) {
                tabUpcoming.style.color = 'rgba(255,255,255,0.4)';
                tabUpcoming.style.borderBottom = 'none';
            }
            if (liveContainer) liveContainer.style.display = 'flex';
            if (upcomingContainer) upcomingContainer.style.display = 'none';
        } else {
            if (tabLive) {
                tabLive.style.color = 'rgba(255,255,255,0.4)';
                tabLive.style.borderBottom = 'none';
            }
            if (tabUpcoming) {
                tabUpcoming.style.color = '#38bdf8';
                tabUpcoming.style.borderBottom = '2px solid #38bdf8';
            }
            if (liveContainer) liveContainer.style.display = 'none';
            if (upcomingContainer) upcomingContainer.style.display = 'flex';
        }
    }

    function filterUpcomingAuctions(selectedDate) {
        const queue = document.getElementById('leftUpcomingAuctionQueue');
        const countSpan = document.getElementById('upcomingAuctionCount');
        const cards = document.querySelectorAll('.upcoming-auction-card');
        const dateStr = (selectedDate || '').trim();
        
        let visibleCount = 0;
        cards.forEach(card => {
            const cardDate = (card.getAttribute('data-date') || '').trim();
            if (!dateStr || cardDate === dateStr) {
                card.style.display = 'flex';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });
        
        if (countSpan) {
            countSpan.textContent = dateStr ? (visibleCount + ' for ' + dateStr) : (visibleCount + ' Events');
        }
    }

    function clearUpcomingDateFilter() {
        const input = document.getElementById('upcomingDateFilterInput');
        if (input) input.value = '';
        filterUpcomingAuctions('');
    }

    async function selectAuctionAdmin(auctionId) {
        try {
            const res = await fetch('/admin/select-auction', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ auctionId })
            });
            const data = await res.json();
            if (data.success) {
                if (typeof showToast === 'function') {
                    showToast('Switched to auction: ' + (data.auctionDetails ? data.auctionDetails.name : auctionId), 'success');
                }
                setTimeout(() => window.location.reload(), 600);
            } else {
                alert(data.error || 'Failed to select auction');
            }
        } catch (e) {
            console.error(e);
            alert('Error selecting auction: ' + e.message);
        }
    }

    function loadSpecificPlayer(id) {
        const select = document.getElementById('playerSelect');
        const startBtn = document.getElementById('startBtn');
        if (select && startBtn) {
            select.value = id;
            startBtn.click();
        }
    }
    
    const origObserver = new MutationObserver((mutations) => {
        const livePhoto = document.getElementById('livePlayerPhoto');
        const liveBg = document.getElementById('livePlayerPhotoBg');
        if (livePhoto && liveBg && livePhoto.src !== liveBg.src) {
            liveBg.src = livePhoto.src;
        }
    });
    window.addEventListener('load', () => {
        const livePhoto = document.getElementById('livePlayerPhoto');
        if(livePhoto) origObserver.observe(livePhoto, { attributes: true, attributeFilter: ['src'] });
    });
    </script>
         <!-- DATA MANAGEMENT MODAL -->
         <div id="dataModal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(7,11,20,0.92); z-index: 9999; justify-content: center; align-items: center; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);">
             <div class="panel animate-fade-in" style="width: 95%; max-width: 1250px; height: 85vh; display: flex; flex-direction: column; overflow: hidden; position: relative; border: 1px solid var(--border-color); background: var(--bg-dark); padding: 1.5rem 2rem; border-radius: 16px; box-shadow: var(--shadow-luxury); text-align: left;">
                 
                 <!-- Header -->
                 <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-shrink: 0;">
                     <h2 style="font-size: 1.45rem; font-weight: 800; background: var(--primary-gradient); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif;">⚙️ Database & System Management</h2>
                     <button onclick="document.getElementById('dataModal').style.display='none'" class="btn btn-danger" style="padding: 0.45rem 1.25rem; font-weight: 800; font-size: 0.8rem; border-radius: 8px;">Close (X)</button>
                 </div>

                 <!-- Navigation Tabs -->
                 <div style="display: flex; gap: 0.2rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0px; flex-shrink: 0; overflow-x: auto;">
                     <button class="modal-tab-btn active" onclick="switchModalTab('franchises')">🛡️ FRANCHISES</button>
                     <button class="modal-tab-btn" onclick="switchModalTab('players')">👤 PLAYERS</button>
                     <button class="modal-tab-btn" onclick="switchModalTab('categories')">📁 CATEGORIES</button>
                     <button class="modal-tab-btn" onclick="switchModalTab('auction')">🏆 ADD AUCTION</button>
                     <button class="modal-tab-btn" onclick="switchModalTab('advanced')">⚡ SYSTEM CONSOLE</button>
                     <button class="modal-tab-btn" onclick="switchModalTab('links')" style="color: #38bdf8; font-weight: 800;">📡 STREAM & LIVE LINKS</button>
                 </div>

                 <!-- Tabs Content Container -->
                 <div class="sleek-scroll" style="flex: 1; overflow-y: auto; padding-right: 0.4rem; min-height: 0;">
                     
                     <!-- TAB: CATEGORIES -->
                     <div id="modalTabCategories" class="modal-tab-content" style="display: none;">
                         <div style="display: grid; grid-template-columns: 1fr 1.5fr; gap: 1.5rem; align-items: start;">
                             <div class="panel" style="background: rgba(15, 23, 42, 0.3); padding: 1.25rem; border-radius: 12px;">
                                 <h3 style="margin: 0 0 1rem 0; font-size: 1rem; color: var(--primary); font-weight: 800; text-transform: uppercase;">📁 Add New Category</h3>
                                 <form id="addCategoryForm" class="stacked-form">
                                     <input type="hidden" name="submitAction" id="categorySubmitAction" value="add">
                                     <input type="hidden" name="id" value="">
                                     
                                     <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Category Name *:</label>
                                         <input type="text" name="name" placeholder="Category Name" required class="form-control" style="border-radius: 8px !important;">
                                     </div>

                                     <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                                         <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                                             <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Max Players / Team:</label>
                                             <input type="number" name="maxPlayers" value="0" class="form-control" style="border-radius: 8px !important;">
                                         </div>
                                         <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                                             <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Min Players:</label>
                                             <input type="number" name="minPlayers" value="0" class="form-control" style="border-radius: 8px !important;">
                                         </div>
                                     </div>

                                     <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Base Bid:</label>
                                         <input type="number" name="baseBid" value="0" class="form-control" style="border-radius: 8px !important;">
                                     </div>

                                     <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Increment:</label>
                                         <input type="number" name="increment" value="0" class="form-control" style="border-radius: 8px !important;">
                                     </div>

                                     <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Reserve Bid:</label>
                                         <input type="number" name="reserveBid" value="0" class="form-control" style="border-radius: 8px !important;">
                                     </div>

                                     <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Highest Bid (per Player):</label>
                                         <input type="number" name="highestBidPerPlayer" value="0" class="form-control" style="border-radius: 8px !important;">
                                     </div>

                                     <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Category Highest Bid (all Players):</label>
                                         <input type="number" name="categoryHighestBidAll" value="0" class="form-control" style="border-radius: 8px !important;">
                                     </div>

                                     <div style="display: flex; flex-direction: column; gap: 0.3rem; width: 100px;">
                                         <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Category Color:</label>
                                         <div style="display: flex; align-items: center; justify-content: center; background: var(--bg-dark); border: 1px solid var(--border-color); padding: 0.3rem; border-radius: 8px; height: 38px;">
                                             <input type="color" name="color" value="#ffffff" style="border: none; background: none; width: 28px; height: 28px; cursor: pointer; padding: 0;" title="Category Color">
                                         </div>
                                     </div>

                                     <div style="display: flex; gap: 0.5rem; margin-top: 1rem;">
                                         <button type="submit" id="saveNewCategoryBtn" onclick="document.getElementById('categorySubmitAction').value='add_and_new'" class="btn btn-primary" style="flex: 1.2; padding: 0.55rem; font-size: 0.8rem;">SAVE & NEW</button>
                                         <button type="submit" id="addCategoryBtn" onclick="document.getElementById('categorySubmitAction').value='add'" class="btn btn-secondary" style="flex: 1; padding: 0.55rem; font-size: 0.8rem;">SAVE</button>
                                     </div>
                                 </form>
                             </div>
                             <div class="panel" style="background: rgba(15, 23, 42, 0.3); padding: 1.25rem; overflow-y: auto; max-height: 70vh; border-radius: 12px;">
                                 <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.4rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">
                                     <h3 style="margin: 0; font-size: 1rem; color: var(--primary); font-weight: 800; text-transform: uppercase;">Existing Categories</h3>
                                     <div style="display: flex; gap: 0.35rem;">
                                         <button type="button" onclick="openBulkAddModal()" class="btn btn-secondary" style="padding: 0.3rem 0.65rem; font-size: 0.72rem; font-weight: 700; border-radius: 6px;">📁 Bulk Add</button>
                                         <button type="button" onclick="openBulkRemoveModal()" class="btn btn-danger" style="padding: 0.3rem 0.65rem; font-size: 0.72rem; font-weight: 700; background: rgba(239,68,68,0.12); color: #f87171; border: 1px solid rgba(239,68,68,0.25); border-radius: 6px;">🗑️ Bulk Remove</button>
                                     </div>
                                 </div>
                                 <div id="modalCategoryList" style="display: flex; flex-direction: column; gap: 0.5rem;">
                                     <% data.categories.forEach(cat => { %>
                                         <% 
                                             const catPlayers = cat.id.startsWith('cat_all_')
                                                 ? data.players.filter(p => p.status === 'sold')
                                                 : data.players.filter(p => p.category_id === cat.id && p.status === 'sold');
                                             const totalSold = catPlayers.reduce((sum, p) => sum + (p.soldPrice || 0), 0);
                                             const soldCount = catPlayers.length;
                                             const avgPrice = soldCount > 0 ? (totalSold / soldCount) : 0;
                                             const currency = data.auctionDetails && data.auctionDetails.units ? data.auctionDetails.units : '₹';
                                             
                                             const minPlayers = cat.id.startsWith('cat_all_') 
                                                 ? (data.auctionDetails ? (data.auctionDetails.playersPerTeamMin || 0) : 0)
                                                 : (cat.minPlayers || 0);
                                             const maxPlayers = cat.id.startsWith('cat_all_') 
                                                 ? (data.auctionDetails ? (data.auctionDetails.playersPerTeamMax || 0) : 0)
                                                 : (cat.maxPlayers || 0);
                                             const baseBid = cat.id.startsWith('cat_all_') 
                                                 ? (data.auctionDetails ? (data.auctionDetails.baseBid || 0) : 0)
                                                 : (cat.baseBid || 0);
                                         %>
                                         <div class="list-item" style="display: flex; justify-content: space-between; align-items: center; padding: 0.65rem 0.85rem; background: rgba(15, 23, 42, 0.45); border-radius: 8px; border-left: 4px solid <%= cat.color %>; border: 1px solid var(--border-color);">
                                             <div style="display: flex; flex-direction: column; gap: 0.15rem; text-align: left;">
                                                 <span style="font-weight: 800; font-size: 0.88rem; color: #fff;"><%= cat.name %></span>
                                                 <div style="font-size: 0.72rem; color: var(--text-muted); display: flex; flex-wrap: wrap; gap: 0.2rem 0.6rem;">
                                                     <span>Min/Max: <%= minPlayers %>/<%= maxPlayers %></span>
                                                     <span>Base Bid: <%= currency %><%= baseBid.toLocaleString() %></span>
                                                     <span style="color: var(--accent); font-weight: 700;">Avg: <%= currency %><%= Math.round(avgPrice).toLocaleString() %></span>
                                                 </div>
                                             </div>
                                             <div style="display: flex; gap: 0.35rem;">
                                                 <button type="button" class="btn edit-category-btn" data-id="<%= cat.id %>" data-name="<%= cat.name %>" data-maxplayers="<%= maxPlayers %>" data-minplayers="<%= minPlayers %>" data-basebid="<%= baseBid %>" data-increment="<%= cat.increment %>" data-reservebid="<%= cat.reserveBid %>" data-highestbidperplayer="<%= cat.highestBidPerPlayer %>" data-categoryhighestbidall="<%= cat.categoryHighestBidAll %>" data-color="<%= cat.color %>" style="background: rgba(59, 130, 246, 0.12); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.2); padding: 0.3rem 0.55rem; border-radius: 6px; font-size: 0.75rem; font-weight: 600; cursor: pointer; transition: all 0.2s;" title="Edit Category Details">✏️ Edit</button>
                                                 <% if (!cat.id.startsWith('cat_all_')) { %>
                                                     <button type="button" onclick="deleteCategory('<%= cat.id %>')" class="btn btn-danger" style="padding: 0.3rem 0.55rem; font-size: 0.75rem; font-weight: 600; border-radius: 6px;">DELETE</button>
                                                 <% } %>
                                             </div>
                                         </div>
                                     <% }) %>
                                 </div>
                             </div>
                         </div>
                     </div>

                     <!-- TAB: FRANCHISES -->
                     <div id="modalTabFranchises" class="modal-tab-content" style="display: block;">
                         <div style="display: grid; grid-template-columns: 1fr 1.5fr; gap: 1.5rem; align-items: start;">
                             <!-- Form Card -->
                             <div class="panel" style="background: rgba(15, 23, 42, 0.3); padding: 1.25rem; border-radius: 12px;">
                                 <h3 style="margin: 0 0 1rem 0; font-size: 1rem; color: var(--primary); font-weight: 800; text-transform: uppercase;">🛡️ Add New Franchise</h3>
                                  <form id="addTeamForm" class="stacked-form" enctype="multipart/form-data">
                                     <input type="hidden" name="submitAction" id="teamSubmitAction" value="add">
                                     <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Team Logo Asset *:</label>
                                         <div style="display: flex; align-items: center; gap: 0.85rem; background: var(--bg-dark); padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border-color);">
                                             <div id="logoPreviewContainer" style="width: 50px; height: 50px; border-radius: 6px; border: 1.5px dashed rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; overflow: hidden; background: #04060f; flex-shrink: 0;">
                                                 <img id="logoPreview" src="/uploads/default-player.svg" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.35;">
                                             </div>
                                             <div style="flex: 1;">
                                                 <input type="file" name="logo" id="logoInput" accept="image/*" class="form-control" style="font-size: 0.75rem; background: transparent; border: none; padding: 0;" onchange="if (this.files[0]) { document.getElementById('logoPreview').src = URL.createObjectURL(this.files[0]); document.getElementById('logoPreview').style.opacity = '1'; }">
                                                 <div style="font-size: 0.65rem; color: var(--text-muted); margin-top: 0.15rem;">PNG, JPG or SVG formats.</div>
                                             </div>
                                         </div>
                                     </div>

                                     <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Team Name *:</label>
                                         <input type="text" name="name" placeholder="Team Name" required class="form-control" style="border-radius: 8px !important;">
                                     </div>

                                     <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Team Short Name *:</label>
                                         <input type="text" name="shortName" placeholder="Short Name" required class="form-control" style="border-radius: 8px !important;">
                                     </div>

                                     <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Shortcut Keyboard Key *:</label>
                                         <input type="text" name="shortcutKey" placeholder="Shortcut Key (e.g. A, 1)" required maxlength="1" class="form-control" style="border-radius: 8px !important;">
                                     </div>

                                     <div style="display: flex; gap: 1rem;">
                                         <div style="display: flex; flex-direction: column; gap: 0.3rem; width: 100px;">
                                             <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Theme Color:</label>
                                             <div style="display: flex; align-items: center; justify-content: center; background: var(--bg-dark); border: 1px solid var(--border-color); padding: 0.3rem; border-radius: 8px; height: 38px;">
                                                 <input type="color" name="color" value="#3b82f6" style="border: none; background: none; width: 28px; height: 28px; cursor: pointer; padding: 0;" title="Team Theme Color">
                                             </div>
                                         </div>
                                     </div>

                                     <div style="display: flex; gap: 0.5rem; margin-top: 1rem;">
                                         <button type="submit" id="saveNewTeamBtn" onclick="document.getElementById('teamSubmitAction').value='add_and_new'" class="btn btn-primary" style="flex: 1.2; padding: 0.55rem; font-size: 0.8rem;">SAVE & NEW</button>
                                         <button type="submit" id="addTeamBtn" onclick="document.getElementById('teamSubmitAction').value='add'" class="btn btn-secondary" style="flex: 1; padding: 0.55rem; font-size: 0.8rem;">SAVE</button>
                                     </div>
                                  </form>
                             </div>

                             <!-- Directory Table Card -->
                             <div class="panel" style="background: rgba(15, 23, 42, 0.3); padding: 1.25rem; border-radius: 12px;">
                                 <h3 style="margin: 0 0 1rem 0; font-size: 1rem; color: var(--primary); font-weight: 800; text-transform: uppercase;">📋 Registered Franchises Directory</h3>
                                 <div style="max-height: 52vh; overflow-y: auto;">
                                     <table class="data-table" id="teamsTable">
                                         <thead>
                                             <tr>
                                                 <th style="font-size: 0.72rem !important;">TEAM IDENTITY</th>
                                                 <th style="font-size: 0.72rem !important;">SHORT NAME</th>
                                                 <th style="text-align: center; font-size: 0.72rem !important;">NOMINATE KEY</th>
                                                 <th style="text-align: right; font-size: 0.72rem !important;">WALLET BUDGET</th>
                                                 <th style="text-align: right; font-size: 0.72rem !important;">ACTIONS</th>
                                             </tr>
                                         </thead>
                                         <tbody>
                                             <% 
                                             const tblUnits = data.auctionDetails && data.auctionDetails.units ? data.auctionDetails.units : '₹';
                                             const formatTblCurrency = (amt) => ['₹', '$', '€', '£'].includes(tblUnits) ? `${tblUnits}${amt.toLocaleString()}` : `${amt.toLocaleString()} ${tblUnits}`;
                                             %>
                                             <% data.teams.forEach(team => { %>
                                                 <tr onclick="toggleAdminRoster('<%= team.name %>')" style="cursor: pointer;">
                                                     <td style="vertical-align: middle;">
                                                         <div style="display: flex; align-items: center; gap: 0.5rem;">
                                                             <% if (team.logo) { %>
                                                                 <img src="<%= team.logo %>" style="width: 24px; height: 24px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(255,255,255,0.12);">
                                                             <% } else { %>
                                                                 <span class="color-dot" <%- 'style="background-color: ' + team.color + '; width: 10px; height: 10px; border-radius: 3px; display: inline-block;"' %>></span>
                                                             <% } %>
                                                             <span style="font-weight: 800; color: #fff; font-size: 0.88rem;"><%= team.name %></span>
                                                             <span class="admin-toggle-arrow" style="font-size: 0.7rem; color: var(--text-muted); margin-left: 0.15rem;">▼</span>
                                                         </div>
                                                     </td>
                                                     <td style="color: var(--text-muted); vertical-align: middle;"><%= team.shortName || '--' %></td>
                                                     <td style="text-align: center; vertical-align: middle;"><span style="background: rgba(59, 130, 246, 0.08); color: var(--accent); padding: 0.15rem 0.45rem; border-radius: 4px; font-size: 0.72rem; font-weight: bold; border: 1px solid rgba(59,130,246,0.15);">Key <%= team.shortcutKey || '--' %></span></td>
                                                     <td style="text-align: right; font-weight: 700; color: var(--success); vertical-align: middle;"><%= formatTblCurrency(team.budget) %></td>
                                                     <td style="text-align: right; vertical-align: middle;" onclick="event.stopPropagation();">
                                                         <button type="button" class="btn edit-team-btn" data-id="<%= team.id %>" data-name="<%= team.name %>" data-shortname="<%= team.shortName || '' %>" data-shortcutkey="<%= team.shortcutKey || '' %>" data-budget="<%= team.budget %>" data-color="<%= team.color %>" data-logo="<%= team.logo || '' %>" style="background: rgba(59, 130, 246, 0.12); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.2); padding: 0.3rem 0.55rem; border-radius: 6px; font-size: 0.75rem; font-weight: 600; cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 0.2rem; margin-right: 0.2rem;" title="Edit Franchise Details">✏️ Edit</button>
                                                         <button type="button" onclick="deleteTeam('<%= team.id %>')" class="btn btn-danger" style="padding: 0.3rem 0.55rem; font-size: 0.75rem; font-weight: 600; border-radius: 6px; cursor: pointer;" title="Delete Franchise Team">🗑️ Delete</button>
                                                     </td>
                                                 </tr>
                                                 <tr class="admin-roster-row" id="admin-roster-<%= team.name.replace(/\s+/g, '-') %>" style="display: none; background: rgba(7, 11, 20, 0.45);">
                                                     <td colspan="5" style="padding: 0.85rem 1.15rem; border-bottom: 1px solid rgba(255,255,255,0.03);">
                                                         <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                                                             <div style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); font-weight: 700; margin-bottom: 0.3rem; display: flex; justify-content: space-between; align-items: center;">
                                                                 <span>Squad Roster & Nominate Captain Authority</span>
                                                                 <span style="font-size: 0.68rem; text-transform: none; font-weight: normal; color: var(--warning);">★ Click a player card to toggle Nominate as Captain</span>
                                                             </div>
                                                             <% const teamPlayers = data.players.filter(p => p.soldTo === team.name); %>
                                                             <% if (teamPlayers.length === 0) { %>
                                                                 <div style="font-size: 0.75rem; color: var(--text-muted); font-style: italic; text-align: left;">No players drafted to this franchise yet.</div>
                                                             <% } else { %>
                                                                 <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.5rem;">
                                                                     <% teamPlayers.sort((a, b) => b.soldPrice - a.soldPrice).forEach(player => { %>
                                                                         <div onclick="nominateCaptain('<%= player.id %>', '<%= team.name %>')" class="captain-card-option" <%- 'style="display: flex; justify-content: space-between; align-items: center; background: ' + (player.isCaptain ? 'rgba(212, 175, 55, 0.06)' : 'rgba(0,0,0,0.25)') + '; padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid ' + (player.isCaptain ? 'var(--border-color-active)' : 'rgba(255,255,255,0.02)') + '; cursor: pointer; transition: all 0.2s;"' %>>
                                                                             <div style="display: flex; align-items: center; gap: 0.45rem; text-align: left;">
                                                                                 <img src="<%= player.photo ? player.photo : '/uploads/default-player.svg' %>" <%- 'style="width: 24px; height: 24px; border-radius: 50%; object-fit: cover; border: 1.5px solid ' + (player.isCaptain ? 'var(--primary)' : 'rgba(255,255,255,0.08)') + ';"' %>>
                                                                                 <div style="display: flex; flex-direction: column;">
                                                                                     <span <%- 'style="font-size: 0.76rem; font-weight: 700; color: ' + (player.isCaptain ? 'var(--primary)' : '#f8fafc') + ';"' %>>
                                                                                         <%= player.name %> <%= player.isCaptain ? '👑' : '' %>
                                                                                     </span>
                                                                                     <span style="font-size: 0.62rem; color: var(--text-muted); text-transform: uppercase;"><%= player.role %></span>
                                                                                 </div>
                                                                             </div>
                                                                             <div style="display: flex; align-items: center; gap: 0.4rem;">
                                                                                  <span style="font-size: 0.76rem; font-weight: bold; color: var(--success);"><%= formatTblCurrency(player.soldPrice) %></span>
                                                                                  <button type="button" class="btn-remove-player" data-player-id="<%= player.id %>" data-player-name="<%= player.name %>" data-team-name="<%= team.name %>" data-sold-price="<%= player.soldPrice %>" onclick="event.stopPropagation(); window.handleRemovePlayerClick(this);" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.35); padding: 0.15rem 0.45rem; border-radius: 4px; font-size: 0.65rem; font-weight: 800; cursor: pointer; transition: all 0.2s;" title="Remove player from <%= team.name %>">✕</button>
                                                                              </div>
                                                                         </div>
                                                                     <% }) %>
                                                                 </div>
                                                             <% } %>
                                                         </div>
                                                     </td>
                                                 </tr>
                                             <% }) %>
                                         </tbody>
                                     </table>
                                 </div>
                             </div>
                         </div>
                     </div>

                     <!-- TAB: PLAYERS -->
                     <div id="modalTabPlayers" class="modal-tab-content" style="display: none;">
                         <div style="display: grid; grid-template-columns: 1fr 1.5fr; gap: 1.5rem; align-items: start;">
                             <!-- Left Form & CSV Upload Column -->
                             <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                                 <!-- Add Player Form -->
                                 <div class="panel" style="background: rgba(15, 23, 42, 0.3); padding: 1.25rem; border-radius: 12px;">
                                     <h3 style="margin: 0 0 1rem 0; font-size: 1rem; color: var(--primary); font-weight: 800; text-transform: uppercase;">👤 Register New Player</h3>
                                     <form id="addPlayerForm" class="stacked-form" enctype="multipart/form-data">
                                         <input type="hidden" name="submitAction" id="playerSubmitAction" value="add">
                                         
                                         <!-- Top Row: Photo & Fast fields -->
                                         <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem;">
                                             <!-- Left: Profile Pic Picker -->
                                             <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                                                 <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700;">Profile Pic:</label>
                                                 <div style="display: flex; align-items: center; gap: 0.6rem; background: var(--bg-dark); padding: 0.5rem; border-radius: 8px; border: 1px solid var(--border-color);">
                                                     <div style="width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid rgba(255,255,255,0.08); overflow: hidden; background: #04060f; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                                                         <img id="playerPhotoPreview" src="/uploads/default-player.svg" style="width: 100%; height: 100%; object-fit: cover;">
                                                     </div>
                                                     <div style="flex: 1; overflow: hidden;">
                                                         <input type="file" name="photo" id="playerPhotoInput" accept="image/*" style="font-size: 0.7rem; color: var(--text-muted); border: none; background: transparent; padding: 0; width: 100%;" onchange="if (this.files[0]) { document.getElementById('playerPhotoPreview').src = URL.createObjectURL(this.files[0]); }">
                                                     </div>
                                                 </div>
                                             </div>

                                             <!-- Right: Form No & Age -->
                                             <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                                 <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                                     <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 500;">Form No:</label>
                                                     <input type="text" name="formNo" id="playerFormNoInput" placeholder="Form Number" class="form-control" style="padding: 0.45rem 0.7rem !important; border-radius: 8px !important;">
                                                     <span id="formNoError" style="color: var(--danger); font-size: 0.68rem; display: none; margin-top: 1px;">⚠️ Already registered!</span>
                                                 </div>
                                                 <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                                     <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 500;">Age:</label>
                                                     <input type="number" name="age" placeholder="Age" class="form-control" style="padding: 0.45rem 0.7rem !important; border-radius: 8px !important;">
                                                 </div>
                                             </div>
                                         </div>

                                         <!-- Second Row: Name & Father Name -->
                                         <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem;">
                                             <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                                 <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700;">Name *:</label>
                                                 <input type="text" name="name" placeholder="Name" required class="form-control" style="padding: 0.45rem 0.7rem !important; border-radius: 8px !important;">
                                             </div>
                                             <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                                 <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 500;">Father Name:</label>
                                                 <input type="text" name="fatherName" placeholder="Father Name" class="form-control" style="padding: 0.45rem 0.7rem !important; border-radius: 8px !important;">
                                             </div>
                                         </div>

                                         <!-- Third Row: Mobile No & Tag/Owner -->
                                         <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem;">
                                             <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                                 <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 500;">Mobile No:</label>
                                                 <input type="text" name="phone" placeholder="Mobile Number" class="form-control" style="padding: 0.45rem 0.7rem !important; border-radius: 8px !important;">
                                             </div>
                                             <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                                 <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 500;">Tag/Owner:</label>
                                                 <select name="tagOwner" class="form-control" style="padding: 0.45rem 0.7rem !important; border-radius: 8px !important;">
                                                     <option value="">Select tag</option>
                                                     <option value="Icon Player">Icon Player</option>
                                                     <option value="Premium Player">Premium Player</option>
                                                     <option value="A Category">A Category</option>
                                                     <option value="B Category">B Category</option>
                                                     <option value="Custom">Custom Tag</option>
                                                 </select>
                                             </div>
                                         </div>

                                         <!-- Custom tag input -->
                                         <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                             <input type="text" name="customTag" placeholder="Custom tag (if applicable)" class="form-control" style="padding: 0.45rem 0.7rem !important; border-radius: 8px !important;">
                                         </div>

                                         <!-- Fourth Row: Playing Style Icon Radios -->
                                         <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                                             <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700;">Playing Style:</label>
                                             <input type="hidden" name="role" id="playerRoleInput" value="Batsman" required>
                                             <div style="display: flex; gap: 1rem; align-items: center; justify-content: center; background: var(--bg-dark); padding: 0.5rem; border-radius: 8px; border: 1px solid var(--border-color);">
                                                 <div onclick="selectPlayingStyle('Batsman')" id="style-Batsman" style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: rgba(212, 175, 55, 0.15); border: 2.5px solid var(--primary); cursor: pointer; transition: all 0.2s; font-size: 1.35rem; box-shadow: 0 0 10px rgba(212, 175, 55, 0.25);" title="Batsman">🏏</div>
                                                 <div onclick="selectPlayingStyle('Bowler')" id="style-Bowler" style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: #04060f; border: 2.5px solid rgba(255,255,255,0.08); cursor: pointer; transition: all 0.2s; font-size: 1.35rem;" title="Bowler">🔴</div>
                                                 <div onclick="selectPlayingStyle('Wicket-Keeper')" id="style-Wicket-Keeper" style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: #04060f; border: 2.5px solid rgba(255,255,255,0.08); cursor: pointer; transition: all 0.2s; font-size: 1.35rem;" title="Wicket-Keeper">🧤</div>
                                                 <div onclick="selectPlayingStyle('All-Rounder')" id="style-All-Rounder" style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: #04060f; border: 2.5px solid rgba(255,255,255,0.08); cursor: pointer; transition: all 0.2s; font-size: 1.35rem;" title="All-Rounder">💫</div>
                                             </div>
                                         </div>

                                         <!-- Fifth Row: Specifications -->
                                         <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.4rem;">
                                             <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                                 <label style="font-size: 0.72rem; color: var(--text-muted); font-weight: 500;">Spec 1:</label>
                                                 <select name="specification1" class="form-control" style="padding: 0.45rem !important; font-size: 0.78rem !important; border-radius: 8px !important;">
                                                     <option value="">-Spec 1-</option>
                                                     <option value="Right Handed">Right Handed</option>
                                                     <option value="Left Handed">Left Handed</option>
                                                 </select>
                                             </div>
                                             <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                                 <label style="font-size: 0.72rem; color: var(--text-muted); font-weight: 500;">Spec 2:</label>
                                                 <select name="specification2" class="form-control" style="padding: 0.45rem !important; font-size: 0.78rem !important; border-radius: 8px !important;">
                                                     <option value="">-Spec 2-</option>
                                                     <option value="Fast Bowler">Fast Bowler</option>
                                                     <option value="Spin Bowler">Spin Bowler</option>
                                                     <option value="Medium Pacer">Medium Pacer</option>
                                                 </select>
                                             </div>
                                             <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                                 <label style="font-size: 0.72rem; color: var(--text-muted); font-weight: 500;">Spec 3:</label>
                                                 <select name="specification3" class="form-control" style="padding: 0.45rem !important; font-size: 0.78rem !important; border-radius: 8px !important;">
                                                     <option value="">-Spec 3-</option>
                                                     <option value="Opening Batsman">Opening Batsman</option>
                                                     <option value="Middle Order">Middle Order</option>
                                                     <option value="Finisher">Finisher</option>
                                                 </select>
                                             </div>
                                         </div>

                                         <!-- Sixth Row: T-shirt size & Jersey Name -->
                                         <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem;">
                                             <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                                 <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 500;">T-shirt size:</label>
                                                 <input type="text" name="tshirtSize" placeholder="S/M/L/XL/..." class="form-control" style="padding: 0.45rem 0.7rem !important; border-radius: 8px !important;">
                                             </div>
                                             <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                                 <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 500;">Jersey Name:</label>
                                                 <input type="text" name="jerseyName" placeholder="Jersey Name" class="form-control" style="padding: 0.45rem 0.7rem !important; border-radius: 8px !important;">
                                             </div>
                                         </div>

                                         <!-- Seventh Row: Jersey Number & Trouser Size -->
                                         <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem;">
                                             <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                                 <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 500;">Jersey Number:</label>
                                                 <input type="text" name="jerseyNumber" placeholder="Jersey Number" class="form-control" style="padding: 0.45rem 0.7rem !important; border-radius: 8px !important;">
                                             </div>
                                             <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                                 <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 500;">Trouser Size:</label>
                                                 <input type="text" name="trouserSize" placeholder="S/M/L/XL/..." class="form-control" style="padding: 0.45rem 0.7rem !important; border-radius: 8px !important;">
                                             </div>
                                         </div>

                                         <!-- Eighth Row: Detail -->
                                         <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                             <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 500;">Detail:</label>
                                             <textarea name="detail" placeholder="Detail" rows="2" class="form-control" style="padding: 0.45rem 0.7rem !important; border-radius: 8px !important; resize: vertical;"></textarea>
                                         </div>
                                         
                                         <!-- Category Selection -->
                                         <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                             <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700;">Category:</label>
                                             <select name="category_id" class="form-control" style="padding: 0.45rem 0.7rem !important; border-radius: 8px !important;">
                                                 <% data.categories.forEach(cat => { %>
                                                     <option value="<%= cat.id %>"><%= cat.name %> (Max: <%= cat.maxPlayers %>)</option>
                                                 <% }) %>
                                             </select>
                                         </div>

                                         <!-- Ninth Row: Base Value -->
                                         <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                             <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700;">Base Price *:</label>
                                             <input type="number" name="basePrice" placeholder="Base Price" required class="form-control" style="padding: 0.45rem 0.7rem !important; border-radius: 8px !important;">
                                             <span style="font-size: 0.68rem; color: var(--text-muted); margin-top: 0.1rem;">(If different from Minimum Base or Category Base Value)</span>
                                         </div>

                                         <!-- Action Buttons -->
                                         <div style="display: flex; gap: 0.5rem; margin-top: 1rem;">
                                             <button type="submit" id="saveNewPlayerBtn" onclick="document.getElementById('playerSubmitAction').value='add_and_new'" class="btn btn-primary" style="flex: 1.2; padding: 0.55rem; font-size: 0.8rem;">SAVE & NEW</button>
                                             <button type="submit" id="addPlayerBtn" onclick="document.getElementById('playerSubmitAction').value='add'" class="btn btn-secondary" style="flex: 1; padding: 0.55rem; font-size: 0.8rem;">SAVE</button>
                                         </div>
                                     </form>
                                 </div>

                                 <!-- CSV / Excel Upload Card -->
                                 <div class="panel" style="background: rgba(15, 23, 42, 0.3); padding: 1.25rem; border-radius: 12px;">
                                     <h3 style="margin: 0 0 0.85rem 0; font-size: 0.95rem; color: var(--primary); font-weight: 800; text-transform: uppercase;">📥 CSV / Excel Bulk Import</h3>
                                     <form id="uploadCsvForm" class="stacked-form" onsubmit="event.preventDefault();">
                                         <label style="color: var(--text-muted); font-size: 0.75rem; line-height: 1.4;">Upload a spreadsheet CSV or Excel (.xlsx, .xls) file. Columns: <strong>Name, BasePrice, Role</strong></label>
                                         <div style="display: flex; gap: 0.4rem; align-items: center; margin-top: 0.4rem;">
                                             <input type="file" name="csvFile" accept=".csv, .xlsx, .xls" required class="form-control" style="font-size: 0.75rem; background: var(--bg-dark); border: 1px solid var(--border-color); padding: 0.35rem !important; border-radius: 8px !important;">
                                             <button type="submit" class="btn btn-primary" style="padding: 0.55rem 1.15rem; font-size: 0.8rem; font-weight: 800; white-space: nowrap; border-radius: 8px;">Upload</button>
                                         </div>
                                     </form>
                                 </div>
                             </div>

                             <!-- Right Column (Directory & Bulk Photo Upload) -->
                             <div style="display: flex; flex-direction: column; gap: 1.25rem;">

                                 <!-- Players Table -->
                                 <div class="panel" style="background: rgba(15, 23, 42, 0.3); padding: 1.25rem; border-radius: 12px;">
                                     <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.85rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">
                                         <h3 style="margin: 0; font-size: 1rem; color: var(--primary); font-weight: 800; text-transform: uppercase;">📋 Registered Players Directory</h3>
                                         <button id="bulkUnsoldBtn" onclick="bulkUnsoldSelectedPlayers()" class="btn" style="background: rgba(245, 158, 11, 0.15); color: #fb923c; border: 1px solid rgba(245, 158, 11, 0.25); padding: 0.35rem 0.85rem; border-radius: 6px; font-weight: bold; font-size: 0.75rem; cursor: pointer;" disabled>
                                             ↩️ Bulk Unsold (0 Selected)
                                         </button>
                                     </div>
                                     <input type="text" id="directorySearchInput" placeholder="Search Player by Name or Form No..." style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 0.65rem; border-radius: 6px; font-size: 0.9rem; margin-bottom: 1rem;" oninput="filterDirectoryTable()">
                                     <div style="max-height: 52vh; overflow-y: auto;">
                                         <table class="data-table" id="playersTable">
                                             <thead>
                                                 <tr>
                                                     <th style="width: 36px; text-align: center;"><input type="checkbox" id="selectAllPlayers" onchange="toggleSelectAllPlayers(this)"></th>
                                                     <th style="font-size: 0.72rem !important; color: #fbbf24 !important;">REAL PLAYER ID</th>
                                                    <th style="font-size: 0.72rem !important; color: #94a3b8 !important;">UNIQUE ID (SHORT)</th>
                                                     <th style="font-size: 0.72rem !important;">PLAYER NAME</th>
                                                     <th style="font-size: 0.72rem !important;">CATEGORY</th>
                                                     <th style="font-size: 0.72rem !important;">PLAYING ROLE</th>
                                                     <th style="text-align: right; font-size: 0.72rem !important;">STATUS</th>
                                                     <th style="text-align: right; font-size: 0.72rem !important;">ACTIONS</th>
                                                 </tr>
                                             </thead>
                                             <tbody>
                                                 <% data.players.sort((a, b) => a.name.localeCompare(b.name)).forEach(player => { %>
                                                     <% 
                                                         const cat = data.categories ? data.categories.find(c => c.id === player.category_id) : null;
                                                         const catName = cat ? cat.name : 'OPEN';
                                                     %>
                                                     <tr style="font-size: 0.85rem;">
                                                         <td style="text-align: center; vertical-align: top; padding: 0.65rem 0.5rem !important;">
                                                             <% if (player.status === 'sold') { %>
                                                                 <input type="checkbox" class="player-select-checkbox" data-id="<%= player.id %>" onchange="updateBulkBtnState()">
                                                             <% } else { %>
                                                                 <input type="checkbox" disabled style="opacity: 0.25;">
                                                             <% } %>
                                                         </td>
                                                         <td style="font-family: monospace; font-weight: 900; vertical-align: top; color: #fbbf24; padding: 0.65rem 0.5rem !important; font-size: 0.95rem;">
                                                             #<%= player.formNo ? String(player.formNo).trim() : (String(player.id).length > 6 ? '..' + String(player.id).slice(-5) : player.id) %>
                                                         </td>
                                                         <td style="font-family: monospace; font-size: 0.72rem; vertical-align: top; color: #94a3b8; padding: 0.65rem 0.5rem !important;">
                                                             <span style="background: rgba(255,255,255,0.06); padding: 0.2rem 0.45rem; border-radius: 4px; border: 1px solid rgba(255,255,255,0.1);" title="Database UID: <%= player.id %>">UID: <%= String(player.id).length > 6 ? '..' + String(player.id).slice(-5) : player.id %></span>
                                                         </td>
                                                         <td style="font-weight: 700; vertical-align: top; text-align: left; padding: 0.65rem 0.5rem !important;">
                                                             <%= player.name %>
                                                             <% if (player.detail) { %>
                                                                 <div style="font-size: 0.7rem; font-weight: normal; color: var(--text-muted); margin-top: 0.25rem; white-space: pre-wrap; line-height: 1.3; background: rgba(0,0,0,0.2); padding: 0.3rem 0.5rem; border-radius: 6px; border: 1px solid var(--border-color); font-family: monospace; max-width: 400px; max-height: 70px; overflow-y: auto; text-align: left;"><%= player.detail %></div>
                                                             <% } %>
                                                         </td>
                                                         <td style="color: var(--text-muted); vertical-align: top; text-align: left; padding: 0.65rem 0.5rem !important;"><%= catName %></td>
                                                         <td style="color: var(--text-muted); vertical-align: top; text-align: left; padding: 0.65rem 0.5rem !important;"><%= player.role %></td>
                                                         <td style="text-align: right; vertical-align: top; padding: 0.65rem 0.5rem !important;">
                                                             <span class="badge badge-<%= player.status %>" style="font-size: 0.65rem !important; padding: 0.15rem 0.4rem !important;"><%= player.status.toUpperCase() %></span>
                                                         </td>
                                                          <td style="text-align: right; vertical-align: top; padding: 0.65rem 0.5rem !important;" onclick="event.stopPropagation();">
                                                              <% if (player.status === 'sold') { %>
                                                                  <button onclick="markPlayerUnsold('<%= player.id %>')" class="btn" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.2); padding: 0.3rem 0.55rem; border-radius: 6px; font-size: 0.75rem; font-weight: 600; cursor: pointer; transition: all 0.2s; margin-right: 0.25rem;" title="Revert player to Unsold status">↩️ Unsold</button>
                                                              <% } %>
                                                              <button class="btn edit-player-btn" data-id="<%= player.id %>" data-name="<%= player.name %>" data-role="<%= player.role %>" data-baseprice="<%= player.basePrice %>" data-phone="<%= player.phone || '' %>" data-photo="<%= player.photo || '' %>" data-formno="<%= player.formNo || '' %>" data-age="<%= player.age || '' %>" data-fathername="<%= player.fatherName || '' %>" data-tagowner="<%= player.tagOwner || '' %>" data-customtag="<%= player.customTag || '' %>" data-specification1="<%= player.specification1 || '' %>" data-specification2="<%= player.specification2 || '' %>" data-specification3="<%= player.specification3 || '' %>" data-tshirtsize="<%= player.tshirtSize || '' %>" data-jerseyname="<%= player.jerseyName || '' %>" data-jerseynumber="<%= player.jerseyNumber || '' %>" data-trousersize="<%= player.trouserSize || '' %>" data-detail="<%= player.detail || '' %>" style="background: rgba(59, 130, 246, 0.12); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.2); padding: 0.3rem 0.55rem; border-radius: 6px; font-size: 0.75rem; font-weight: 600; cursor: pointer; transition: all 0.2s; margin-right: 0.25rem;" title="Edit Player Details">✏️ Edit</button>
                                                             <button onclick="deletePlayer('<%= player.id %>')" class="btn btn-danger" style="padding: 0.3rem 0.55rem; font-size: 0.75rem; font-weight: 600; border-radius: 6px;" title="Delete Player Completely">🗑️ Delete</button>
                                                         </td>
                                                     </tr>
                                                 <% }) %>
                                             </tbody>
                                         </table>
                                     </div>
                                 </div>

                                 <!-- Bulk Player Photo Upload Card -->
                                 <div class="panel" style="background: rgba(15, 23, 42, 0.3); padding: 1.25rem; border-radius: 12px;">
                                     <h3 style="margin: 0 0 1rem 0; font-size: 1rem; color: var(--primary); font-weight: 800; text-transform: uppercase;">📸 Bulk Player Photo Upload</h3>
                                     
                                     <!-- Step 1: Select Upload Source -->
                                     <div style="display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1rem; text-align: left;">
                                         <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700;">1. Select Upload Source:</label>
                                         <div style="display: flex; gap: 0.35rem; flex-wrap: wrap;">
                                             <button type="button" class="btn bulk-source-btn active" id="btnSourceExcel" onclick="switchBulkPhotoSource('excel')" style="flex: 1; padding: 0.45rem; font-size: 0.72rem; font-weight: bold; background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 6px;">📄 Excel</button>
                                             <button type="button" class="btn bulk-source-btn" id="btnSourceFolder" onclick="switchBulkPhotoSource('folder')" style="flex: 1; padding: 0.45rem; font-size: 0.72rem; font-weight: bold; background: rgba(255, 255, 255, 0.02); color: var(--text-muted); border: 1px solid rgba(255, 255, 255, 0.04); border-radius: 6px;">📁 Folder</button>
                                             <button type="button" class="btn bulk-source-btn" id="btnSourceGdrive" onclick="switchBulkPhotoSource('gdrive')" style="flex: 1; padding: 0.45rem; font-size: 0.72rem; font-weight: bold; background: rgba(255, 255, 255, 0.02); color: var(--text-muted); border: 1px solid rgba(255, 255, 255, 0.04); border-radius: 6px;">☁️ GDrive</button>
                                         </div>
                                     </div>

                                     <!-- Inputs container based on source -->
                                     <div id="bulkSourceInputs" style="margin-bottom: 1rem; text-align: left;">
                                         <!-- Excel Input -->
                                         <div id="inputGroupExcel" class="bulk-input-group" style="display: block;">
                                             <label style="color: var(--text-muted); font-size: 0.72rem; display: block; margin-bottom: 0.35rem; line-height: 1.4;">
                                                 Upload spreadsheet (.xlsx, .xls, .csv). Supported columns: <strong>Player ID</strong>, <strong>Form Number</strong>, <strong>Player Name</strong>, and <strong>Photo URL</strong>.
                                             </label>
                                             <input type="file" id="bulkExcelFileInput" accept=".xlsx, .xls, .csv" class="form-control" style="font-size: 0.75rem; background: var(--bg-dark); border: 1px solid var(--border-color); padding: 0.35rem !important; border-radius: 8px !important;">
                                         </div>

                                         <!-- Local Folder Input -->
                                         <div id="inputGroupFolder" class="bulk-input-group" style="display: none;">
                                             <label style="color: var(--text-muted); font-size: 0.72rem; display: block; margin-bottom: 0.35rem; line-height: 1.4;">
                                                 Select folder of images. Filenames should match Player ID, Form Number, Player Number, or Player Name.
                                             </label>
                                             <input type="file" id="bulkFolderFileInput" webkitdirectory directory multiple class="form-control" style="font-size: 0.75rem; background: var(--bg-dark); border: 1px solid var(--border-color); padding: 0.35rem !important; border-radius: 8px !important;">
                                         </div>

                                         <!-- Google Drive Input -->
                                         <div id="inputGroupGdrive" class="bulk-input-group" style="display: none;">
                                             <label style="color: var(--text-muted); font-size: 0.72rem; display: block; margin-bottom: 0.35rem; line-height: 1.4;">
                                                 Paste a public Google Drive file or folder link. Images will be automatically fetched, matched, and assigned.
                                             </label>
                                             <input type="text" id="bulkGDriveLinkInput" placeholder="Paste Google Drive Link" class="form-control" style="border-radius: 8px !important;">
                                         </div>
                                     </div>

                                     <!-- Step 2: Upload & Sync button -->
                                     <button type="button" id="bulkSyncBtn" onclick="executeBulkPhotoUpload()" class="btn btn-success" style="width: 100%; padding: 0.65rem; font-size: 0.8rem; border-radius: 8px;">
                                         ⚡ Upload & Sync
                                     </button>

                                     <!-- Progress / Result Summary Display -->
                                     <div id="bulkSyncStatusContainer" style="display: none; margin-top: 0.85rem; background: rgba(7, 11, 20, 0.4); border-radius: 8px; border: 1px solid var(--border-color); padding: 0.75rem; flex-direction: column; gap: 0.5rem; text-align: left;">
                                         <div style="display: flex; justify-content: space-between; align-items: center;">
                                             <span id="bulkStatusTitle" style="font-weight: bold; font-size: 0.75rem; color: #f8fafc;">Syncing...</span>
                                             <span id="bulkStatusCount" style="font-family: monospace; font-size: 0.72rem; color: var(--text-muted);">0/0</span>
                                         </div>
                                         <div style="width: 100%; height: 4px; background: rgba(255,255,255,0.06); border-radius: 2px; overflow: hidden;">
                                             <div id="bulkStatusProgressBar" style="width: 0%; height: 100%; background: var(--success); transition: width 0.1s ease;"></div>
                                         </div>
                                         
                                         <!-- Summary Report Section -->
                                         <div id="bulkSummaryReport" style="display: none; flex-direction: column; gap: 0.3rem; font-size: 0.75rem; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 0.5rem;">
                                             <div style="font-weight: bold; color: var(--success); margin-bottom: 0.15rem; font-size: 0.78rem;">Import Completed Successfully</div>
                                             <div style="display: flex; justify-content: space-between;"><span style="color: var(--text-muted);">Total Photos:</span><span id="sumTotal" style="font-weight: bold; color: #f8fafc;">0</span></div>
                                             <div style="display: flex; justify-content: space-between;"><span style="color: var(--text-muted);">Successfully Assigned:</span><span id="sumAssigned" style="font-weight: bold; color: var(--success);">0</span></div>
                                             <div style="display: flex; justify-content: space-between;"><span style="color: var(--text-muted);">Skipped:</span><span id="sumSkipped" style="font-weight: bold; color: var(--warning);">0</span></div>
                                             <div style="display: flex; justify-content: space-between;"><span style="color: var(--text-muted);">Failed:</span><span id="sumFailed" style="font-weight: bold; color: var(--danger);">0</span></div>
                                             <div style="margin: 0.25rem 0; border-top: 1px dashed rgba(255,255,255,0.03);"></div>
                                             <div style="display: flex; justify-content: space-between;"><span style="color: var(--text-muted);">Matched by ID/Form/Number:</span><span id="sumById" style="color: #cbd5e1;">0</span></div>
                                             <div style="display: flex; justify-content: space-between;"><span style="color: var(--text-muted);">Matched by Name:</span><span id="sumByName" style="color: #cbd5e1;">0</span></div>
                                             
                                             <!-- Unmatched List -->
                                             <div id="unmatchedListContainer" style="display: none; margin-top: 0.35rem; font-size: 0.68rem; background: rgba(239, 68, 68, 0.04); border: 1px solid rgba(239, 68, 68, 0.1); padding: 0.35rem; border-radius: 4px; max-height: 80px; overflow-y: auto;">
                                                 <div style="color: #f87171; font-weight: bold; margin-bottom: 0.1rem;">Unmatched Photos:</div>
                                                 <ul id="unmatchedList" style="margin: 0; padding-left: 0.85rem; color: #fca5a5; line-height: 1.2;"></ul>
                                             </div>
                                         </div>
                                     </div>
                                 </div>
                             </div>
                         </div>
                     </div>

                     <!-- TAB 3: ADD AUCTION -->
                     <div id="modalTabAuction" class="modal-tab-content" style="display: none;">
                         <!-- Inner Auction Tabs Header -->
                         <div style="display: flex; gap: 0.4rem; border-bottom: 1px solid rgba(255,255,255,0.06); margin-bottom: 1.25rem; padding-bottom: 0px;">
                             <button type="button" id="innerTabBtnForm" onclick="switchInnerAuctionTab('form')" class="modal-tab-btn active">➕ Create / Edit Auction</button>
                             <button type="button" id="innerTabBtnList" onclick="switchInnerAuctionTab('list')" class="modal-tab-btn">📦 Created Auctions (<%= data.auctionsList ? data.auctionsList.length : 0 %>)</button>
                         </div>

                         <!-- INNER TAB 1: FORM -->
                         <div id="innerTabAuctionForm" style="display: block;">
                             <form id="updateAuctionForm" enctype="multipart/form-data" class="stacked-form" style="max-width: 600px; margin: 0 auto; gap: 1rem;">
                                 <input type="hidden" name="auctionId" id="editAuctionIdInput" value="">
                                 <input type="hidden" name="submitAction" id="auctionSubmitActionInput" value="create">
                                 
                                 <!-- Auction Logo Picker -->
                                 <div style="display: flex; gap: 1.25rem; align-items: center; text-align: left;">
                                     <label style="font-weight: 700; color: var(--text-muted); width: 130px; font-size: 0.78rem; text-transform: uppercase;">Auction Logo</label>
                                     <div style="display: flex; gap: 0.85rem; align-items: center;">
                                         <div style="width: 72px; height: 72px; border-radius: 8px; border: 2px dashed rgba(255,255,255,0.12); background: rgba(15, 23, 42, 0.3); display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative;">
                                             <img id="auctionLogoPreview" src="/uploads/default-auction.svg" style="max-width: 100%; max-height: 100%; object-fit: contain;" onerror="this.src='/uploads/default-auction.svg'">
                                         </div>
                                         <div style="position: relative; overflow: hidden; display: inline-block;">
                                             <button type="button" class="btn btn-secondary" style="font-size: 0.75rem; padding: 0.4rem 0.85rem; border-radius: 6px; pointer-events: none;">CHOOSE FILE</button>
                                             <input type="file" name="logo" accept="image/*" onchange="previewAuctionLogo(this)" style="position: absolute; left: 0; top: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;">
                                         </div>
                                     </div>
                                 </div>

                                 <!-- Sponsor / Owner Logo Picker (Shows on Live Dashboard) -->
                                 <div style="display: flex; gap: 1.25rem; align-items: center; text-align: left; padding: 0.75rem 0; border-top: 1px dashed rgba(255,255,255,0.08); border-bottom: 1px dashed rgba(255,255,255,0.08);">
                                     <div style="display: flex; flex-direction: column; width: 130px;">
                                         <label style="font-weight: 700; color: #fbbf24; font-size: 0.78rem; text-transform: uppercase;">Sponsor Logo</label>
                                         <span style="font-size: 0.62rem; color: rgba(255,255,255,0.4);">Shows on Live Screen</span>
                                     </div>
                                     <div style="display: flex; gap: 0.85rem; align-items: center; flex: 1;">
                                         <div style="width: 72px; height: 72px; border-radius: 8px; border: 2px dashed rgba(251,191,36,0.35); background: rgba(15, 23, 42, 0.4); display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative;">
                                             <img id="sponsorLogoPreview" src="<%= (data.auctionDetails && data.auctionDetails.sponsorLogo) ? data.auctionDetails.sponsorLogo : '/uploads/default-auction.svg' %>" style="max-width: 100%; max-height: 100%; object-fit: contain;" onerror="this.src='/uploads/default-auction.svg'">
                                         </div>
                                         <div style="position: relative; overflow: hidden; display: inline-block;">
                                             <button type="button" class="btn btn-secondary" style="font-size: 0.75rem; padding: 0.4rem 0.85rem; border-radius: 6px; pointer-events: none; border-color: rgba(251,191,36,0.3); color: #fbbf24;">CHOOSE SPONSOR LOGO</button>
                                             <input type="file" name="sponsorLogo" accept="image/*" onchange="previewSponsorLogo(this)" style="position: absolute; left: 0; top: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;">
                                         </div>
                                     </div>
                                 </div>

                                 <!-- Sponsor / Owner Name Row -->
                                 <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem; text-align: left;">
                                     <label style="font-weight: 700; color: #fbbf24; font-size: 0.78rem; text-transform: uppercase;">Sponsor / Presenter Name (Owner)</label>
                                     <input type="text" name="sponsorName" id="editSponsorName" class="form-control" placeholder="e.g. TATA / Owner Name" value="<%= (data.auctionDetails && data.auctionDetails.sponsorName) ? data.auctionDetails.sponsorName : '' %>" style="border-radius: 8px !important;">
                                 </div>

                                 <!-- Sports Type & Season Row -->
                                 <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; text-align: left;">
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Sports Type*</label>
                                         <select name="sportsType" id="editSportsType" required class="form-control" style="border-radius: 8px !important;">
                                             <option value="Cricket" selected>Cricket</option>
                                             <option value="Football">Football</option>
                                             <option value="Kabaddi">Kabaddi</option>
                                             <option value="Basketball">Basketball</option>
                                             <option value="Other">Other</option>
                                         </select>
                                     </div>
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Season</label>
                                         <select name="season" id="editSeason" class="form-control" style="border-radius: 8px !important;">
                                             <option value="2026" selected>2026</option>
                                             <option value="2025">2025</option>
                                             <option value="2024">2024</option>
                                             <option value="2023">2023</option>
                                         </select>
                                     </div>
                                 </div>

                                 <!-- Auction Name Row -->
                                 <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem; text-align: left;">
                                     <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Auction Name*</label>
                                     <input type="text" name="name" id="editAuctionName" required class="form-control" placeholder="IPL Mega Auction 2026" style="border-radius: 8px !important;">
                                 </div>

                                 <!-- Auction Date & Time Row -->
                                 <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; text-align: left;">
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Auction Date*</label>
                                         <input type="date" name="auctionDate" id="editAuctionDate" required class="form-control" style="color-scheme: dark; border-radius: 8px !important;">
                                     </div>
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Auction Time</label>
                                         <input type="time" name="auctionTime" id="editAuctionTime" class="form-control" style="color-scheme: dark; border-radius: 8px !important;">
                                     </div>
                                 </div>

                                 <!-- Points Per Team & Units Row -->
                                 <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; text-align: left;">
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Purse Points Per Team*</label>
                                         <input type="number" name="pointsPerTeam" id="editPointsPerTeam" required class="form-control" value="100000" style="border-radius: 8px !important;">
                                     </div>
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Purse Units (Symbol)</label>
                                         <input type="text" name="units" id="editUnits" class="form-control" placeholder="e.g. ₹, $, CR/LAC" value="CR/LAC" style="border-radius: 8px !important;">
                                     </div>
                                 </div>

                                 <!-- Base Bid & Bid Increase by Stacked -->
                                 <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; text-align: left;">
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Default Base Bid*</label>
                                         <input type="number" step="any" name="baseBid" id="editBaseBid" required class="form-control" value="1000.00" style="border-radius: 8px !important;">
                                     </div>
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Default Bid Increments*</label>
                                         <input type="number" step="any" name="bidIncreaseBy" id="editBidIncreaseBy" required class="form-control" value="500.00" style="border-radius: 8px !important;">
                                     </div>
                                 </div>

                                 <!-- Player Per Team Limits -->
                                 <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; text-align: left;">
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Player Count / Team (Max)*</label>
                                         <input type="number" name="playersPerTeamMax" id="editPlayersMax" required class="form-control" value="16" style="border-radius: 8px !important;">
                                     </div>
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Player Count / Team (Min)</label>
                                         <input type="number" name="playersPerTeamMin" id="editPlayersMin" class="form-control" value="0" style="border-radius: 8px !important;">
                                     </div>
                                 </div>

                                 <!-- Submit Button Row -->
                                 <div style="margin-top: 0.75rem; display: flex; gap: 0.75rem; justify-content: flex-start;">
                                     <button type="submit" onclick="document.getElementById('auctionSubmitActionInput').value='create'" class="btn btn-success" style="padding: 0.65rem 1.75rem; font-size: 0.85rem; border-radius: 8px;">➕ Create Event</button>
                                     <button type="submit" id="saveAuctionChangesBtn" onclick="document.getElementById('auctionSubmitActionInput').value='update'" class="btn btn-primary" style="display: none; padding: 0.65rem 1.75rem; font-size: 0.85rem; border-radius: 8px;">💾 Save Event</button>
                                     <button type="button" id="cancelAuctionEditBtn" onclick="resetAuctionForm()" class="btn btn-secondary" style="padding: 0.65rem 1.25rem; font-size: 0.85rem; border-radius: 8px;">Cancel</button>
                                 </div>
                             </form>
                         </div>
                         
                         <!-- INNER TAB 2: CREATED AUCTIONS LIST BOX FORMAT -->
                         <div id="innerTabAuctionList" style="display: none;">
                             <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem;">
                                 <% if (data.auctionsList && data.auctionsList.length > 0) { %>
                                     <% data.auctionsList.forEach((auc, i) => { %>
                                         <% const isCurrent = auc.id === (data.auctionDetails ? data.auctionDetails.id : 'active_auction'); %>
                                         <div class="panel auction-card-box <%= isCurrent ? 'active-auction-box' : '' %>" style="text-align: left; border-radius: 12px; padding: 1.15rem; background: rgba(15, 23, 42, 0.35);">
                                             <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
                                                 <span style="background: rgba(59,130,246,0.1); color: var(--accent); font-size: 0.7rem; padding: 0.2rem 0.5rem; border-radius: 5px; font-weight: bold; border: 1px solid rgba(59,130,246,0.15);"><%= auc.sportsType || 'Cricket' %></span>
                                                 <span style="color: var(--text-muted); font-size: 0.72rem; font-weight: 700;"><%= auc.season || '2026' %></span>
                                             </div>
                                             <h4 style="color: #fff; font-size: 0.95rem; margin: 0 0 0.5rem 0; font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= auc.name || 'Unnamed Auction' %></h4>
                                             <div style="color: var(--text-muted); font-size: 0.76rem; margin-bottom: 1rem; display: flex; flex-direction: column; gap: 0.2rem;">
                                                 <div>📅 Date: <%= auc.auctionDate || 'N/A' %> <%= auc.auctionTime || '' %></div>
                                                 <div>💰 Purse: <%= auc.pointsPerTeam || 0 %> <%= auc.units || '' %></div>
                                             </div>
                                             <div style="display: flex; gap: 0.4rem; border-top: 1px solid rgba(255,255,255,0.04); padding-top: 0.75rem;">
                                                 <button type="button" class="btn select-auction-btn" data-id="<%= auc.id %>" style="flex: 1.3; padding: 0.4rem; font-size: 0.75rem; background: rgba(34, 197, 94, 0.1) !important; border: 1px solid rgba(34, 197, 94, 0.2) !important; color: var(--success); font-weight: bold; border-radius: 6px;">✅ Choose</button>
                                                 <button type="button" class="btn edit-auction-btn" data-id="<%= auc.id %>" data-name="<%= auc.name %>" data-sport="<%= auc.sportsType %>" data-season="<%= auc.season %>" data-date="<%= auc.auctionDate %>" data-time="<%= auc.auctionTime %>" data-purse="<%= auc.pointsPerTeam %>" data-units="<%= auc.units %>" data-base="<%= auc.baseBid %>" data-inc="<%= auc.bidIncreaseBy %>" data-max="<%= auc.playersPerTeamMax %>" data-min="<%= auc.playersPerTeamMin %>" style="flex: 1; padding: 0.4rem; font-size: 0.75rem; background: rgba(59, 130, 246, 0.1) !important; border: 1px solid rgba(59, 130, 246, 0.2) !important; color: #60a5fa; font-weight: bold; border-radius: 6px;">✏️ Edit</button>
                                                 <button type="button" onclick="deleteAuctionBox('<%= auc.id %>')" class="btn btn-danger" style="flex: 1; padding: 0.4rem; font-size: 0.75rem; border-radius: 6px;">🗑️ Delete</button>
                                             </div>
                                         </div>
                                     <% }) %>
                                 <% } else { %>
                                     <div style="color: var(--text-muted); font-size: 0.8rem; font-style: italic;">No auctions created yet.</div>
                                 <% } %>
                             </div>
                         </div>
                         
                         <style>
                             .auction-card-box { border: 1px solid var(--border-color); }
                             .auction-card-box.active-auction-box { border: 1.5px solid var(--primary); box-shadow: var(--glow-gold); }
                         </style>

                         <script>
                             function switchInnerAuctionTab(tab) {
                                 localStorage.setItem('keepInnerAuctionTab', tab);
                                 if (tab === 'form') {
                                     document.getElementById('innerTabAuctionForm').style.display = 'block';
                                     document.getElementById('innerTabAuctionList').style.display = 'none';
                                     document.getElementById('innerTabBtnForm').classList.add('active');
                                     document.getElementById('innerTabBtnList').classList.remove('active');
                                 } else {
                                     document.getElementById('innerTabAuctionForm').style.display = 'none';
                                     document.getElementById('innerTabAuctionList').style.display = 'block';
                                     document.getElementById('innerTabBtnForm').classList.remove('active');
                                     document.getElementById('innerTabBtnList').classList.add('active');
                                 }
                             }

                             function resetAuctionForm() {
                                 document.getElementById('updateAuctionForm').reset();
                                 document.getElementById('editAuctionIdInput').value = '';
                                 document.getElementById('auctionSubmitActionInput').value = 'create';
                                 document.getElementById('saveAuctionChangesBtn').style.display = 'none';
                             }

                             function loadAuctionIntoForm(id, name, type, season, date, time, pts, units, base, inc, max, min) {
                                 document.getElementById('editAuctionIdInput').value = id;
                                 document.getElementById('editAuctionName').value = name || '';
                                 document.getElementById('editSportsType').value = type || 'Cricket';
                                 document.getElementById('editSeason').value = season || '2026';
                                 document.getElementById('editAuctionDate').value = date || '';
                                 document.getElementById('editAuctionTime').value = time || '';
                                 document.getElementById('editPointsPerTeam').value = pts || 100000;
                                 document.getElementById('editUnits').value = units || 'CR/LAC';
                                 document.getElementById('editBaseBid').value = base || 1000;
                                 document.getElementById('editBidIncreaseBy').value = inc || 500;
                                 document.getElementById('editPlayersMax').value = max || 16;
                                 document.getElementById('editPlayersMin').value = min || 0;
                                 
                                 document.getElementById('auctionSubmitActionInput').value = 'update';
                                 document.getElementById('saveAuctionChangesBtn').style.display = 'inline-block';
                                 
                                 switchInnerAuctionTab('form');
                             }

                             async function deleteAuctionBox(id) {
                                 if (id === 'active_auction') {
                                     return alert('⚠️ The main default auction cannot be deleted!');
                                 }
                                 if (!confirm('🗑️ Are you sure you want to permanently delete this auction event?')) return;
                                 
                                 const res = await fetch('/admin/delete-auction-details', {
                                     method: 'POST',
                                     headers: { 'Content-Type': 'application/json' },
                                     body: JSON.stringify({ auctionId: id })
                                 });
                                 const result = await res.json();
                                 if (result.success) {
                                     localStorage.setItem('keepDataModalOpen', 'true');
                                     localStorage.setItem('keepDataModalTab', 'auction');
                                     localStorage.setItem('keepInnerAuctionTab', 'list');
                                     location.reload();
                                 } else {
                                     alert('Error: ' + result.error);
                                 }
                             }

                             document.addEventListener('click', function(e) {
                                 const editBtn = e.target.closest('.edit-auction-btn');
                                 if (editBtn) {
                                     const d = editBtn.dataset;
                                     loadAuctionIntoForm(d.id, d.name, d.sport, d.season, d.date, d.time, d.purse, d.units, d.base, d.inc, d.max, d.min);
                                 }
                             });

                             setTimeout(() => {
                                 const innerTab = localStorage.getItem('keepInnerAuctionTab');
                                 if (innerTab) switchInnerAuctionTab(innerTab);
                             }, 100);
                         </script>
                     </div>
                     
                     <script>
                         function previewAuctionLogo(input) {
                             if (input.files && input.files[0]) {
                                 const reader = new FileReader();
                                 reader.onload = function(e) {
                                     document.getElementById('auctionLogoPreview').src = e.target.result;
                                 }
                                 reader.readAsDataURL(input.files[0]);
                             }
                         }
