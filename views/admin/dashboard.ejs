    <script>
        function openAdminSponsorModal() {
            const modal = document.getElementById('adminSponsorModal');
            if (modal) modal.style.display = 'flex';
        }

        function closeAdminSponsorModal() {
            const modal = document.getElementById('adminSponsorModal');
            if (modal) modal.style.display = 'none';
        }

        function previewAdminSeparateSponsor(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.getElementById('adminSeparateSponsorPreviewImg');
                    if (img) img.src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        async function handleAdminSponsorSubmit(e) {
            e.preventDefault();
            const saveBtn = document.getElementById('adminSponsorSaveBtn');
            if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = 'Saving...'; }
            
            const form = document.getElementById('adminSeparateSponsorForm');
            const formData = new FormData(form);

            try {
                const res = await fetch('/admin/update-sponsor', {
                    method: 'POST',
                    body: formData
                });
                const result = await res.json();
                if (result.success) {
                    if (typeof showToast === 'function') {
                        showToast('⚡ Sponsor Logo & Owner details updated live!', 'success');
                    } else {
                        alert('Sponsor Logo & Owner details updated live!');
                    }
                    closeAdminSponsorModal();
                    setTimeout(() => window.location.reload(), 600);
                } else {
                    alert('Error: ' + (result.error || 'Failed to update sponsor'));
                }
            } catch (err) {
                console.error(err);
                alert('Network error updating sponsor: ' + err.message);
            } finally {
                if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = '💾 Save & Apply Live'; }
            }
        }

        async function removeAdminSponsorLogo() {
            if (!confirm('Are you sure you want to remove the Sponsor Logo?')) return;
            const formData = new FormData();
            formData.append('removeLogo', 'true');
            formData.append('sponsorName', document.getElementById('adminSeparateSponsorNameInput').value || '');

            try {
                const res = await fetch('/admin/update-sponsor', {
                    method: 'POST',
                    body: formData
                });
                const result = await res.json();
                if (result.success) {
                    document.getElementById('adminSeparateSponsorPreviewImg').src = '/uploads/default-auction.svg';
                    if (typeof showToast === 'function') {
                        showToast('Sponsor logo removed.', 'info');
                    }
                    closeAdminSponsorModal();
                    setTimeout(() => window.location.reload(), 600);
                }
            } catch (err) {
                console.error(err);
                alert('Error removing sponsor logo: ' + err.message);
            }
        }
    
