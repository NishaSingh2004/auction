                                                 <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700;">Profile Pic:</label>
                                                 <div style="display: flex; align-items: center; gap: 0.6rem; background: var(--bg-dark); padding: 0.5rem; border-radius: 8px; border: 1px solid var(--border-color);">
                                                     <div style="width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid rgba(255,255,255,0.08); overflow: hidden; background: #04060f; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                                                         <img id="playerPhotoPreview" src="/uploads/default-player.svg" style="width: 100%; height: 100%; object-fit: cover;">
                                                     </div>
                                                     <div style="flex: 1; overflow: hidden;">
                                                         <input type="file" name="photo" id="playerPhotoInput" accept="image/*" style="font-size: 0.7rem; color: var(--text-muted); border: none; background: transparent; padding: 0; width: 100%;" onchange="if (this.files[0]) { document.getElementById('playerPhotoPreview').src = URL.createObjectURL(this.files[0]); }">
