                msg.style.cssText = 'color: rgba(255,255,255,0.5); text-align: center; margin-top: 20vh; font-size: 1.2rem; font-weight: 800;';
                msg.innerHTML = '🚫 NO SECTIONS ASSIGNED.<br><span style="font-size:0.9rem;font-weight:400;">Please ask the Superadmin to grant you access.</span>';
                mainWrapper.appendChild(msg);
            }
        }
    });
</script>

