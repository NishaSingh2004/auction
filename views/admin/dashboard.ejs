                                                 <input type="text" name="trouserSize" placeholder="S/M/L/XL/..." class="form-control" style="padding: 0.45rem 0.7rem !important; border-radius: 8px !important;">
                                             </div>
                                         </div>

                                         <!-- Eighth Row: Detail -->
                                         <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                             <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 500;">Detail:</label>
                                             <textarea name="detail" placeholder="Detail" rows="2" class="form-control" style="padding: 0.45rem 0.7rem !important; border-radius: 8px !important; resize: vertical;"></textarea>
                                         </div>
                                         
                                         <!-- Category Selection -->
                                         <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                             <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700;">Category:</label>
                                             <select name="category_id" class="form-control" style="padding: 0.45rem 0.7rem !important; border-radius: 8px !important;">
                                                 <% data.categories.forEach(cat => { %>
                                                     <option value="<%= cat.id %>"><%= cat.name %> (Max: <%= cat.maxPlayers %>)</option>
                                                 <% }) %>
                                             </select>
                                         </div>

                                         <!-- Ninth Row: Base Value -->
                                         <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                             <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700;">Base Price *:</label>
                                             <input type="number" name="basePrice" placeholder="Base Price" required class="form-control" style="padding: 0.45rem 0.7rem !important; border-radius: 8px !important;">
                                             <span style="font-size: 0.68rem; color: var(--text-muted); margin-top: 0.1rem;">(If different from Minimum Base or Category Base Value)</span>
                                         </div>

                                         <!-- Action Buttons -->
                                         <div style="display: flex; gap: 0.5rem; margin-top: 1rem;">
                                             <button type="submit" id="saveNewPlayerBtn" onclick="document.getElementById('playerSubmitAction').value='add_and_new'" class="btn btn-primary" style="flex: 1.2; padding: 0.55rem; font-size: 0.8rem;">SAVE & NEW</button>
                                             <button type="submit" id="addPlayerBtn" onclick="document.getElementById('playerSubmitAction').value='add'" class="btn btn-secondary" style="flex: 1; padding: 0.55rem; font-size: 0.8rem;">SAVE</button>
                                         </div>
                                     </form>
                                 </div>

                                 <!-- CSV / Excel Upload Card -->
                                 <div class="panel" style="background: rgba(15, 23, 42, 0.3); padding: 1.25rem; border-radius: 12px;">
                                     <h3 style="margin: 0 0 0.85rem 0; font-size: 0.95rem; color: var(--primary); font-weight: 800; text-transform: uppercase;">📥 CSV / Excel Bulk Import</h3>
                                     <form id="uploadCsvForm" class="stacked-form">
                                         <label style="color: var(--text-muted); font-size: 0.75rem; line-height: 1.4;">Upload a spreadsheet CSV or Excel (.xlsx, .xls) file. Columns: <strong>Name, BasePrice, Role</strong></label>
                                         <div style="display: flex; gap: 0.4rem; align-items: center; margin-top: 0.4rem;">
                                             <input type="file" name="csvFile" accept=".csv, .xlsx, .xls" required class="form-control" style="font-size: 0.75rem; background: var(--bg-dark); border: 1px solid var(--border-color); padding: 0.35rem !important; border-radius: 8px !important;">
                                             <button type="submit" class="btn btn-primary" style="padding: 0.55rem 1.15rem; font-size: 0.8rem; font-weight: 800; white-space: nowrap; border-radius: 8px;">Upload</button>
                                         </div>
                                     </form>
                                 </div>
                             </div>

                             <!-- Right Column (Directory & Bulk Photo Upload) -->
                             <div style="display: flex; flex-direction: column; gap: 1.25rem;">

                                 <!-- Players Table -->
                                 <div class="panel" style="background: rgba(15, 23, 42, 0.3); padding: 1.25rem; border-radius: 12px;">
                                     <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.85rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">
                                         <h3 style="margin: 0; font-size: 1rem; color: var(--primary); font-weight: 800; text-transform: uppercase;">📋 Registered Players Directory</h3>
                                         <button id="bulkUnsoldBtn" onclick="bulkUnsoldSelectedPlayers()" class="btn" style="background: rgba(245, 158, 11, 0.15); color: #fb923c; border: 1px solid rgba(245, 158, 11, 0.25); padding: 0.35rem 0.85rem; border-radius: 6px; font-weight: bold; font-size: 0.75rem; cursor: pointer;" disabled>
                                             ↩️ Bulk Unsold (0 Selected)
                                         </button>
                                     </div>
                                     <div style="max-height: 52vh; overflow-y: auto;">
                                         <table class="data-table" id="playersTable">
                                             <thead>
                                                 <tr>
                                                     <th style="width: 36px; text-align: center;"><input type="checkbox" id="selectAllPlayers" onchange="toggleSelectAllPlayers(this)"></th>
                                                     <th style="font-size: 0.72rem !important;">PLAYER NUMBER</th>
                                                     <th style="font-size: 0.72rem !important;">PLAYER NAME</th>
                                                     <th style="font-size: 0.72rem !important;">CATEGORY</th>
                                                     <th style="font-size: 0.72rem !important;">PLAYING ROLE</th>
                                                     <th style="text-align: right; font-size: 0.72rem !important;">STATUS</th>
                                                     <th style="text-align: right; font-size: 0.72rem !important;">ACTIONS</th>
                                                 </tr>
                                             </thead>
                                             <tbody>
                                                 <% data.players.sort((a, b) => a.name.localeCompare(b.name)).forEach(player => { %>
                                                     <% 
                                                         const cat = data.categories ? data.categories.find(c => c.id === player.category_id) : null;
                                                         const catName = cat ? cat.name : 'OPEN';
                                                     %>
                                                     <tr style="font-size: 0.85rem;">
                                                         <td style="text-align: center; vertical-align: top; padding: 0.65rem 0.5rem !important;">
                                                             <% if (player.status === 'sold') { %>
                                                                 <input type="checkbox" class="player-select-checkbox" data-id="<%= player.id %>" onchange="updateBulkBtnState()">
                                                             <% } else { %>
                                                                 <input type="checkbox" disabled style="opacity: 0.25;">
                                                             <% } %>
                                                         </td>
                                                         <td style="font-family: monospace; font-weight: bold; vertical-align: top; color: var(--accent); padding: 0.65rem 0.5rem !important;">
                                                             #<%= player.formNo || 'N/A' %>
                                                         </td>
                                                         <td style="font-weight: 700; vertical-align: top; text-align: left; padding: 0.65rem 0.5rem !important;">
                                                             <%= player.name %>
                                                             <% if (player.detail) { %>
                                                                 <div style="font-size: 0.7rem; font-weight: normal; color: var(--text-muted); margin-top: 0.25rem; white-space: pre-wrap; line-height: 1.3; background: rgba(0,0,0,0.2); padding: 0.3rem 0.5rem; border-radius: 6px; border: 1px solid var(--border-color); font-family: monospace; max-width: 400px; max-height: 70px; overflow-y: auto; text-align: left;"><%= player.detail %></div>
                                                             <% } %>
                                                         </td>
                                                         <td style="color: var(--text-muted); vertical-align: top; text-align: left; padding: 0.65rem 0.5rem !important;"><%= catName %></td>
                                                         <td style="color: var(--text-muted); vertical-align: top; text-align: left; padding: 0.65rem 0.5rem !important;"><%= player.role %></td>
                                                         <td style="text-align: right; vertical-align: top; padding: 0.65rem 0.5rem !important;">
                                                             <span class="badge badge-<%= player.status %>" style="font-size: 0.65rem !important; padding: 0.15rem 0.4rem !important;"><%= player.status.toUpperCase() %></span>
                                                         </td>
                                                          <td style="text-align: right; vertical-align: top; padding: 0.65rem 0.5rem !important;" onclick="event.stopPropagation();">
                                                              <% if (player.status === 'sold') { %>
                                                                  <button onclick="markPlayerUnsold('<%= player.id %>')" class="btn" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.2); padding: 0.3rem 0.55rem; border-radius: 6px; font-size: 0.75rem; font-weight: 600; cursor: pointer; transition: all 0.2s; margin-right: 0.25rem;" title="Revert player to Unsold status">↩️ Unsold</button>
                                                              <% } %>
                                                              <button class="btn edit-player-btn" data-id="<%= player.id %>" data-name="<%= player.name %>" data-role="<%= player.role %>" data-baseprice="<%= player.basePrice %>" data-phone="<%= player.phone || '' %>" data-photo="<%= player.photo || '' %>" data-formno="<%= player.formNo || '' %>" data-age="<%= player.age || '' %>" data-fathername="<%= player.fatherName || '' %>" data-tagowner="<%= player.tagOwner || '' %>" data-customtag="<%= player.customTag || '' %>" data-specification1="<%= player.specification1 || '' %>" data-specification2="<%= player.specification2 || '' %>" data-specification3="<%= player.specification3 || '' %>" data-tshirtsize="<%= player.tshirtSize || '' %>" data-jerseyname="<%= player.jerseyName || '' %>" data-jerseynumber="<%= player.jerseyNumber || '' %>" data-trousersize="<%= player.trouserSize || '' %>" data-detail="<%= player.detail || '' %>" style="background: rgba(59, 130, 246, 0.12); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.2); padding: 0.3rem 0.55rem; border-radius: 6px; font-size: 0.75rem; font-weight: 600; cursor: pointer; transition: all 0.2s; margin-right: 0.25rem;" title="Edit Player Details">✏️ Edit</button>
                                                             <button onclick="deletePlayer('<%= player.id %>')" class="btn btn-danger" style="padding: 0.3rem 0.55rem; font-size: 0.75rem; font-weight: 600; border-radius: 6px;" title="Delete Player Completely">🗑️ Delete</button>
                                                         </td>
                                                     </tr>
                                                 <% }) %>
                                             </tbody>
                                         </table>
                                     </div>
                                 </div>

                                 <!-- Bulk Player Photo Upload Card -->
                                 <div class="panel" style="background: rgba(15, 23, 42, 0.3); padding: 1.25rem; border-radius: 12px;">
                                     <h3 style="margin: 0 0 1rem 0; font-size: 1rem; color: var(--primary); font-weight: 800; text-transform: uppercase;">📸 Bulk Player Photo Upload</h3>
                                     
                                     <!-- Step 1: Select Upload Source -->
                                     <div style="display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1rem; text-align: left;">
                                         <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700;">1. Select Upload Source:</label>
                                         <div style="display: flex; gap: 0.35rem; flex-wrap: wrap;">
                                             <button type="button" class="btn bulk-source-btn active" id="btnSourceExcel" onclick="switchBulkPhotoSource('excel')" style="flex: 1; padding: 0.45rem; font-size: 0.72rem; font-weight: bold; background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 6px;">📄 Excel</button>
                                             <button type="button" class="btn bulk-source-btn" id="btnSourceFolder" onclick="switchBulkPhotoSource('folder')" style="flex: 1; padding: 0.45rem; font-size: 0.72rem; font-weight: bold; background: rgba(255, 255, 255, 0.02); color: var(--text-muted); border: 1px solid rgba(255, 255, 255, 0.04); border-radius: 6px;">📁 Folder</button>
                                             <button type="button" class="btn bulk-source-btn" id="btnSourceGdrive" onclick="switchBulkPhotoSource('gdrive')" style="flex: 1; padding: 0.45rem; font-size: 0.72rem; font-weight: bold; background: rgba(255, 255, 255, 0.02); color: var(--text-muted); border: 1px solid rgba(255, 255, 255, 0.04); border-radius: 6px;">☁️ GDrive</button>
                                         </div>
                                     </div>

                                     <!-- Inputs container based on source -->
                                     <div id="bulkSourceInputs" style="margin-bottom: 1rem; text-align: left;">
                                         <!-- Excel Input -->
                                         <div id="inputGroupExcel" class="bulk-input-group" style="display: block;">
                                             <label style="color: var(--text-muted); font-size: 0.72rem; display: block; margin-bottom: 0.35rem; line-height: 1.4;">
                                                 Upload spreadsheet (.xlsx, .xls, .csv). Supported columns: <strong>Player ID</strong>, <strong>Form Number</strong>, <strong>Player Name</strong>, and <strong>Photo URL</strong>.
                                             </label>
                                             <input type="file" id="bulkExcelFileInput" accept=".xlsx, .xls, .csv" class="form-control" style="font-size: 0.75rem; background: var(--bg-dark); border: 1px solid var(--border-color); padding: 0.35rem !important; border-radius: 8px !important;">
                                         </div>

                                         <!-- Local Folder Input -->
                                         <div id="inputGroupFolder" class="bulk-input-group" style="display: none;">
                                             <label style="color: var(--text-muted); font-size: 0.72rem; display: block; margin-bottom: 0.35rem; line-height: 1.4;">
                                                 Select folder of images. Filenames should match Player ID, Form Number, Player Number, or Player Name.
                                             </label>
                                             <input type="file" id="bulkFolderFileInput" webkitdirectory directory multiple class="form-control" style="font-size: 0.75rem; background: var(--bg-dark); border: 1px solid var(--border-color); padding: 0.35rem !important; border-radius: 8px !important;">
                                         </div>

                                         <!-- Google Drive Input -->
                                         <div id="inputGroupGdrive" class="bulk-input-group" style="display: none;">
                                             <label style="color: var(--text-muted); font-size: 0.72rem; display: block; margin-bottom: 0.35rem; line-height: 1.4;">
                                                 Paste a public Google Drive file or folder link. Images will be automatically fetched, matched, and assigned.
                                             </label>
                                             <input type="text" id="bulkGDriveLinkInput" placeholder="Paste Google Drive Link" class="form-control" style="border-radius: 8px !important;">
                                         </div>
                                     </div>

                                     <!-- Step 2: Upload & Sync button -->
                                     <button type="button" id="bulkSyncBtn" onclick="executeBulkPhotoUpload()" class="btn btn-success" style="width: 100%; padding: 0.65rem; font-size: 0.8rem; border-radius: 8px;">
                                         ⚡ Upload & Sync
                                     </button>

                                     <!-- Progress / Result Summary Display -->
                                     <div id="bulkSyncStatusContainer" style="display: none; margin-top: 0.85rem; background: rgba(7, 11, 20, 0.4); border-radius: 8px; border: 1px solid var(--border-color); padding: 0.75rem; flex-direction: column; gap: 0.5rem; text-align: left;">
                                         <div style="display: flex; justify-content: space-between; align-items: center;">
                                             <span id="bulkStatusTitle" style="font-weight: bold; font-size: 0.75rem; color: #f8fafc;">Syncing...</span>
                                             <span id="bulkStatusCount" style="font-family: monospace; font-size: 0.72rem; color: var(--text-muted);">0/0</span>
                                         </div>
                                         <div style="width: 100%; height: 4px; background: rgba(255,255,255,0.06); border-radius: 2px; overflow: hidden;">
                                             <div id="bulkStatusProgressBar" style="width: 0%; height: 100%; background: var(--success); transition: width 0.1s ease;"></div>
                                         </div>
                                         
                                         <!-- Summary Report Section -->
                                         <div id="bulkSummaryReport" style="display: none; flex-direction: column; gap: 0.3rem; font-size: 0.75rem; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 0.5rem;">
                                             <div style="font-weight: bold; color: var(--success); margin-bottom: 0.15rem; font-size: 0.78rem;">Import Completed Successfully</div>
                                             <div style="display: flex; justify-content: space-between;"><span style="color: var(--text-muted);">Total Photos:</span><span id="sumTotal" style="font-weight: bold; color: #f8fafc;">0</span></div>
                                             <div style="display: flex; justify-content: space-between;"><span style="color: var(--text-muted);">Successfully Assigned:</span><span id="sumAssigned" style="font-weight: bold; color: var(--success);">0</span></div>
                                             <div style="display: flex; justify-content: space-between;"><span style="color: var(--text-muted);">Skipped:</span><span id="sumSkipped" style="font-weight: bold; color: var(--warning);">0</span></div>
                                             <div style="display: flex; justify-content: space-between;"><span style="color: var(--text-muted);">Failed:</span><span id="sumFailed" style="font-weight: bold; color: var(--danger);">0</span></div>
                                             <div style="margin: 0.25rem 0; border-top: 1px dashed rgba(255,255,255,0.03);"></div>
                                             <div style="display: flex; justify-content: space-between;"><span style="color: var(--text-muted);">Matched by ID/Form/Number:</span><span id="sumById" style="color: #cbd5e1;">0</span></div>
                                             <div style="display: flex; justify-content: space-between;"><span style="color: var(--text-muted);">Matched by Name:</span><span id="sumByName" style="color: #cbd5e1;">0</span></div>
                                             
                                             <!-- Unmatched List -->
                                             <div id="unmatchedListContainer" style="display: none; margin-top: 0.35rem; font-size: 0.68rem; background: rgba(239, 68, 68, 0.04); border: 1px solid rgba(239, 68, 68, 0.1); padding: 0.35rem; border-radius: 4px; max-height: 80px; overflow-y: auto;">
                                                 <div style="color: #f87171; font-weight: bold; margin-bottom: 0.1rem;">Unmatched Photos:</div>
                                                 <ul id="unmatchedList" style="margin: 0; padding-left: 0.85rem; color: #fca5a5; line-height: 1.2;"></ul>
                                             </div>
                                         </div>
                                     </div>
                                 </div>
                             </div>
                         </div>
                     </div>

                     <!-- TAB 3: ADD AUCTION -->
                     <div id="modalTabAuction" class="modal-tab-content" style="display: none;">
                         <!-- Inner Auction Tabs Header -->
                         <div style="display: flex; gap: 0.4rem; border-bottom: 1px solid rgba(255,255,255,0.06); margin-bottom: 1.25rem; padding-bottom: 0px;">
                             <button type="button" id="innerTabBtnForm" onclick="switchInnerAuctionTab('form')" class="modal-tab-btn active">➕ Create / Edit Auction</button>
                             <button type="button" id="innerTabBtnList" onclick="switchInnerAuctionTab('list')" class="modal-tab-btn">📦 Created Auctions (<%= data.auctionsList ? data.auctionsList.length : 0 %>)</button>
                         </div>

                         <!-- INNER TAB 1: FORM -->
                         <div id="innerTabAuctionForm" style="display: block;">
                             <form id="updateAuctionForm" enctype="multipart/form-data" class="stacked-form" style="max-width: 600px; margin: 0 auto; gap: 1rem;">
                                 <input type="hidden" name="auctionId" id="editAuctionIdInput" value="">
                                 <input type="hidden" name="submitAction" id="auctionSubmitActionInput" value="create">
                                 
                                 <!-- Auction Logo Picker -->
                                 <div style="display: flex; gap: 1.25rem; align-items: center; text-align: left;">
                                     <label style="font-weight: 700; color: var(--text-muted); width: 130px; font-size: 0.78rem; text-transform: uppercase;">Auction Logo</label>
                                     <div style="display: flex; gap: 0.85rem; align-items: center;">
                                         <div style="width: 72px; height: 72px; border-radius: 8px; border: 2px dashed rgba(255,255,255,0.12); background: rgba(15, 23, 42, 0.3); display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative;">
                                             <img id="auctionLogoPreview" src="/uploads/default-auction.svg" style="max-width: 100%; max-height: 100%; object-fit: contain;" onerror="this.src='/uploads/default-auction.svg'">
                                         </div>
                                         <div style="position: relative; overflow: hidden; display: inline-block;">
                                             <button type="button" class="btn btn-secondary" style="font-size: 0.75rem; padding: 0.4rem 0.85rem; border-radius: 6px; pointer-events: none;">CHOOSE FILE</button>
                                             <input type="file" name="logo" accept="image/*" onchange="previewAuctionLogo(this)" style="position: absolute; left: 0; top: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;">
                                         </div>
                                     </div>
                                 </div>

                                 <!-- Sports Type & Season Row -->
                                 <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; text-align: left;">
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Sports Type*</label>
                                         <select name="sportsType" id="editSportsType" required class="form-control" style="border-radius: 8px !important;">
                                             <option value="Cricket" selected>Cricket</option>
                                             <option value="Football">Football</option>
                                             <option value="Kabaddi">Kabaddi</option>
                                             <option value="Basketball">Basketball</option>
                                             <option value="Other">Other</option>
                                         </select>
                                     </div>
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Season</label>
                                         <select name="season" id="editSeason" class="form-control" style="border-radius: 8px !important;">
                                             <option value="2026" selected>2026</option>
                                             <option value="2025">2025</option>
                                             <option value="2024">2024</option>
                                             <option value="2023">2023</option>
                                         </select>
                                     </div>
                                 </div>

                                 <!-- Auction Name Row -->
                                 <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem; text-align: left;">
                                     <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Auction Name*</label>
                                     <input type="text" name="name" id="editAuctionName" required class="form-control" placeholder="IPL Mega Auction 2026" style="border-radius: 8px !important;">
                                 </div>

                                 <!-- Auction Date & Time Row -->
                                 <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; text-align: left;">
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Auction Date*</label>
                                         <input type="date" name="auctionDate" id="editAuctionDate" required class="form-control" style="color-scheme: dark; border-radius: 8px !important;">
                                     </div>
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Auction Time</label>
                                         <input type="time" name="auctionTime" id="editAuctionTime" class="form-control" style="color-scheme: dark; border-radius: 8px !important;">
                                     </div>
                                 </div>

                                 <!-- Points Per Team & Units Row -->
                                 <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; text-align: left;">
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Purse Points Per Team*</label>
                                         <input type="number" name="pointsPerTeam" id="editPointsPerTeam" required class="form-control" value="100000" style="border-radius: 8px !important;">
                                     </div>
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Purse Units (Symbol)</label>
                                         <input type="text" name="units" id="editUnits" class="form-control" placeholder="e.g. ₹, $, CR/LAC" value="CR/LAC" style="border-radius: 8px !important;">
                                     </div>
                                 </div>

                                 <!-- Base Bid & Bid Increase by Stacked -->
                                 <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; text-align: left;">
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Default Base Bid*</label>
                                         <input type="number" step="any" name="baseBid" id="editBaseBid" required class="form-control" value="1000.00" style="border-radius: 8px !important;">
                                     </div>
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Default Bid Increments*</label>
                                         <input type="number" step="any" name="bidIncreaseBy" id="editBidIncreaseBy" required class="form-control" value="500.00" style="border-radius: 8px !important;">
                                     </div>
                                 </div>

                                 <!-- Player Per Team Limits -->
                                 <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; text-align: left;">
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Player Count / Team (Max)*</label>
                                         <input type="number" name="playersPerTeamMax" id="editPlayersMax" required class="form-control" value="16" style="border-radius: 8px !important;">
                                     </div>
                                     <div class="form-group" style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-weight: 700; color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase;">Player Count / Team (Min)</label>
                                         <input type="number" name="playersPerTeamMin" id="editPlayersMin" class="form-control" value="0" style="border-radius: 8px !important;">
                                     </div>
                                 </div>

                                 <!-- Submit Button Row -->
                                 <div style="margin-top: 0.75rem; display: flex; gap: 0.75rem; justify-content: flex-start;">
                                     <button type="submit" onclick="document.getElementById('auctionSubmitActionInput').value='create'" class="btn btn-success" style="padding: 0.65rem 1.75rem; font-size: 0.85rem; border-radius: 8px;">➕ Create Event</button>
                                     <button type="submit" id="saveAuctionChangesBtn" onclick="document.getElementById('auctionSubmitActionInput').value='update'" class="btn btn-primary" style="display: none; padding: 0.65rem 1.75rem; font-size: 0.85rem; border-radius: 8px;">💾 Save Event</button>
                                     <button type="button" id="cancelAuctionEditBtn" onclick="resetAuctionForm()" class="btn btn-secondary" style="padding: 0.65rem 1.25rem; font-size: 0.85rem; border-radius: 8px;">Cancel</button>
                                 </div>
                             </form>
                         </div>
                         
                         <!-- INNER TAB 2: CREATED AUCTIONS LIST BOX FORMAT -->
                         <div id="innerTabAuctionList" style="display: none;">
                             <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem;">
                                 <% if (data.auctionsList && data.auctionsList.length > 0) { %>
                                     <% data.auctionsList.forEach((auc, i) => { %>
                                         <% const isCurrent = auc.id === (data.auctionDetails ? data.auctionDetails.id : 'active_auction'); %>
                                         <div class="panel auction-card-box <%= isCurrent ? 'active-auction-box' : '' %>" style="text-align: left; border-radius: 12px; padding: 1.15rem; background: rgba(15, 23, 42, 0.35);">
                                             <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
                                                 <span style="background: rgba(59,130,246,0.1); color: var(--accent); font-size: 0.7rem; padding: 0.2rem 0.5rem; border-radius: 5px; font-weight: bold; border: 1px solid rgba(59,130,246,0.15);"><%= auc.sportsType || 'Cricket' %></span>
                                                 <span style="color: var(--text-muted); font-size: 0.72rem; font-weight: 700;"><%= auc.season || '2026' %></span>
                                             </div>
                                             <h4 style="color: #fff; font-size: 0.95rem; margin: 0 0 0.5rem 0; font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= auc.name || 'Unnamed Auction' %></h4>
                                             <div style="color: var(--text-muted); font-size: 0.76rem; margin-bottom: 1rem; display: flex; flex-direction: column; gap: 0.2rem;">
                                                 <div>📅 Date: <%= auc.auctionDate || 'N/A' %> <%= auc.auctionTime || '' %></div>
                                                 <div>💰 Purse: <%= auc.pointsPerTeam || 0 %> <%= auc.units || '' %></div>
                                             </div>
                                             <div style="display: flex; gap: 0.4rem; border-top: 1px solid rgba(255,255,255,0.04); padding-top: 0.75rem;">
                                                 <button type="button" class="btn select-auction-btn" data-id="<%= auc.id %>" style="flex: 1.3; padding: 0.4rem; font-size: 0.75rem; background: rgba(34, 197, 94, 0.1) !important; border: 1px solid rgba(34, 197, 94, 0.2) !important; color: var(--success); font-weight: bold; border-radius: 6px;">✅ Choose</button>
                                                 <button type="button" class="btn edit-auction-btn" data-id="<%= auc.id %>" data-name="<%= auc.name %>" data-sport="<%= auc.sportsType %>" data-season="<%= auc.season %>" data-date="<%= auc.auctionDate %>" data-time="<%= auc.auctionTime %>" data-purse="<%= auc.pointsPerTeam %>" data-units="<%= auc.units %>" data-base="<%= auc.baseBid %>" data-inc="<%= auc.bidIncreaseBy %>" data-max="<%= auc.playersPerTeamMax %>" data-min="<%= auc.playersPerTeamMin %>" style="flex: 1; padding: 0.4rem; font-size: 0.75rem; background: rgba(59, 130, 246, 0.1) !important; border: 1px solid rgba(59, 130, 246, 0.2) !important; color: #60a5fa; font-weight: bold; border-radius: 6px;">✏️ Edit</button>
                                                 <button type="button" onclick="deleteAuctionBox('<%= auc.id %>')" class="btn btn-danger" style="flex: 1; padding: 0.4rem; font-size: 0.75rem; border-radius: 6px;">🗑️ Delete</button>
                                             </div>
                                         </div>
                                     <% }) %>
                                 <% } else { %>
                                     <div style="color: var(--text-muted); font-size: 0.8rem; font-style: italic;">No auctions created yet.</div>
                                 <% } %>
                             </div>
                         </div>
                         
                         <style>
                             .auction-card-box { border: 1px solid var(--border-color); }
                             .auction-card-box.active-auction-box { border: 1.5px solid var(--primary); box-shadow: var(--glow-gold); }
                         </style>

                         <script>
                             function switchInnerAuctionTab(tab) {
                                 localStorage.setItem('keepInnerAuctionTab', tab);
                                 if (tab === 'form') {
                                     document.getElementById('innerTabAuctionForm').style.display = 'block';
                                     document.getElementById('innerTabAuctionList').style.display = 'none';
                                     document.getElementById('innerTabBtnForm').classList.add('active');
                                     document.getElementById('innerTabBtnList').classList.remove('active');
                                 } else {
                                     document.getElementById('innerTabAuctionForm').style.display = 'none';
                                     document.getElementById('innerTabAuctionList').style.display = 'block';
                                     document.getElementById('innerTabBtnForm').classList.remove('active');
                                     document.getElementById('innerTabBtnList').classList.add('active');
                                 }
                             }

                             function resetAuctionForm() {
                                 document.getElementById('updateAuctionForm').reset();
                                 document.getElementById('editAuctionIdInput').value = '';
                                 document.getElementById('auctionSubmitActionInput').value = 'create';
                                 document.getElementById('saveAuctionChangesBtn').style.display = 'none';
                             }

                             function loadAuctionIntoForm(id, name, type, season, date, time, pts, units, base, inc, max, min) {
                                 document.getElementById('editAuctionIdInput').value = id;
                                 document.getElementById('editAuctionName').value = name || '';
                                 document.getElementById('editSportsType').value = type || 'Cricket';
                                 document.getElementById('editSeason').value = season || '2026';
                                 document.getElementById('editAuctionDate').value = date || '';
                                 document.getElementById('editAuctionTime').value = time || '';
                                 document.getElementById('editPointsPerTeam').value = pts || 100000;
                                 document.getElementById('editUnits').value = units || 'CR/LAC';
                                 document.getElementById('editBaseBid').value = base || 1000;
                                 document.getElementById('editBidIncreaseBy').value = inc || 500;
                                 document.getElementById('editPlayersMax').value = max || 16;
                                 document.getElementById('editPlayersMin').value = min || 0;
                                 
                                 document.getElementById('auctionSubmitActionInput').value = 'update';
                                 document.getElementById('saveAuctionChangesBtn').style.display = 'inline-block';
                                 
                                 switchInnerAuctionTab('form');
                             }

                             async function deleteAuctionBox(id) {
                                 if (id === 'active_auction') {
                                     return alert('⚠️ The main default auction cannot be deleted!');
                                 }
                                 if (!confirm('🗑️ Are you sure you want to permanently delete this auction event?')) return;
                                 
                                 const res = await fetch('/admin/delete-auction-details', {
                                     method: 'POST',
                                     headers: { 'Content-Type': 'application/json' },
                                     body: JSON.stringify({ auctionId: id })
                                 });
                                 const result = await res.json();
                                 if (result.success) {
                                     localStorage.setItem('keepDataModalOpen', 'true');
                                     localStorage.setItem('keepDataModalTab', 'auction');
                                     localStorage.setItem('keepInnerAuctionTab', 'list');
                                     location.reload();
                                 } else {
                                     alert('Error: ' + result.error);
                                 }
                             }

                             document.addEventListener('click', function(e) {
                                 const editBtn = e.target.closest('.edit-auction-btn');
                                 if (editBtn) {
                                     const d = editBtn.dataset;
                                     loadAuctionIntoForm(d.id, d.name, d.sport, d.season, d.date, d.time, d.purse, d.units, d.base, d.inc, d.max, d.min);
                                 }
                             });

                             setTimeout(() => {
                                 const innerTab = localStorage.getItem('keepInnerAuctionTab');
                                 if (innerTab) switchInnerAuctionTab(innerTab);
                             }, 100);
                         </script>
                     </div>
                     
                     <script>
                         function previewAuctionLogo(input) {
                             if (input.files && input.files[0]) {
                                 const reader = new FileReader();
                                 reader.onload = function(e) {
                                     document.getElementById('auctionLogoPreview').src = e.target.result;
                                 }
                                 reader.readAsDataURL(input.files[0]);
                             }
                         }
                     </script>

                     <!-- TAB 4: SYSTEM CONSOLE (Advanced) -->
                     <div id="modalTabAdvanced" class="modal-tab-content" style="display: none;">
                         <div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 1.5rem; align-items: start;">
                             <!-- Left Column: Modifier & Reset -->
                             <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                                 <!-- Global Timer Controls -->
                                 <div class="panel" style="background: rgba(15, 23, 42, 0.3); padding: 1.25rem; border-radius: 12px;">
                                     <h3 style="margin: 0 0 1rem 0; font-size: 1rem; color: var(--primary); font-weight: 800; text-align: left; text-transform: uppercase;">⏰ Global Timer Controls</h3>
                                     <style>
                                         .timer-switch { position: relative; display: inline-block; width: 56px; height: 30px; }
                                         .timer-switch input { opacity: 0; width: 0; height: 0; }
                                         .timer-slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--danger); transition: .4s; border-radius: 30px; box-shadow: inset 0 2px 4px rgba(0,0,0,0.3); }
                                         .timer-slider:before { position: absolute; content: ""; height: 22px; width: 22px; left: 4px; bottom: 4px; background-color: white; transition: .4s; border-radius: 50%; box-shadow: 0 2px 5px rgba(0,0,0,0.2); }
                                         .timer-switch input:checked + .timer-slider { background-color: var(--success); }
                                         .timer-switch input:checked + .timer-slider:before { transform: translateX(26px); }
                                     </style>
                                     <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; background: var(--bg-dark); padding: 0.85rem; border-radius: 8px; border: 1px solid var(--border-color); text-align: left;">
                                         <div style="display: flex; flex-direction: column;">
                                             <span style="color: #fff; font-weight: bold; font-size: 0.88rem;">Main Clock State</span>
                                             <span style="color: var(--text-muted); font-size: 0.68rem;">Enable or disable the auction timer globally</span>
                                         </div>
                                         <label class="timer-switch">
                                             <input type="checkbox" id="timerOnOffToggle" checked onchange="if(window.socket) window.socket.emit('toggleTimerOff');">
                                             <span class="timer-slider"></span>
                                         </label>
                                     </div>
                                 </div>

                                 <!-- Budget Modifier Card -->
                                 <div class="panel" style="background: rgba(15, 23, 42, 0.3); padding: 1.25rem; border-radius: 12px;">
                                     <h3 style="margin: 0 0 1rem 0; font-size: 1rem; color: var(--primary); font-weight: 800; text-align: left; text-transform: uppercase;">💰 Manual Budget Adjuster</h3>
                                     <form id="adjustBudgetForm" class="stacked-form">
                                         <input type="hidden" name="actionType" id="budgetActionType" value="add">
                                         <div style="display: flex; gap: 0.75rem;">
                                             <select name="teamName" id="adjustBudgetTeamSelect" required class="form-control" style="flex: 1.3; border-radius: 8px !important;">
                                                 <option value="" disabled selected>Select Franchise</option>
                                                 <% data.teams.sort((a, b) => a.name.localeCompare(b.name)).forEach(team => { %>
                                                     <option value="<%= team.name %>"><%= team.name %></option>
                                                 <% }) %>
                                             </select>
                                             <input type="number" name="amount" placeholder="Amount ($)" required class="form-control" style="flex: 1; border-radius: 8px !important;">
                                         </div>
                                         <div style="display: flex; gap: 0.5rem; margin-top: 0.35rem;">
                                             <button type="submit" onclick="document.getElementById('budgetActionType').value='add'" class="btn btn-success" style="flex: 1; padding: 0.6rem; font-size: 0.78rem; border-radius: 8px;">+ ADD BUDGET</button>
                                             <button type="submit" onclick="document.getElementById('budgetActionType').value='deduct'" class="btn btn-danger" style="flex: 1; padding: 0.6rem; font-size: 0.78rem; border-radius: 8px;">- DEDUCT BUDGET</button>
                                         </div>
                                     </form>
                                 </div>

                                 <!-- Danger Zone Reset Card -->
                                 <div class="panel" style="background: rgba(239, 68, 68, 0.02); padding: 1.25rem; border: 1px solid rgba(239, 68, 68, 0.2) !important; border-radius: 12px;">
                                     <h3 style="margin: 0 0 0.65rem 0; font-size: 1rem; color: #fca5a5; font-weight: 800; text-align: left; text-transform: uppercase;">🚨 Administrative Danger Zone</h3>
                                     <p style="font-size: 0.72rem; color: #f87171; line-height: 1.4; margin: 0 0 1rem 0; text-align: left;">Master resets clear all sold/unsold states, reset player directories back to available, refund wallet budgets, and clear draft records immediately. This is irreversible.</p>
                                     <button id="masterResetBtn" class="btn btn-danger" style="width: 100%; padding: 0.65rem; font-size: 0.8rem; font-weight: 800; border-radius: 8px;">🚨 RESET ENTIRE DRAFT AUCTION</button>
                                     <button id="clearAllPlayersBtn" class="btn btn-danger" style="width: 100%; padding: 0.65rem; font-size: 0.8rem; font-weight: 800; margin-top: 0.5rem; background: rgba(239, 68, 68, 0.1) !important; border: 1px solid rgba(239, 68, 68, 0.25) !important; border-radius: 8px;">🗑️ DELETE ALL PLAYERS ONLY</button>
                                     <button id="clearAllTeamsBtn" class="btn btn-danger" style="width: 100%; padding: 0.65rem; font-size: 0.8rem; font-weight: 800; margin-top: 0.5rem; background: rgba(239, 68, 68, 0.1) !important; border: 1px solid rgba(239, 68, 68, 0.25) !important; border-radius: 8px;">🗑️ DELETE ALL FRANCHISES ONLY</button>
                                     <button id="clearAllDataBtn" class="btn btn-danger" style="width: 100%; padding: 0.65rem; font-size: 0.8rem; font-weight: 800; margin-top: 0.5rem; background: var(--danger-gradient) !important; border-radius: 8px;">🗑️ DELETE ALL DATA (RESET ALL)</button>
                                 </div>
                             </div>

                             <!-- Right Column: Unsold re-auction -->
                             <div class="panel" style="background: rgba(15, 23, 42, 0.3); padding: 1.25rem; border-radius: 12px;">
                                 <h3 style="margin: 0 0 1rem 0; font-size: 1rem; color: var(--primary); font-weight: 800; text-align: left; text-transform: uppercase;">🔁 Re-auction Unsold Players</h3>
                                 <div style="display: flex; gap: 0.4rem; margin-bottom: 0.85rem;">
                                     <input type="text" id="unsoldSearchInput" placeholder="Search by #No or Name..." class="form-control" style="flex: 1; border-radius: 8px !important;" oninput="renderReleasePlayers()">
                                     <select id="unsoldSortSelect" class="form-control" style="max-width: 130px; border-radius: 8px !important;" onchange="renderReleasePlayers()">
                                         <option value="name-asc">Sort: A-Z</option>
                                         <option value="num-asc"># Asc</option>
                                         <option value="num-desc"># Desc</option>
                                     </select>
                                 </div>
                                 <div id="advancedPlayersListContainer" class="sleek-scroll" style="max-height: 52vh; overflow-y: auto; display: flex; flex-direction: column; gap: 0.45rem; padding-right: 0.25rem;">
                                     <% const unsoldPlayers = data.players.filter(p => p.status === 'unsold').sort((a, b) => a.name.localeCompare(b.name)); %>
                                     <% if (unsoldPlayers.length === 0) { %>
                                         <div style="font-size: 0.76rem; color: var(--text-muted); text-align: center; padding: 2rem;">No unsold players.</div>
                                     <% } %>
                                     <% unsoldPlayers.forEach(player => { %>
                                         <% 
                                             const cat = data.categories ? data.categories.find(c => c.id === player.category_id) : null;
                                             const catName = cat ? cat.name : 'OPEN';
                                             const units = data.auctionDetails && data.auctionDetails.units ? data.auctionDetails.units : '₹';
                                             const formattedBase = ['₹', '$', '€', '£'].includes(units) ? `${units}${player.basePrice.toLocaleString()}` : `${player.basePrice.toLocaleString()} ${units}`;
                                         %>
                                         <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(15, 23, 42, 0.45); padding: 0.5rem 0.75rem; border-radius: 8px; border: 1px solid var(--border-color);">
                                             <div style="display: flex; flex-direction: column; text-align: left;">
                                                 <span style="font-weight: 800; font-size: 0.82rem; color: #fff;">#<%= player.formNo || 'N/A' %> <%= player.name %></span>
                                                 <div style="font-size: 0.7rem; color: var(--text-muted); display: flex; gap: 0.5rem; margin-top: 0.1rem; flex-wrap: wrap;">
                                                     <span>Cat: <%= catName %></span>
                                                     <span>Base: <%= formattedBase %></span>
                                                     <span style="color: var(--danger); font-weight: bold;">UNSOLD</span>
                                                 </div>
                                             </div>
                                             <button onclick="resetPlayer('<%= player.id %>')" class="btn btn-primary" style="padding: 0.35rem 0.75rem; font-size: 0.72rem; font-weight: bold; border-radius: 6px;">Nominate</button>
                                         </div>
                                     <% }) %>
                                 </div>
                             </div>
                         </div>
                     </div>

                 </div>
             </div>
         </div>

         <!-- BULK CATEGORY ASSIGNMENT MODAL -->
         <div id="bulkCategoryModal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(7,11,20,0.92); z-index: 10000; justify-content: center; align-items: center; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);">
             <div class="panel animate-fade-in" style="width: 95%; max-width: 800px; height: 80vh; display: flex; flex-direction: column; overflow: hidden; position: relative; border: 1px solid var(--border-color); background: var(--bg-dark); padding: 1.5rem 2rem; border-radius: 16px; box-shadow: var(--shadow-luxury); text-align: left;">
                 <!-- Modal Header -->
                 <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 0.85rem; margin-bottom: 1rem; flex-shrink: 0;">
