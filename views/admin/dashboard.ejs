<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Live Auction</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/socket.io/socket.io.js"></script>
</head>
<body style="overflow: hidden; height: 100vh; margin: 0; padding: 0; background-color: var(--bg-dark);">
    <div class="glow-orb orb-1"></div>
    <div class="glow-orb orb-2"></div>
<%
  const unitsLocal = data.auctionDetails && data.auctionDetails.units ? data.auctionDetails.units : '₹';
  const formatCurrencyLocal = (amt) => {
    return ['₹', '$', '€', '£'].includes(unitsLocal) ? `${unitsLocal}${amt.toLocaleString()}` : `${amt.toLocaleString()} ${unitsLocal}`;
  };
%>
    <div class="app-container" style="display: flex; flex-direction: column; height: 100vh; width: 100vw; max-width: 100%; overflow: hidden;">
        <!-- Main Header -->
        <header class="topbar" style="height: 60px; flex-shrink: 0; background: rgba(15, 23, 42, 0.7) !important; border-bottom: 1px solid var(--border-color) !important; padding: 0.75rem 2rem !important;">
            <div style="display: flex; align-items: center; gap: 0.85rem;">
                <img src="<%= data.auctionDetails && data.auctionDetails.logo ? data.auctionDetails.logo : '/uploads/default-auction.svg' %>" style="width: 30px; height: 30px; border-radius: 6px; object-fit: contain; border: 1px solid var(--border-color); background: var(--bg-dark);" onerror="this.src='/uploads/default-auction.svg'">
                <h1 id="pageTitle" style="font-size: 1.15rem; margin: 0; font-weight: 800; background: var(--primary-gradient); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 700px; font-family: 'Plus Jakarta Sans', sans-serif;" title="<%= data.auctionDetails ? data.auctionDetails.name : 'Admin Console' %>"><%= data.auctionDetails ? data.auctionDetails.name : 'Admin Console' %></h1>
            </div>
            <div style="display: flex; gap: 0.85rem; align-items: center;">
                <div class="stats-bar" style="margin: 0; background: transparent; padding: 0; display: flex; align-items: center; gap: 0.4rem;">
                    <div class="stat-pill" style="border-radius: 6px !important; padding: 0.3rem 0.65rem !important; font-size: 0.76rem !important;">Teams: <span id="totalTeams"><%= data.teams.length %></span></div>
                    <div class="stat-pill" style="border-radius: 6px !important; padding: 0.3rem 0.65rem !important; font-size: 0.76rem !important;">Players: <span id="totalPlayers"><%= data.players.length %></span></div>
                    <div class="stat-pill" style="border-radius: 6px !important; padding: 0.3rem 0.65rem !important; font-size: 0.76rem !important;">Status: <span class="badge" id="auctionStatusBadge" style="border-radius: 4px !important; font-size: 0.68rem !important; padding: 0.15rem 0.45rem !important;"><%= data.auctionState.status.toUpperCase() %></span></div>
                    <button onclick="syncData()" class="btn btn-secondary" style="font-size: 0.68rem; padding: 0.25rem 0.6rem; border-radius: 5px; cursor: pointer; font-weight: 700; margin-left: 0.25rem;" title="Sync data from server">🔄 Sync</button>
                </div>
                <button onclick="document.getElementById('dataModal').style.display='flex'" class="btn btn-primary" style="padding: 0.4rem 1.1rem; font-weight: 800; font-size: 0.8rem; border-radius: var(--radius-small);">⚙ Admin Tools</button>
                <a href="/logout" class="btn btn-danger" style="padding: 0.4rem 0.75rem; border-radius: 8px; font-size: 0.8rem; font-weight: 700;">⏻</a>
            </div>
        </header>

        <!-- LIVE CONSOLE SECTION -->
        <div style="flex: 1; overflow: hidden; height: calc(100vh - 60px); background: transparent;">
            <div class="grid" style="display: grid; grid-template-columns: 56% 44%; height: 100%; width: 100%; gap: 1.25rem; padding: 1.25rem; overflow: hidden; background: transparent;">
                
                <!-- Left: Player Board & Bio Grid -->
                <div class="panel" style="display: flex; flex-direction: column; height: 100%; position: relative; padding: 0; border: 1px solid var(--border-color) !important; overflow: hidden; background: var(--bg-card); border-radius: var(--radius-card); box-shadow: var(--shadow-luxury);">
                    <!-- Top Search/Select Area -->
                    <div style="padding: 0.85rem 1.25rem; background: rgba(15, 23, 42, 0.45); border-bottom: 1px solid var(--border-color); display: flex; gap: 0.6rem; align-items: center; justify-content: center;">
                        <div style="display: flex; flex-direction: column; align-items: flex-start; border-right: 1px solid var(--border-color); padding-right: 0.6rem; margin-right: 0.2rem; position: relative;">
                            <input type="text" id="quickUnsoldInput" placeholder="Search Player # / Name..." class="form-control" style="width: 170px; padding: 0.45rem 0.7rem !important; font-size: 0.82rem !important; border-radius: 8px !important;" oninput="updateQuickUnsoldSearch()" onkeydown="handleQuickUnsoldKeydown(event)" autocomplete="off">
                            <div id="quickUnsoldPreview" style="position: absolute; top: 100%; left: 0; width: 260px; background: rgba(17, 24, 39, 0.98); border: 1px solid var(--border-color); border-radius: 8px; z-index: 10000; display: none; max-height: 220px; overflow-y: auto; margin-top: 5px; box-shadow: var(--shadow-luxury);"></div>
                        </div>
                        <select id="categoryFilterSelect" class="form-control" style="max-width: 150px; padding: 0.45rem 0.7rem !important; font-size: 0.82rem !important; border-radius: 8px !important;">
                            <% const activeCat = data.auctionState && data.auctionState.activeCategory ? data.auctionState.activeCategory : 'all'; %>
                            <option value="all" <%= (activeCat === 'all' || activeCat.startsWith('cat_all_')) ? 'selected' : '' %>>All Categories</option>
                            <% data.categories.filter(c => !c.id.startsWith('cat_all_')).forEach(cat => { %>
                                <option value="<%= cat.id %>" <%= activeCat === cat.id ? 'selected' : '' %>><%= cat.name %></option>
                            <% }) %>
                        </select>
                        <select id="playerSelect" class="form-control" style="max-width: 220px; padding: 0.45rem 0.7rem !important; font-size: 0.82rem !important; border-radius: 8px !important;">
                            <% 
                                const initialPlayers = data.players.filter(p => {
                                    if (p.status !== 'available') return false;
                                    if (activeCat === 'all' || activeCat.startsWith('cat_all_')) {
                                        return !p.category_id || p.category_id.startsWith('cat_all_');
                                    } else {
                                        return p.category_id === activeCat;
                                    }
                                });
                                initialPlayers.sort((a, b) => a.name.localeCompare(b.name));
                                initialPlayers.forEach(player => { 
                             %>
                                <option value="<%= player.id %>" data-base="<%= player.basePrice %>" data-category="<%= player.category_id || '' %>"><%= player.name %> - <%= formatCurrencyLocal(player.basePrice) %></option>
                            <% }) %>
                        </select>
                        <button id="startBtn" class="btn btn-primary" style="white-space: nowrap; padding: 0.5rem 1.25rem; font-size: 0.8rem; font-weight: 800; border-radius: 8px;">LOAD PLAYER</button>
                    </div>

                    <!-- Center Player Card -->
                    <div class="sleek-scroll" style="flex: 1; min-height: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; position: relative; overflow-y: auto; padding: 1.25rem 1.5rem;">
                        <div class="player-card" style="position: relative; background: transparent; border: none; box-shadow: none; width: 100%; max-width: 600px; padding: 0;">
                            <div id="statusOverlay" class="status-overlay" style="border-radius: 12px;">
                                <div id="statusText" class="status-text"></div>
                            </div>
                            
                            <!-- Player Info Block -->
                            <div style="display: flex; flex-direction: column; gap: 0.85rem; width: 100%;">
                                <!-- Row 1: Player Identity & Live Timer -->
                                <div style="display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; background: rgba(15, 23, 42, 0.45); padding: 0.85rem 1.15rem; border-radius: 14px; border: 1px solid var(--border-color); box-shadow: var(--shadow-soft);">
                                    <div style="display: flex; align-items: center; gap: 1.15rem;">
                                        <div class="player-spotlight-frame" style="width: 85px; height: 85px; margin: 0;">
                                            <img id="livePlayerPhoto" src="/uploads/default-player.svg" style="width: 85px; height: 85px; border-radius: 50%; object-fit: cover; border: 3px solid var(--primary); background: var(--bg-dark);">
                                        </div>
                                        <div style="text-align: left;">
                                            <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                                                <span id="livePlayerFormNo" style="background: var(--primary); color: #070B14; padding: 0.2rem 0.6rem; border-radius: 5px; font-size: 0.95rem; font-weight: 800; font-family: monospace;">[#--]</span>
                                                <h2 id="livePlayerName" class="player-name" style="font-size: 1.8rem !important; margin: 0; line-height: 1.1; font-weight: 800; font-family: 'Plus Jakarta Sans', sans-serif;">Ready to Bid</h2>
                                            </div>
                                            <div id="livePlayerRole" class="player-role" style="font-size: 0.88rem !important; margin-top: 0.3rem;">--</div>
                                            <div style="display: flex; gap: 0.35rem; margin-top: 0.3rem; flex-wrap: wrap;">
                                                <div id="liveCategoryDisplay" class="player-role" style="font-size: 0.78rem !important; color: var(--accent); font-weight: 700; border: 1px solid rgba(59, 130, 246, 0.2); padding: 0.15rem 0.5rem; border-radius: 4px; display: none; background: rgba(59, 130, 246, 0.03);">No Category Selected</div>
                                                <div id="liveBasePriceDisplay" class="player-role" style="font-size: 0.78rem !important; color: var(--success); font-weight: 700; border: 1px solid rgba(34, 197, 94, 0.2); padding: 0.15rem 0.5rem; border-radius: 4px; display: none; background: rgba(34, 197, 94, 0.03);">Base Bid: --</div>
                                            </div>
                                            <div id="livePlayerAge" style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.3rem; font-weight: 500;">Age: --</div>
                                            <div id="livePlayerCaptainBadge" style="display: none; background: linear-gradient(135deg, #fbbf24, #f59e0b); color: #000; font-size: 0.68rem; font-weight: 800; padding: 0.2rem 0.6rem; border-radius: 5px; margin-top: 0.4rem; width: fit-content; text-transform: uppercase; letter-spacing: 0.5px;">👑 TEAM CAPTAIN</div>
                                        </div>
                                    </div>
                                    <div>
                                        <div id="liveTimer" class="timer" style="width: 64px; height: 64px; font-size: 1.6rem;">30</div>
                                    </div>
                                </div>
                                <!-- Row 2: Bid Readout -->
                                 <div class="bid-display" id="bidDisplay" style="padding: 1rem 1.25rem !important; text-align: center;">
                                     <div class="current-bid-label" style="font-size: 0.78rem !important; letter-spacing: 2px !important; margin-bottom: 0.3rem;">CURRENT BID</div>
                                     <div id="liveBidAmount" class="current-bid-amount" style="font-size: 3.5rem !important; line-height: 1;"><%= formatCurrencyLocal(data.auctionState.currentBid || 0) %></div>
                                     <div id="liveHighestBidder" class="highest-bidder" style="font-size: 0.95rem !important; padding: 0.35rem 1rem !important; margin-top: 0.5rem;"><%= data.auctionState.highestBidder ? '🏆 ' + data.auctionState.highestBidder : 'None' %></div>
                                 </div>
                             </div>
                             
                             <!-- Player Bio Specs Grid -->
                             <div id="livePlayerBioGrid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; margin: 1.2rem 0; padding: 1rem; background: rgba(15, 23, 42, 0.45); border-radius: 12px; border: 1px solid var(--border-color); font-size: 0.8rem; text-align: left;">
                                 <div style="background: rgba(255,255,255,0.01); padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.02);"><span style="color: var(--text-muted); display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.1rem;">Base Price:</span> <strong id="bioBasePrice" style="color: var(--success); font-size: 0.95rem;">--</strong></div>
                                 <div style="background: rgba(255,255,255,0.01); padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.02);"><span style="color: var(--text-muted); display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px;">Age:</span> <strong id="bioAge" style="color: #ffffff; font-size: 0.95rem;">--</strong></div>
                                 <div style="background: rgba(255,255,255,0.01); padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.02);"><span style="color: var(--text-muted); display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px;">Father Name:</span> <strong id="bioFather" style="color: #ffffff; font-size: 0.95rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block;">--</strong></div>
                                 <div style="background: rgba(255,255,255,0.01); padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.02);"><span style="color: var(--text-muted); display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px;">Tag/Category:</span> <strong id="bioTag" style="color: var(--accent); font-size: 0.95rem;">--</strong></div>
                                 <div style="background: rgba(255,255,255,0.01); padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.02);"><span style="color: var(--text-muted); display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px;">Custom Tag:</span> <strong id="bioCustom" style="color: #c084fc; font-size: 0.95rem;">--</strong></div>
                                 <div style="background: rgba(255,255,255,0.01); padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.02);"><span style="color: var(--text-muted); display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px;">Spec 1:</span> <strong id="bioSpec1" style="color: #ffffff; font-size: 0.95rem;">--</strong></div>
                                 <div style="background: rgba(255,255,255,0.01); padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.02);"><span style="color: var(--text-muted); display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px;">Spec 2:</span> <strong id="bioSpec2" style="color: #ffffff; font-size: 0.95rem;">--</strong></div>
                                 <div style="background: rgba(255,255,255,0.01); padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.02);"><span style="color: var(--text-muted); display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px;">Spec 3:</span> <strong id="bioSpec3" style="color: #ffffff; font-size: 0.95rem;">--</strong></div>
                                 <div style="background: rgba(255,255,255,0.01); padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.02);"><span style="color: var(--text-muted); display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px;">Jersey/Trouser:</span> <strong id="bioSize" style="color: #ffffff; font-size: 0.95rem;">-- / --</strong></div>
                             </div>
                             <!-- Player Details Box -->
                             <div id="livePlayerDetailContainer" style="display: none; padding: 0.75rem 1rem; background: rgba(15, 23, 42, 0.45); border-radius: 12px; border: 1px solid var(--border-color); font-size: 0.8rem; text-align: left; margin-top: 0.75rem; box-shadow: inset 0 2px 10px rgba(0,0,0,0.5);">
                                 <span style="color: var(--text-muted); display: block; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.3rem; font-weight: bold;">Player Details & Info:</span>
                                 <div id="bioDetail" style="color: #cbd5e1; font-family: monospace; white-space: pre-wrap; line-height: 1.4; font-size: 0.75rem;">--</div>
                             </div>
                         </div>
                     </div>
                 </div>

                 <!-- Right Column: Tabbed Bidding Console & Standings Container -->
                 <div class="panel" style="border: 1px solid var(--border-color); padding: 0; display: flex; flex-direction: column; height: 100%; overflow: hidden; background: var(--bg-card); border-radius: var(--radius-card); box-shadow: var(--shadow-luxury);">
                     
                     <!-- Tab Navigation Bar -->
                     <div style="display: flex; background: rgba(15, 23, 42, 0.45); border-bottom: 1px solid var(--border-color); padding: 0.4rem 0.4rem 0 0.4rem; gap: 0.4rem; flex-shrink: 0;">
                         <button id="tabBtnBidding" onclick="switchRightTab('bidding')" class="btn" style="flex: 1; padding: 0.75rem; background: rgba(15, 23, 42, 0.8); color: var(--success); border: 1px solid rgba(34, 197, 94, 0.2); border-bottom: none; border-radius: 10px 10px 0 0; font-weight: 800; font-size: 0.88rem; cursor: pointer; transition: all 0.2s; box-shadow: none;">
                             ⚡ BIDDING CONSOLE
                         </button>
                         <button id="tabBtnStandings" onclick="switchRightTab('standings')" class="btn" style="flex: 1; padding: 0.75rem; background: rgba(255,255,255,0.01); color: var(--text-muted); border: 1px solid transparent; border-bottom: none; border-radius: 10px 10px 0 0; font-weight: 800; font-size: 0.88rem; cursor: pointer; transition: all 0.2s; box-shadow: none;">
                             🏆 TEAM STANDINGS
                         </button>
                     </div>

                     <!-- TAB 1 CONTENT: Bidding Console -->
                     <div id="tabContentBidding" style="display: flex; flex-direction: column; gap: 0.85rem; padding: 1.15rem; flex: 1; min-height: 0; overflow-y: auto;" class="sleek-scroll">
                         <!-- Selected Team Display & Quick Selector -->
                         <div style="padding: 0.85rem; background: rgba(15, 23, 42, 0.45); border-radius: 10px; text-align: center; border: 1px solid var(--border-color);">
                             <div style="color: var(--text-muted); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700; margin-bottom: 0.5rem;">SELECT TEAM TO BID</div>
                             <div id="quickTeamSelectContainer" style="display: flex; flex-wrap: wrap; gap: 0.3rem; justify-content: center; margin-bottom: 0.3rem;">
                                 <% data.teams.forEach(team => { %>
                                     <button type="button" class="team-tab-btn" data-teamname="<%= team.name %>" style="border-radius: 6px !important;" onclick="if(window.selectTeamForBid) window.selectTeamForBid('<%= team.name %>')"><%= team.shortName || team.name %></button>
                                 <% }) %>
                             </div>
                             <input type="hidden" id="quickTeamSelect" value="">
                             <div id="selectedTeamDisplay" style="font-size: 0.95rem; font-weight: 800; margin-top: 0.45rem; color: var(--success); display: none;"></div>
                         </div>

                         <!-- Bid Increment Buttons -->
                         <% 
                             const units = data.auctionDetails && data.auctionDetails.units ? data.auctionDetails.units : '₹';
                             const bidInc = data.auctionDetails && data.auctionDetails.bidIncreaseBy ? parseFloat(data.auctionDetails.bidIncreaseBy) : 500;
                             const formatCurrencyLocalInternal = (amt) => {
                                 return ['₹', '$', '€', '£'].includes(units) ? `${units}${amt.toLocaleString()}` : `${amt.toLocaleString()} ${units}`;
                             };
                         %>
                         <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
                             <button id="quickBidBtnSingle" class="btn quick-bid-btn" data-increment="<%= bidInc %>" style="padding: 0.65rem; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(34, 197, 94, 0.08) !important; border: 1px solid rgba(34, 197, 94, 0.2) !important; color: #fff; border-radius: 10px; cursor: pointer;">
                                 <div style="font-size: 1.1rem; font-weight: 800; color: var(--success);">+<%= formatCurrencyLocalInternal(bidInc) %></div>
                                 <div style="font-size: 0.6rem; color: var(--text-muted); margin-top: 0.1rem; text-transform: uppercase; font-weight: 700;">Single Increment</div>
                             </button>
                             <button id="quickBidBtnDouble" class="btn quick-bid-btn" data-increment="<%= bidInc * 2 %>" style="padding: 0.65rem; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(34, 197, 94, 0.08) !important; border: 1px solid rgba(34, 197, 94, 0.2) !important; color: #fff; border-radius: 10px; cursor: pointer;">
                                 <div style="font-size: 1.1rem; font-weight: 800; color: var(--success);">+<%= formatCurrencyLocalInternal(bidInc * 2) %></div>
                                 <div style="font-size: 0.6rem; color: var(--text-muted); margin-top: 0.1rem; text-transform: uppercase; font-weight: 700;">Double Increment</div>
                             </button>
                         </div>
                         <button id="quickBidBtnJump" class="btn quick-bid-btn" data-increment="<%= bidInc * 10 %>" style="width: 100%; padding: 0.65rem; background: rgba(34, 197, 94, 0.15) !important; border: 1px solid rgba(34, 197, 94, 0.28) !important; color: var(--success); font-weight: 800; font-size: 0.92rem; border-radius: 10px; box-shadow: 0 4px 10px rgba(34,197,94,0.1); cursor: pointer;">
                             <div style="font-size: 1.1rem; font-weight: 800; color: var(--success);">+<%= formatCurrencyLocalInternal(bidInc * 10) %> (Jump)</div>
                         </button>

                         <!-- Manual Bid Entry -->
                         <div style="background: rgba(15, 23, 42, 0.45); padding: 0.65rem; border-radius: 10px; border: 1px solid var(--border-color);">
                             <div style="color: var(--text-muted); font-size: 0.7rem; margin-bottom: 0.35rem; font-weight: 700; text-transform: uppercase;">Manual Bid Entry</div>
                             <div style="display: flex; gap: 0.35rem; align-items: stretch;">
                                 <button id="manualBidDownBtn" class="btn btn-secondary" style="padding: 0 0.75rem; font-size: 0.95rem; display: flex; align-items: center; justify-content: center; font-weight: bold; border-radius: 8px;" title="Subtract 100">▼</button>
                                 <input type="text" id="manualBidAmount" class="form-control" placeholder="e.g. 500, +500, -500" style="text-align: center; font-weight: 700; font-size: 0.95rem !important; border-radius: 8px !important;">
                                 <button id="manualBidUpBtn" class="btn btn-secondary" style="padding: 0 0.75rem; font-size: 0.95rem; display: flex; align-items: center; justify-content: center; font-weight: bold; border-radius: 8px;" title="Add 100">▲</button>
                                 <button id="manualBidBtn" class="btn btn-primary" style="padding: 0 1.1rem; font-weight: 800; border-radius: 8px;">Bid</button>
                             </div>
                         </div>

                         <!-- Timer Controls -->
                         <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; background: rgba(15, 23, 42, 0.45); padding: 0.5rem; border-radius: 8px; border: 1px solid var(--border-color);">
                             <button id="timerResetBtn" class="btn btn-secondary" style="padding: 0.45rem; font-size: 0.75rem; font-weight: 700; border-radius: 6px; flex: 1;">🔄 Reset</button>
                             <button id="timerPauseBtn" class="btn btn-secondary" style="padding: 0.45rem; font-size: 0.75rem; font-weight: 700; border-radius: 6px; flex: 1;">⏸️ Pause</button>
                         </div>

                         <!-- Decision Controls: SOLD & UNSOLD -->
                         <div style="display: flex; gap: 0.6rem; padding-top: 0.15rem;">
                             <button id="resetTimerBtn" style="display: none;"></button>
                             <button id="endAuctionBtn" class="btn btn-success" style="flex: 1; padding: 0.8rem; font-weight: 800; font-size: 0.95rem; border-radius: 10px;">✓ SOLD (S)</button>
                             <button id="unsoldBtn" class="btn btn-danger" style="flex: 1; padding: 0.8rem; font-weight: 800; font-size: 0.95rem; border-radius: 10px;">✕ UNSOLD (U)</button>
                         </div>
                     </div>

                     <!-- TAB 2 CONTENT: Franchise Standings -->
                     <div id="tabContentStandings" class="sleek-scroll" style="display: none; flex-direction: column; padding: 1.15rem; flex: 1; min-height: 0; overflow-y: auto; gap: 0.6rem;">
                         <div id="teamList" style="display: flex; flex-direction: column; gap: 0.6rem;">
                             <% data.teams.forEach((team, index) => { %>
                                 <% 
                                     const teamPlayers = data.players.filter(p => p.soldTo === team.name); 
                                     const maxPlayers = data.auctionDetails && data.auctionDetails.playersPerTeamMax ? parseInt(data.auctionDetails.playersPerTeamMax) : 15;
                                     const baseBid = data.auctionDetails && data.auctionDetails.baseBid ? parseFloat(data.auctionDetails.baseBid) : 500;
                                     const units = data.auctionDetails && data.auctionDetails.units ? data.auctionDetails.units : '₹';
                                     const formatCurrency = (amt) => ['₹', '$', '€', '£'].includes(units) ? `${units}${amt.toLocaleString()}` : `${amt.toLocaleString()} ${units}`;
                                     const playersLeft = maxPlayers - teamPlayers.length;
                                     
                                     let totalMinBudgetNeeded = 0;
                                     const currentCatId = data.auctionState && data.auctionState.currentPlayer ? data.auctionState.currentPlayer.category_id : null;
                                     if (data.categories) {
                                         data.categories.forEach(cat => {
                                             if (cat.id.startsWith('cat_all_')) return;
                                             const actualPlayersInCat = teamPlayers.filter(p => p.category_id === cat.id).length;
                                             const isCurrentCat = (currentCatId === cat.id);
                                             const assumedBought = isCurrentCat ? 1 : 0;
                                             const needed = Math.max(0, (cat.minPlayers || 0) - (actualPlayersInCat + assumedBought));
                                             if (needed > 0) {
                                                 const catBaseBid = cat.baseBid && cat.baseBid > 0 ? parseFloat(cat.baseBid) : baseBid;
                                                 totalMinBudgetNeeded += needed * catBaseBid;
                                             }
                                         });
                                     }
                                     const reservePoints = totalMinBudgetNeeded;
                                     const maxBid = playersLeft > 0 ? team.budget - reservePoints : team.budget;
                                     const cleanTeamName = team.name.replace(/\s+/g, '-');
                                 %>
                                 <div class="team-card" data-teamname="<%= team.name %>" style="border-left: 4.5px solid <%= team.color %>; border-radius: 10px; cursor: pointer;" onclick="toggleAdminRosterTab('<%= team.name %>')">
                                     <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                         <div style="font-weight: 800; color: #fff; font-size: 0.88rem; display: flex; align-items: center; gap: 6px;">
                                             <span style="color: var(--text-muted); margin-right: 1px; font-size: 0.76rem;"><%= index + 1 %>.</span>
                                             <% if (team.logo) { %>
                                                 <img src="<%= team.logo %>" style="width: 22px; height: 22px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(255,255,255,0.12);">
                                             <% } else { %>
                                                 <span class="color-dot" <%- 'style="background-color: ' + team.color + '; width: 10px; height: 10px; border-radius: 3px; display: inline-block;"' %>></span>
                                             <% } %>
                                             <%= team.name %>
                                         </div>
                                         <div style="font-size: 0.95rem; font-weight: 800; color: var(--success);"><%= formatCurrency(team.budget) %></div>
                                     </div>
                                     <div style="margin-top: 0.5rem; display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-muted); border-top: 1px solid rgba(255,255,255,0.03); padding-top: 0.35rem; font-weight: 500; align-items: flex-end;">
                                         <div style="display: flex; flex-direction: column; gap: 0.1rem;">
                                             <span>Purse: <%= formatCurrency(team.budget) %></span>
                                             <span style="color: var(--warning);">Reserve: <%= formatCurrency(reservePoints) %></span>
                                         </div>
                                         <div style="display: flex; flex-direction: column; gap: 0.1rem; align-items: flex-end;">
                                             <span style="background: rgba(255,255,255,0.02); padding: 0.1rem 0.3rem; border-radius: 4px; color: #cbd5e1; font-size: 0.68rem;">Ply: <%= teamPlayers.length %>/<%= maxPlayers %></span>
                                             <span style="color: var(--accent); font-weight: bold; font-size: 0.78rem;">Max Bid: <%= formatCurrency(maxBid) %></span>
                                         </div>
                                     </div>
                                     <div class="team-roster-expand" id="tab-roster-<%= cleanTeamName %>" style="display: none; margin-top: 0.65rem; border-top: 1px solid rgba(255,255,255,0.04); padding-top: 0.5rem;">
                                         <div style="font-size: 0.68rem; color: var(--primary); font-weight: bold; margin-bottom: 0.35rem; text-transform: uppercase; letter-spacing: 0.5px;">Squad Roster</div>
                                         <% if (teamPlayers.length === 0) { %>
                                             <div style="font-size: 0.72rem; color: var(--text-muted); font-style: italic;">No players bought yet.</div>
                                         <% } else { %>
                                             <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                                 <% teamPlayers.sort((a,b)=>b.soldPrice-a.soldPrice).forEach(p => { %>
                                                     <div style="display: flex; justify-content: space-between; font-size: 0.72rem; background: rgba(0,0,0,0.2); padding: 0.25rem 0.45rem; border-radius: 4px; border: 1px solid rgba(255,255,255,0.01);">
                                                         <span style="color: #cbd5e1;"><%= p.name %> <%= p.isCaptain ? '👑' : '' %></span>
                                                         <span style="color: var(--success); font-weight: bold;"><%= formatCurrency(p.soldPrice || 0) %></span>
                                                     </div>
                                                 <% }) %>
                                             </div>
                                         <% } %>
                                     </div>
                                 </div>
                             <% }) %>
                         </div>
                     </div>
                     
                     <script>
                         function switchRightTab(tab) {
                             const btnBidding = document.getElementById('tabBtnBidding');
                             const btnStandings = document.getElementById('tabBtnStandings');
                             const contentBidding = document.getElementById('tabContentBidding');
                             const contentStandings = document.getElementById('tabContentStandings');
 
                             if (tab === 'bidding') {
                                 btnBidding.style.background = 'rgba(15, 23, 42, 0.8)';
                                 btnBidding.style.color = 'var(--success)';
                                 btnBidding.style.borderColor = 'rgba(34, 197, 94, 0.2)';
                                 
                                 btnStandings.style.background = 'rgba(255,255,255,0.01)';
                                 btnStandings.style.color = 'var(--text-muted)';
                                 btnStandings.style.borderColor = 'transparent';
 
                                 contentBidding.style.display = 'flex';
                                 contentStandings.style.display = 'none';
                             } else {
                                 btnStandings.style.background = 'rgba(15, 23, 42, 0.8)';
                                 btnStandings.style.color = 'var(--success)';
                                 btnStandings.style.borderColor = 'rgba(34, 197, 94, 0.2)';
                                 
                                 btnBidding.style.background = 'rgba(255,255,255,0.01)';
                                 btnBidding.style.color = 'var(--text-muted)';
                                 btnBidding.style.borderColor = 'transparent';
 
                                 contentStandings.style.display = 'flex';
                                 contentBidding.style.display = 'none';
                             }
                         }
                         
                         function toggleAdminRosterTab(teamName) {
                             const clean = teamName.replace(/\s+/g, '-');
                             const el = document.getElementById('tab-roster-' + clean);
                             if (el) {
                                 if (el.style.display === 'none') {
                                     el.style.display = 'block';
                                 } else {
                                     el.style.display = 'none';
                                 }
                             }
                         }
                     </script>
                 </div>
             </div>
         </div>

         <!-- DATA MANAGEMENT MODAL -->
         <div id="dataModal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(7,11,20,0.92); z-index: 9999; justify-content: center; align-items: center; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);">
             <div class="panel animate-fade-in" style="width: 95%; max-width: 1250px; height: 85vh; display: flex; flex-direction: column; overflow: hidden; position: relative; border: 1px solid var(--border-color); background: var(--bg-dark); padding: 1.5rem 2rem; border-radius: 16px; box-shadow: var(--shadow-luxury); text-align: left;">
                 
