                 <!-- Modal Footer -->
                 <div style="display: flex; justify-content: flex-end; align-items: center; border-top: 1px solid var(--border-color); padding-top: 0.85rem; margin-top: 1rem; gap: 0.85rem; flex-shrink: 0;">
