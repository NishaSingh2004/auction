                                 <h3 style="margin: 0 0 1rem 0; font-size: 1rem; color: var(--primary); font-weight: 800; text-transform: uppercase;">📁 Add New Category</h3>
                                 <form id="addCategoryForm" class="stacked-form">
                                     <input type="hidden" name="submitAction" id="categorySubmitAction" value="add">
