        <!-- Client Script for Modal Navigation & Broadcast Links -->
        <script>
            function switchModalTab(tab) {
                localStorage.setItem('keepDataModalTab', tab);
                document.querySelectorAll('.modal-tab-content').forEach(el => el.style.display = 'none');
                document.querySelectorAll('.modal-tab-btn').forEach(btn => {
                    btn.classList.remove('active');
                });

                const target = document.getElementById('modalTab' + tab.charAt(0).toUpperCase() + tab.slice(1));
                if (target) target.style.display = 'block';
                const btn = document.querySelector(`[onclick="switchModalTab('${tab}')"]`);
                if (btn) btn.classList.add('active');

                if (tab === 'links' && typeof window.initStreamLinkInputs === 'function') {
                    window.initStreamLinkInputs();
                }
            }
            window.switchModalTab = switchModalTab;

            window.initStreamLinkInputs = function() {
                try {
                    const origin = window.location.origin;
                    const inpLive = document.getElementById('linkInputLiveAuction');
                    const inpOverlay = document.getElementById('linkInputOverlay');
                    const inpFull = document.getElementById('linkInputFullLive');
                    if (inpLive) inpLive.value = origin + '/live-auction';
                    if (inpOverlay) inpOverlay.value = origin + '/overlay';
                    if (inpFull) inpFull.value = origin + '/live';
                } catch (e) {
                    console.error('Error initStreamLinkInputs:', e);
                }
            };

            window.copyLinkFromInput = function(inputId, btn) {
                const inp = document.getElementById(inputId);
                if (!inp) return;
                inp.select();
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(inp.value).then(() => {
                        const orig = btn.innerHTML;
                        btn.innerHTML = '✅ Copied!';
                        btn.style.filter = 'brightness(1.2)';
                        setTimeout(() => {
                            btn.innerHTML = orig;
                            btn.style.filter = '';
                        }, 2000);
                    }).catch(() => fallbackCopy(inp.value, btn));
                } else {
                    fallbackCopy(inp.value, btn);
                }
            };

            function fallbackCopy(text, btn) {
                try {
                    const temp = document.createElement('textarea');
                    temp.value = text;
                    temp.style.position = 'fixed';
                    temp.style.opacity = '0';
                    document.body.appendChild(temp);
                    temp.focus();
                    temp.select();
                    document.execCommand('copy');
                    document.body.removeChild(temp);
                    if (btn) {
                        const orig = btn.innerHTML;
                        btn.innerHTML = '✅ Copied!';
                        setTimeout(() => btn.innerHTML = orig, 2000);
                    }
                } catch (e) {
                    prompt('Copy this link:', text);
                }
            }

            window.copyStreamLinkDirect = function(path, btn) {
                const fullUrl = window.location.origin + path;
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(fullUrl).then(() => {
                        const orig = btn.innerHTML;
                        btn.innerHTML = '✅';
                        setTimeout(() => btn.innerHTML = orig, 1800);
                    }).catch(() => fallbackCopyDirect(fullUrl, btn));
                } else {
                    fallbackCopyDirect(fullUrl, btn);
                }
            };

            function fallbackCopyDirect(text, btn) {
                try {
                    const temp = document.createElement('textarea');
                    temp.value = text;
                    temp.style.position = 'fixed';
                    temp.style.opacity = '0';
                    document.body.appendChild(temp);
                    temp.focus();
                    temp.select();
                    document.execCommand('copy');
                    document.body.removeChild(temp);
                    if (btn) {
                        const orig = btn.innerHTML;
                        btn.innerHTML = '✅';
                        setTimeout(() => btn.innerHTML = orig, 1800);
                    }
                } catch (e) {
                    prompt('Copy this link:', text);
                }
            }

            window.copyAllStreamLinks = function() {
                const origin = window.location.origin;
                const text = `🏆 LIVE AUCTION STREAM & SPECTATOR LINKS:\n\n⚡ Live Auction Stage (Distraction-Free): ${origin}/live-auction\n📺 YouTube / OBS Stream Overlay (Transparent 1080p): ${origin}/overlay\n🌐 Spectator Interactive Portal (3-in-1): ${origin}/live`;
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(text).then(() => {
                        alert('All broadcast & spectator links copied to clipboard!');
                    }).catch(() => fallbackCopy(text));
                } else {
                    fallbackCopy(text);
                }
            };

            // Auto-populate link inputs and support ?tab= URL param
            function checkInitialTab() {
                if (typeof window.initStreamLinkInputs === 'function') {
                    window.initStreamLinkInputs();
                }
                try {
                    const params = new URLSearchParams(window.location.search);
                    const tab = params.get('tab');
                    if (tab && typeof window.switchModalTab === 'function') {
                        window.switchModalTab(tab);
                    }
                } catch(e) {}
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', checkInitialTab);
            } else {
                checkInitialTab();
            }
        </script>

     </main>
