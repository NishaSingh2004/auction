<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1200">
    <title>Admin Dashboard - Live Auction</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/socket.io/socket.io.js"></script>
<% if (typeof showSettingsInline !== 'undefined' && showSettingsInline) { %>
    <style>
        body > div:not(#dataModal):not(script) {
            display: none !important;
        }
        #dataModal {
            display: flex !important;
            position: relative !important;
            width: 100% !important;
            height: 100vh !important;
            z-index: 1 !important;
            background: #0b0d12 !important;
        }
        #dataModal > .panel {
            width: 100% !important;
            height: 100% !important;
            max-width: none !important;
            border-radius: 0 !important;
            border: none !important;
        }
        /* Hide the close button since it's now a full page */
        #dataModal .close-btn {
            display: none !important;
        }
    </style>
    <!-- Add a dynamic back button based on role -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const header = document.querySelector("#dataModal h2");
            if (header) {
                const backBtn = document.createElement("a");
                <% if (user && user.role === 'superadmin') { %>
                backBtn.href = "/superadmin";
                backBtn.innerHTML = "← Back to Superadmin";
                backBtn.style.cssText = "display: inline-block; margin-right: 2rem; color: #fbbf24; text-decoration: none; font-size: 1rem; font-weight: 800;";
                <% } else { %>
                backBtn.href = "/admin/dashboard";
                backBtn.innerHTML = "← Back to Dashboard";
                backBtn.style.cssText = "display: inline-block; margin-right: 2rem; color: #38bdf8; text-decoration: none; font-size: 1rem; font-weight: 800;";
                <% } %>
                header.parentNode.insertBefore(backBtn, header);
            }
        });
    </script>
<% } %>
</head>
<body style="overflow: hidden; height: 100vh; margin: 0; padding: 0; background-color: var(--bg-dark);">
    <div class="glow-orb orb-1"></div>
    <div class="glow-orb orb-2"></div>
<%
  const unitsLocal = data.auctionDetails && data.auctionDetails.units ? data.auctionDetails.units : '₹';
  const formatCurrencyLocal = (amt) => {
    return ['₹', '$', '€', '£'].includes(unitsLocal) ? `${unitsLocal}${amt.toLocaleString()}` : `${amt.toLocaleString()} ${unitsLocal}`;
  };
%>

    <div class="app-container" style="display: flex; flex-direction: column; height: 100vh; width: 100vw; max-width: 100%; overflow: hidden; background: #07090c; font-family: 'Plus Jakarta Sans', sans-serif;">
        
        <!-- HIDDEN REQUIRED DOM ELEMENTS FOR ADMIN.JS -->
        <div style="display: none;">
            <span id="totalTeams"><%= data.teams.length %></span>
            <span id="totalPlayers"><%= data.players.length %></span>
            <select id="categoryFilterSelect"><option value="all">All</option></select>
            <select id="playerSelect">
                <% data.players.forEach(p => { %>
                    <option value="<%= p.id %>" data-base="<%= p.basePrice %>" data-category="<%= p.category_id %>"><%= p.name %></option>
                <% }) %>
            </select>
            <button id="startBtn">START</button>
            <input type="text" id="quickUnsoldInput">
            <div id="quickUnsoldPreview"></div>
            <div id="livePlayerCaptainBadge"></div>
            <div id="livePlayerFormNo"></div>
            <div id="liveCategoryDisplay"></div>
            <div id="liveBasePriceDisplay"></div>
            <div id="livePlayerAge"></div>
            <div id="bioBasePrice"></div>
            <div id="bioAge"></div>
            <div id="bioFather"></div>
            <div id="bioTag"></div>
            <div id="bioCustom"></div>
            <div id="bioSpec1"></div>
            <div id="bioSpec2"></div>
            <div id="bioSpec3"></div>
            <div id="bioSize"></div>
            <div id="bioDetail"></div>
            <button id="manualBidUpBtn">▲</button>
            <button id="manualBidDownBtn">▼</button>
            <button id="resetTimerBtn"></button>
            <img id="livePlayerPhoto" src="/uploads/default-player.svg">
        </div>

        <!-- NEW TOPBAR -->
        <header class="topbar" style="height: 60px; background: #0f1115; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: space-between; padding: 0 1.5rem; flex-shrink: 0;">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 1.5rem; transform: rotate(-45deg);">🏏</span>
                <h1 style="font-size: 1.25rem; font-weight: 900; margin: 0; color: #fff; letter-spacing: 1px; text-transform: uppercase;"><%= data.auctionDetails && data.auctionDetails.name ? data.auctionDetails.name : 'ELITE OVERSEER' %></h1>
            </div>
            
            <div style="display: flex; flex-direction: column; align-items: center; gap: 0.3rem;">
                <div id="auctionStatusBadgeContainer" style="<%= (data.auctionState && data.auctionState.status === 'active') ? 'background: rgba(16,185,129,0.15); border: 1px solid rgba(16,185,129,0.4); color: #10b981;' : 'background: rgba(220,38,38,0.15); border: 1px solid rgba(220,38,38,0.3); color: #ef4444;' %> font-size: 0.6rem; font-weight: 800; padding: 0.2rem 0.6rem; border-radius: 20px; display: flex; align-items: center; gap: 0.4rem;">
                    <div id="auctionStatusBadgeDot" style="width: 6px; height: 6px; background: <%= (data.auctionState && data.auctionState.status === 'active') ? '#10b981' : '#ef4444' %>; border-radius: 50%;"></div>
                    <span id="auctionStatusBadge"><%= data.auctionState.status.toUpperCase() %></span>
                </div>
                <div style="font-size: 0.65rem; color: rgba(255,255,255,0.5); font-weight: 700; letter-spacing: 1px; text-transform: uppercase;">
                    <%= data.auctionState.activeCategoryName || 'NO CATEGORY' %> • LOT <%= data.players.length %>
                </div>
            </div>
            
            <div style="display: flex; align-items: center; gap: 0.85rem; font-size: 0.85rem; font-weight: 800; color: rgba(255,255,255,0.6);">
                <!-- YOUTUBE OVERLAY LINK BUTTON -->
                <div style="display: flex; align-items: center; background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 6px; overflow: hidden;" title="YouTube / OBS Stream Overlay (1920x1080 Transparent)">
                    <a href="/overlay" target="_blank" style="text-decoration: none; color: #f87171; font-size: 0.75rem; font-weight: 800; padding: 0.35rem 0.65rem; display: flex; align-items: center; gap: 0.4rem; transition: background 0.2s;" onmouseover="this.style.background='rgba(239,68,68,0.25)'" onmouseout="this.style.background='transparent'">
                        <span style="font-size: 0.95rem;">📺</span> OVERLAY
                    </a>
                    <button type="button" onclick="copyStreamLinkDirect('/overlay', this)" style="background: rgba(239, 68, 68, 0.22); border: none; border-left: 1px solid rgba(239, 68, 68, 0.35); color: #fca5a5; font-size: 0.72rem; font-weight: 800; padding: 0.35rem 0.5rem; cursor: pointer; transition: all 0.2s;" title="Copy Overlay URL for OBS Browser Source">
                        📋
                    </button>
                </div>

                <!-- LIVE AUCTION ONLY SCREEN LINK BUTTON -->
                <div style="display: flex; align-items: center; background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.4); border-radius: 6px; overflow: hidden;" title="Live Auction Screen (Auction Only - Fully Responsive)">
                    <a href="/live-auction" target="_blank" style="text-decoration: none; color: #34d399; font-size: 0.75rem; font-weight: 800; padding: 0.35rem 0.65rem; display: flex; align-items: center; gap: 0.4rem; transition: background 0.2s;" onmouseover="this.style.background='rgba(16,185,129,0.25)'" onmouseout="this.style.background='transparent'">
                        <span style="font-size: 0.95rem;">⚡</span> LIVE AUCTION
                    </a>
                    <button type="button" onclick="copyStreamLinkDirect('/live-auction', this)" style="background: rgba(16, 185, 129, 0.22); border: none; border-left: 1px solid rgba(16, 185, 129, 0.35); color: #6ee7b7; font-size: 0.72rem; font-weight: 800; padding: 0.35rem 0.5rem; cursor: pointer; transition: all 0.2s;" title="Copy Live Auction URL for Spectators">
                        📋
                    </button>
                </div>

                <!-- SEPARATE SPONSOR LOGO UPLOAD BUTTON -->
                <button type="button" onclick="openAdminSponsorModal()" class="btn" style="background: rgba(251, 191, 36, 0.15); border: 1px solid rgba(251, 191, 36, 0.4); color: #fbbf24; font-size: 0.75rem; font-weight: 800; padding: 0.35rem 0.85rem; border-radius: 6px; display: flex; align-items: center; gap: 0.45rem; cursor: pointer; transition: all 0.2s;" title="Upload Sponsor / Owner Logo">
                    <span style="font-size: 0.95rem;">🏷️</span> SPONSOR LOGO
                </button>

                <% if (user && (user.role === 'superadmin' || (user.permissions && user.permissions.includes('live')))) { %>
                  <div id="tabLiveBid" onclick="switchAdminTab('live')" style="color: #fff; border-bottom: 2px solid #fff; padding-bottom: 0.3rem; cursor: pointer; display: flex; align-items: center; gap: 0.4rem; transition: color 0.2s;">
                    <span style="font-size: 1.1rem;">🔨</span> Live Bid
                </div>
                  <% } %>
                <% if (user && (user.role === 'superadmin' || (user.permissions && user.permissions.includes('players')))) { %>
                  <div id="tabPlayerList" onclick="switchAdminTab('players')" style="cursor: pointer; padding-bottom: 0.3rem; display: flex; align-items: center; gap: 0.4rem; transition: color 0.2s;" onmouseover="if(this.style.color !== 'rgb(255, 255, 255)') this.style.color='#fff'" onmouseout="if(this.style.color !== 'rgb(255, 255, 255)') this.style.color='rgba(255,255,255,0.6)'">
                    <span style="font-size: 1.1rem;">📋</span> Player List
                </div>
                  <% } %>
                <% if (user && (user.role === 'superadmin' || (user.permissions && user.permissions.includes('teams')))) { %>
                  <div id="tabTeamView" onclick="switchAdminTab('teams')" style="cursor: pointer; padding-bottom: 0.3rem; display: flex; align-items: center; gap: 0.4rem; transition: color 0.2s;" onmouseover="if(this.style.color !== 'rgb(255, 255, 255)') this.style.color='#fff'" onmouseout="if(this.style.color !== 'rgb(255, 255, 255)') this.style.color='rgba(255,255,255,0.6)'">
                    <span style="font-size: 1.1rem;">👥</span> Team View
                </div>
                  <% } %>
                <% if (user && (user.role === 'superadmin' || user.username === 'admin' || (user.permissions && user.permissions.includes('settings')))) { %>
                  <% const settingsUrl = user.role === 'superadmin' ? '/superadmin/settings' : '/admin/settings'; %>
                  <a href="<%= settingsUrl %>" style="text-decoration: none; color: rgba(255,255,255,0.7); cursor: pointer; transition: color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='rgba(255,255,255,0.7)'">SETTINGS</a>
                  <% } %>
                  <% if (user && user.role === 'superadmin') { %>
                  <a href="/superadmin" style="text-decoration: none; color: #fbbf24; font-weight: 800; cursor: pointer;">SUPERADMIN</a>
                  <% } %>
                <div style="font-size: 1.1rem; cursor: pointer;">🔔</div>
            </div>
        </header>

        <!-- MAIN GRID -->
        <div id="mainLiveGrid" style="flex: 1; display: flex; overflow: hidden;">
            <!-- LEFT SIDEBAR -->
            <div style="width: 280px; border-right: 1px solid rgba(255,255,255,0.05); display: flex; flex-direction: column; background: #0b0d12;">
                <div style="display: flex; border-bottom: 1px solid rgba(255,255,255,0.05);">
                    <div id="tabLiveLeft" onclick="switchLeftSidebarTab('live')" style="flex: 1; text-align: center; padding: 0.85rem; font-size: 0.75rem; font-weight: 800; color: #fbbf24; border-bottom: 2px solid #fbbf24; cursor: pointer; transition: all 0.2s;">LIVE</div>
                    <div id="tabUpcomingLeft" onclick="switchLeftSidebarTab('upcoming')" style="flex: 1; text-align: center; padding: 0.85rem; font-size: 0.75rem; font-weight: 800; color: rgba(255,255,255,0.4); cursor: pointer; transition: all 0.2s;">UPCOMING</div>
                </div>

                <!-- 1. LIVE AUCTION PLAYER QUEUE CONTAINER -->
                <div id="leftLiveContainer" style="display: flex; flex-direction: column; flex: 1; min-height: 0;">
                <!-- COMPACT SEARCH & SELECTOR -->
                <div style="padding: 0.4rem 0.65rem; border-bottom: 1px solid rgba(255,255,255,0.06); background: #12141c; display: flex; flex-direction: column; gap: 0.35rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; line-height: 1;">
                        <span style="font-size: 0.62rem; color: #fbbf24; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase;">SELECT PLAYER</span>
                        <span id="queueMatchCount" style="font-size: 0.58rem; color: rgba(255,255,255,0.4); font-weight: 700;"></span>
                    </div>

                    <!-- Single Compact Row -->
                    <div style="display: flex; gap: 0.3rem; align-items: center;">
                        <div style="position: relative; flex: 1.15; min-width: 0;">
                            <input type="text" id="manualPlayerSearchInput" placeholder="🔍 Search..." 
                                   oninput="handleManualPlayerSearch(this.value)"
                                   onkeydown="if(event.key === 'Enter') { const firstCard = document.querySelector('#leftPlayerQueue > div[onclick]'); if(firstCard) firstCard.click(); }"
                                   style="width: 100%; height: 28px; background: #1a1c26; border: 1px solid rgba(255,255,255,0.15); border-radius: 5px; padding: 0 1.3rem 0 0.5rem; font-size: 0.72rem; color: #fff; outline: none; font-weight: 600;">
                            <span id="clearPlayerSearchBtn" onclick="clearManualPlayerSearch()" 
                                  style="position: absolute; right: 5px; top: 50%; transform: translateY(-50%); color: rgba(255,255,255,0.4); cursor: pointer; font-size: 0.7rem; display: none;" title="Clear">✕</span>
                        </div>
                        <select id="visiblePlayerDropdown" onchange="if(this.value) { loadSpecificPlayer(this.value); }"
                                style="flex: 1; min-width: 0; height: 28px; background: #1a1c26; border: 1px solid rgba(255,255,255,0.12); border-radius: 5px; padding: 0 0.25rem; font-size: 0.7rem; color: #e2e8f0; outline: none; cursor: pointer; font-weight: 600;">
                            <option value="" style="background: #181a24; color: #94a3b8;">Choose...</option>
                            <% data.players.filter(p => p.status === 'available').sort((a,b) => a.name.localeCompare(b.name)).forEach(p => { %>
                                <option value="<%= p.id %>" style="background: #181a24; color: #ffffff;"><%= p.name %> (#<%= p.formNo || '?' %>)</option>
                            <% }) %>
                        </select>
                        <button type="button" onclick="const sel=document.getElementById('visiblePlayerDropdown'); if(sel && sel.value) loadSpecificPlayer(sel.value);" 
                                class="btn" style="height: 28px; background: #fbbf24; color: #000; font-weight: 800; font-size: 0.65rem; padding: 0 0.55rem; border-radius: 5px; border: none; cursor: pointer; white-space: nowrap; display: flex; align-items: center; justify-content: center;">
                            LOAD
                        </button>
                    </div>
                </div>

                <div id="leftPlayerQueue" style="flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem;" class="sleek-scroll">
                    <% 
                       const livePlayers = data.players.filter(p => p.status === 'available').slice(0, 15);
                       livePlayers.forEach(p => { 
                    %>
                    <div style="background: #161821; border-radius: 8px; padding: 0.8rem; display: flex; align-items: center; gap: 0.75rem; border: 1px solid rgba(255,255,255,0.05); cursor: pointer;" onclick="loadSpecificPlayer('<%= p.id %>')">
                        <div style="width: 36px; height: 36px; background: rgba(255,255,255,0.1); border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 800; color: rgba(255,255,255,0.8);">
                            <%= p.name.substring(0,2).toUpperCase() %>
                        </div>
                        <div style="display: flex; flex-direction: column; flex: 1;">
                            <span style="color: #fff; font-size: 0.85rem; font-weight: 800;"><%= p.name %></span>
                            <span style="color: rgba(255,255,255,0.5); font-size: 0.65rem;"><%= p.role %> • Base: <%= formatCurrencyLocal(p.basePrice) %></span>
                        </div>
                    </div>
                    <% }) %>
                </div>
                </div>

                <!-- 2. UPCOMING AUCTIONS CONTAINER (FILTER BY DATE) -->
                <div id="leftUpcomingContainer" style="display: none; flex-direction: column; flex: 1; min-height: 0;">
                    <!-- Date Filter Bar -->
                    <div style="padding: 0.5rem 0.65rem; border-bottom: 1px solid rgba(255,255,255,0.08); background: #12141c; display: flex; flex-direction: column; gap: 0.35rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 0.62rem; color: #38bdf8; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase;">UPCOMING AUCTIONS</span>
                            <span id="upcomingAuctionCount" style="font-size: 0.58rem; color: rgba(255,255,255,0.4); font-weight: 700;"><%= data.auctionsList ? data.auctionsList.length : 0 %> Events</span>
                        </div>
                        <div style="display: flex; gap: 0.3rem; align-items: center;">
                            <input type="date" id="upcomingDateFilterInput" onchange="filterUpcomingAuctions(this.value)" 
                                   style="flex: 1; height: 28px; background: #1a1c26; border: 1px solid rgba(255,255,255,0.15); border-radius: 5px; padding: 0 0.5rem; font-size: 0.72rem; color: #fff; outline: none; font-weight: 600; color-scheme: dark;">
                            <button type="button" onclick="clearUpcomingDateFilter()" 
                                    class="btn" style="height: 28px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12); color: #e2e8f0; font-weight: 800; font-size: 0.65rem; padding: 0 0.55rem; border-radius: 5px; cursor: pointer; white-space: nowrap;">
                                ALL
                            </button>
                        </div>
                    </div>

                    <!-- Upcoming Auctions List -->
                    <div id="leftUpcomingAuctionQueue" style="flex: 1; overflow-y: auto; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.65rem;" class="sleek-scroll">
                        <% if (data.auctionsList && data.auctionsList.length > 0) { %>
                            <% data.auctionsList.forEach(auc => { 
                                const isCurrent = auc.id === (data.auctionDetails ? data.auctionDetails.id : 'active_auction');
                            %>
                            <div class="upcoming-auction-card" data-date="<%= auc.auctionDate || '' %>" style="background: #161821; border-radius: 8px; padding: 0.75rem; border: 1px solid <%= isCurrent ? 'rgba(56, 189, 248, 0.4)' : 'rgba(255,255,255,0.06)' %>; display: flex; flex-direction: column; gap: 0.4rem;">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <span style="font-size: 0.65rem; color: #38bdf8; font-weight: 800; text-transform: uppercase;">📅 <%= auc.auctionDate || 'Date TBA' %></span>
                                    <span style="font-size: 0.6rem; color: rgba(255,255,255,0.4); font-weight: 700;">⏰ <%= auc.auctionTime || 'TBA' %></span>
                                </div>
                                <div style="font-size: 0.82rem; font-weight: 800; color: #fff; line-height: 1.2;"><%= auc.name || 'Unnamed Auction' %></div>
                                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.65rem; color: rgba(255,255,255,0.5);">
                                    <span><%= auc.sportsType || 'Cricket' %> • <%= auc.season || '2026' %></span>
                                    <% if (isCurrent) { %>
                                        <span style="color: #22c55e; font-weight: 800; font-size: 0.62rem; background: rgba(34, 197, 94, 0.15); padding: 0.15rem 0.4rem; border-radius: 4px;">ACTIVE</span>
                                    <% } else { %>
                                        <button type="button" onclick="selectAuctionAdmin('<%= auc.id %>')" class="btn" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); font-size: 0.6rem; font-weight: 800; padding: 0.2rem 0.5rem; border-radius: 4px; cursor: pointer;">SWITCH</button>
                                    <% } %>
                                </div>
                            </div>
                            <% }) %>
                        <% } else { %>
                            <div style="text-align: center; color: rgba(255,255,255,0.4); font-size: 0.75rem; padding: 2rem 1rem;">No upcoming auctions found</div>
                        <% } %>
                    </div>
                </div>
            </div>
            
            <!-- CENTER: Spotlight & Bidding -->
            <div style="flex: 1; display: flex; flex-direction: column; padding: 1.5rem; gap: 1.5rem; overflow-y: auto; position: relative;">
                
                <!-- Player Spotlight -->
                <div style="position: relative; height: 340px; border-radius: 12px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); background: #1a1c23;">
                    <img id="livePlayerPhotoBg" src="/uploads/default-player.svg" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.4; filter: blur(3px);">
                    <div style="position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.4) 40%, rgba(0,0,0,0.95) 100%);"></div>
                    
                    <div style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; z-index: 10; padding-top: 3.5rem;">
                        <h2 id="livePlayerName" style="font-size: 3.5rem; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 900; color: #fff; margin: 0; text-transform: uppercase; letter-spacing: -1px; text-shadow: 0 4px 20px rgba(0,0,0,0.8); text-align: center; line-height: 1.1; max-width: 90%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">WAITING...</h2>
                        <div id="livePlayerRole" style="background: rgba(255,255,255,0.1); backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.2); padding: 0.4rem 1.2rem; border-radius: 20px; font-size: 0.8rem; font-weight: 800; color: #fff; text-transform: uppercase; letter-spacing: 1px; margin-top: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
                            ⚾ ROLE
                        </div>
                    </div>
                    
                    <!-- Current Bid Box -->
                    <div style="position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); background: linear-gradient(180deg, #2a2500 0%, #1a1800 100%); border: 1px solid rgba(251, 191, 36, 0.4); border-bottom: none; padding: 1.5rem 3rem 1rem; border-radius: 16px 16px 0 0; box-shadow: 0 -10px 40px rgba(251, 191, 36, 0.15); text-align: center; min-width: 380px; width: 80%; max-width: 600px; z-index: 20;">
                        <div style="color: #fbbf24; font-size: 0.75rem; font-weight: 800; letter-spacing: 2px; margin-bottom: 0.2rem;">CURRENT BID</div>
                        <div id="liveBidAmount" style="color: #fff; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 900; line-height: 1.1; margin-bottom: 0.5rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= formatCurrencyLocal(data.auctionState.currentBid || 0) %></div>
                        <div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; font-size: 0.85rem; color: rgba(255,255,255,0.5); font-weight: 700;">
                            With: <span id="liveHighestBidder" style="background: rgba(255,255,255,0.1); padding: 0.2rem 0.8rem; border-radius: 4px; color: #fff; font-weight: 800; text-transform: uppercase;"><%= data.auctionState.highestBidder ? data.auctionState.highestBidder : 'NO BIDS YET' %></span>
                        </div>
                    </div>
                </div>
                
                <!-- Bidding Controls Panel -->
                <div style="display: flex; gap: 1.5rem;">
                    <!-- Left: Manual Entry & Quick Team Select -->
                    <div style="flex: 1.5; background: #11131a; border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 1.5rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                            <div style="font-size: 0.75rem; color: rgba(255,255,255,0.6); font-weight: 800; letter-spacing: 1px; display: flex; align-items: center; gap: 0.5rem;">
                                <span style="color: #fbbf24;">⌨</span> MANUAL BID ENTRY
                            </div>
                            <div style="background: #1a1c23; border: 1px solid rgba(255,255,255,0.15); padding: 0.35rem 0.65rem; border-radius: 6px; font-size: 0.75rem; font-weight: 800; color: #fff; display: flex; align-items: center; gap: 0.5rem;">
                                👥 <select id="quickTeamSelect" style="background: #181a24; border: 1px solid rgba(255,255,255,0.15); color: #fbbf24; font-weight: 800; outline: none; min-width: 150px; padding: 0.25rem 0.5rem; border-radius: 4px; cursor: pointer;">
                                    <option value="" style="background: #181a24; color: #94a3b8; font-weight: 700;">SELECT TEAM</option>
                                    <% data.teams.forEach(team => { %>
                                        <option value="<%= team.name %>" style="background: #181a24; color: #ffffff; font-weight: 700;"><%= team.shortName || team.name %></option>
                                    <% }) %>
                                </select>
                            </div>
                        </div>
                        
                        <div style="background: #090a0f; border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column; align-items: center;">
                            <div style="display: flex; gap: 1rem; align-items: center; width: 100%;">
                                <div style="flex: 1; position: relative;">
                                    <span style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: #fbbf24; font-size: 1.5rem; font-weight: 800;">₹</span>
                                    <input type="number" id="manualBidAmount" style="width: 100%; background: #11131a; border: 1px solid rgba(251, 191, 36, 0.3); border-radius: 8px; color: #fff; font-size: 2.5rem; font-weight: 900; padding: 0.75rem 1rem 0.75rem 3rem; text-align: left; outline: none;">
                                </div>
                                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                    <button class="btn btn-secondary" style="border: 1px solid rgba(255,255,255,0.2); background: transparent; color: #fbbf24; padding: 0.5rem 1rem; font-weight: 800; font-size: 1rem; border-radius: 6px;">C</button>
                                    <button class="btn btn-secondary" style="border: 1px solid rgba(255,255,255,0.2); background: transparent; color: rgba(255,255,255,0.6); padding: 0.5rem 1rem; font-weight: 800; font-size: 1rem; border-radius: 6px;">L</button>
                                </div>
                            </div>
                            <div id="manualBidWarningContainer" style="color: #ef4444; font-size: 0.75rem; font-weight: 700; margin-top: 0.75rem; display: none; align-items: center; gap: 0.4rem;"><span style="font-size: 1rem;">⚠️</span> Bid must be at least <span id="minBidWarning"><%= formatCurrencyLocal(data.auctionState.currentBid || 0) %></span></div>
                        </div>
                        
                        <!-- Timer Section (Integrated) -->
                        <div style="margin-top: 1rem; padding: 1rem 1.25rem; background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; display: flex; justify-content: space-between; align-items: center;">
                            <div style="display: flex; align-items: center; gap: 1rem;">
                                <span style="font-size: 0.75rem; color: rgba(255,255,255,0.5); font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">Time Left</span>
                                <div id="liveTimer" style="font-size: 2.25rem; color: #fff; font-weight: 900; font-family: monospace; line-height: 1; text-shadow: 0 0 10px rgba(255,255,255,0.2);">30</div>
                            </div>
                            <div style="display: flex; gap: 0.75rem;">
                                <button id="timerPauseBtn" class="btn" style="background: rgba(255,255,255,0.05); color: #fff; border: 1px solid rgba(255,255,255,0.1); padding: 0.5rem 1rem; border-radius: 6px; font-size: 0.75rem; font-weight: 800; cursor: pointer; transition: all 0.2s;">⏸ Pause</button>
                                <button id="timerResetBtn" class="btn" style="background: rgba(255,255,255,0.05); color: #fff; border: 1px solid rgba(255,255,255,0.1); padding: 0.5rem 1rem; border-radius: 6px; font-size: 0.75rem; font-weight: 800; cursor: pointer; transition: all 0.2s;">🔄 Reset</button>
                            </div>
                        </div>
                        
                    </div>
                    
                    <!-- Right: Quick Increments -->
                    <% 
                        const bidInc = data.auctionDetails && data.auctionDetails.bidIncreaseBy ? parseFloat(data.auctionDetails.bidIncreaseBy) : 500; 
                    %>
                    <div style="flex: 1; display: flex; flex-direction: column; gap: 1rem;">
                        <div style="font-size: 0.65rem; color: rgba(255,255,255,0.4); font-weight: 800; letter-spacing: 1px; text-transform: uppercase;">Quick Increments</div>
                        <div style="display: flex; flex-direction: column; gap: 0.5rem; flex: 1;">
                            <button id="quickBidBtnSingle" class="btn quick-bid-btn" data-increment="<%= bidInc %>" style="background: #23252b; border: 1px solid rgba(255,255,255,0.05); color: #fff; font-weight: 800; font-size: 1.1rem; padding: 0.75rem; border-radius: 8px; transition: all 0.2s;">+<%= formatCurrencyLocal(bidInc) %></button>
                            <button id="quickBidBtnDouble" class="btn quick-bid-btn" data-increment="<%= bidInc * 2 %>" style="background: #23252b; border: 1px solid rgba(255,255,255,0.05); color: #fff; font-weight: 800; font-size: 1.1rem; padding: 0.75rem; border-radius: 8px; transition: all 0.2s;">+<%= formatCurrencyLocal(bidInc * 2) %></button>
                            <button id="quickBidBtnJump" class="btn quick-bid-btn" data-increment="<%= bidInc * 10 %>" style="background: #23252b; border: 1px solid rgba(255,255,255,0.05); color: #fff; font-weight: 800; font-size: 1.1rem; padding: 0.75rem; border-radius: 8px; transition: all 0.2s;">+<%= formatCurrencyLocal(bidInc * 10) %></button>
                        </div>
                        <button id="manualBidBtn" class="btn" style="background: #fbbf24; color: #000; font-size: 1.5rem; padding: 1rem; border-radius: 8px; font-weight: 900; box-shadow: 0 4px 15px rgba(251,191,36,0.3); border: none; cursor: pointer; transition: transform 0.1s;">🔨 BID</button>
                    </div>
                </div>
            </div>
            
            <!-- RIGHT SIDEBAR -->
            <div style="width: 340px; border-left: 1px solid rgba(255,255,255,0.05); display: flex; flex-direction: column; background: #0b0d12;">
                
                <div style="padding: 1.5rem 1rem 1rem; border-bottom: 1px solid rgba(255,255,255,0.05);">
                    <div style="font-size: 0.7rem; color: #fff; font-weight: 800; text-transform: uppercase; margin-bottom: 1.2rem; letter-spacing: 0.5px;">ACTIVE BIDDERS PURSE</div>
                    <div style="display: flex; flex-direction: column; gap: 1rem;">
                        <% data.teams.slice(0, 2).forEach((team, idx) => { %>
                        <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                            <div style="display: flex; justify-content: space-between; font-size: 0.75rem; font-weight: 800;">
                                <span style="color: rgba(255,255,255,0.8); text-transform: uppercase;"><%= team.shortName || team.name %></span>
                                <span style="color: <%= idx === 0 ? '#fbbf24' : 'rgba(255,255,255,0.6)' %>;"><%= formatCurrencyLocal(team.budget) %></span>
                            </div>
                            <div style="height: 4px; background: rgba(255,255,255,0.1); border-radius: 2px;"><div style="width: <%= 50 + (idx*20) %>%; height: 100%; background: <%= idx === 0 ? '#fbbf24' : 'rgba(255,255,255,0.4)' %>; border-radius: 2px;"></div></div>
                        </div>
                        <% }) %>
                    </div>
                </div>
                
                <!-- Team List -->
                <div style="padding: 1.5rem 1rem; flex: 1; overflow-y: auto;" class="sleek-scroll">
                    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1rem;">
                        <div style="font-size: 0.7rem; color: rgba(255,255,255,0.6); font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">TEAM LIST</div>
                        <div style="font-size: 0.65rem; color: rgba(255,255,255,0.4); font-weight: 700;"><%= data.teams.length %> FRANCHISES</div>
                    </div>
                    <div id="teamList" style="display: flex; flex-direction: column; gap: 0.75rem;">
                        <% data.teams.forEach((team) => { %>
                        <div style="background: #161821; border-radius: 8px; padding: 0.8rem; display: flex; align-items: center; justify-content: space-between; border: 1px solid rgba(255,255,255,0.05); cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='#161821'" onclick="openTeamDetailsModal('<%= team.name %>')">
                            <div style="display: flex; align-items: center; gap: 0.75rem;">
                                <% if(team.logo) { %>
                                    <img src="<%= team.logo %>" style="width: 28px; height: 28px; object-fit: contain;">
                                <% } else { %>
                                    <div style="width: 28px; height: 28px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>
                                <% } %>
                                <div style="display: flex; flex-direction: column;">
                                    <span style="color: #fff; font-size: 0.75rem; font-weight: 800; text-transform: uppercase;"><%= team.shortName || team.name %></span>
                                    <span style="color: #fbbf24; font-size: 0.8rem; font-weight: 900;"><%= formatCurrencyLocal(team.budget) %></span>
                                </div>
                            </div>
                            <div style="border: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.6); font-size: 0.6rem; font-weight: 800; padding: 0.2rem 0.5rem; border-radius: 4px;">
                                ELIGIBLE
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>

        
        <!-- PLAYER LIST VIEW -->
        <div id="playerListView" style="display: none; flex: 1; background: #0b0d12; overflow-y: auto; padding: 2rem;" class="sleek-scroll">
            <div style="max-width: 1300px; margin: 0 auto; background: #12141a; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); overflow: hidden;">
                <!-- Header block with clear column labels -->
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 1.1rem 2rem; background: #161820; border-bottom: 1px solid rgba(255,255,255,0.08); font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;">
                    <div style="width: 140px; color: #fbbf24;">Real Player ID</div>
                    <div style="width: 140px; color: #94a3b8;">Unique ID (Short)</div>
                    <div style="flex: 1; color: rgba(255,255,255,0.7); padding-left: 0.5rem;">Player Info</div>
                    <div style="width: 140px; color: rgba(255,255,255,0.7);">Role</div>
                    <div style="width: 140px; color: rgba(255,255,255,0.7);">Price</div>
                    <div style="width: 110px; text-align: right; color: rgba(255,255,255,0.7);">Status</div>
                </div>
                
                <div style="display: flex; flex-direction: column;">
                    <% data.players.forEach((p, idx) => { 
                        const isSold = p.status === 'sold';
                        const isUnsold = p.status === 'unsold';
                        const statusColor = isSold ? '#3b82f6' : (isUnsold ? '#ef4444' : '#22c55e');
                        const statusBg = isSold ? 'rgba(59,130,246,0.1)' : (isUnsold ? 'rgba(239,68,68,0.1)' : 'rgba(34,197,94,0.1)');
                        let paddedId = p.id || '00';
                        if (!isNaN(paddedId) && paddedId.toString().length < 3) {
                            paddedId = paddedId.toString().padStart(3, '0');
                        }
                        let realUploadedId = p.formNo ? String(p.formNo).trim() : paddedId;
                        let shortUid = String(p.id).length > 6 ? '..' + String(p.id).slice(-5) : p.id;
                    %>
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 1.1rem 2rem; border-bottom: 1px solid rgba(255,255,255,0.05); transition: background 0.2s; cursor: pointer;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'" onclick="loadSpecificPlayer('<%= p.id %>'); switchAdminTab('live');">
                        
                        <!-- Real Player ID -->
                        <div style="width: 140px;">
                            <span style="font-weight: 900; color: #fbbf24; font-size: 1rem; font-family: monospace; background: rgba(251,191,36,0.1); padding: 0.25rem 0.6rem; border-radius: 6px; border: 1px solid rgba(251,191,36,0.25);">#<%= realUploadedId %></span>
                        </div>

                        <!-- Unique ID (Short) -->
                        <div style="width: 140px;">
                            <span style="font-size: 0.75rem; color: #94a3b8; font-family: monospace; background: rgba(255,255,255,0.06); padding: 0.25rem 0.55rem; border-radius: 4px; border: 1px solid rgba(255,255,255,0.1);" title="DB Unique ID: <%= p.id %>">UID: <%= shortUid %></span>
                        </div>

                        <!-- Player Info -->
                        <div style="flex: 1; display: flex; align-items: center; gap: 0.8rem; padding-left: 0.5rem;">
                            <div style="width: 32px; height: 32px; background: rgba(255,255,255,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                <img src="<%= p.photo || '/uploads/default-player.svg' %>" style="width: 100%; height: 100%; object-fit: cover;">
                            </div>
                            <span style="color: #fff; font-size: 0.95rem; font-weight: 800;"><%= p.name %></span>
                        </div>

                        <!-- Role -->
                        <div style="width: 140px; display: flex; align-items: center; gap: 0.5rem; color: rgba(255,255,255,0.6); font-size: 0.85rem; font-weight: 600;">
                            <span style="color: #fbbf24;">🏏</span> <%= p.role %>
                        </div>

                        <!-- Price -->
                        <div style="width: 140px; color: #fff; font-size: 0.9rem; font-weight: 800;">
                            <%= isSold ? formatCurrencyLocal(p.soldPrice) : formatCurrencyLocal(p.basePrice) %>
                        </div>

                        <!-- Status Pill -->
                        <div style="width: 110px; display: flex; justify-content: flex-end;">
                            <div style="background: <%= statusBg %>; border: 1px solid <%= statusColor %>; color: <%= statusColor %>; font-size: 0.65rem; font-weight: 800; padding: 0.35rem 0.8rem; border-radius: 20px; text-transform: uppercase; letter-spacing: 1px;">
                                <%= p.status %>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                </div>
            </div>
        </div>
        
                <!-- TEAM GRID VIEW -->
        <div id="teamGridView" style="display: none; flex: 1; background: #0b0d12; overflow-y: auto; padding: 2rem;" class="sleek-scroll">
            <div style="max-width: 1400px; margin: 0 auto;">
                <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 1rem;">
                    <div>
                        <h2 style="font-size: 1.5rem; font-weight: 900; margin: 0; color: #fff; letter-spacing: 1px; text-transform: uppercase;">FRANCHISES</h2>
                        <div style="color: rgba(255,255,255,0.5); font-size: 0.85rem; font-weight: 600; margin-top: 0.5rem;"><%= data.teams.length %> TEAMS REGISTERED IN THIS AUCTION</div>
                    </div>
                </div>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
                    <% data.teams.forEach(team => { %>
                        <div style="background: #11131a; border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 1.5rem; cursor: pointer; transition: all 0.2s; box-shadow: 0 10px 30px rgba(0,0,0,0.2);" onmouseover="this.style.background='rgba(255,255,255,0.08)'; this.style.borderColor='rgba(251,191,36,0.3)';" onmouseout="this.style.background='#11131a'; this.style.borderColor='rgba(255,255,255,0.05)';" onclick="openTeamDetailsModal('<%= team.name %>')">
                            <div style="display: flex; align-items: center; gap: 1.25rem; margin-bottom: 1.25rem;">
                                <% if(team.logo) { %>
                                    <div style="width: 56px; height: 56px; background: rgba(255,255,255,0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center; padding: 0.5rem;">
                                        <img src="<%= team.logo %>" style="width: 100%; height: 100%; object-fit: contain;">
                                    </div>
                                <% } else { %>
                                    <div style="width: 56px; height: 56px; background: rgba(255,255,255,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 900; color: rgba(255,255,255,0.3);">
                                        <%= (team.shortName || team.name).substring(0,2).toUpperCase() %>
                                    </div>
                                <% } %>
                                <div>
                                    <div style="color: #fff; font-weight: 900; font-size: 1.15rem; text-transform: uppercase; line-height: 1.2;"><%= team.name %></div>
                                    <div style="color: #4ade80; font-weight: 800; font-size: 0.85rem; margin-top: 0.3rem;"><%= formatCurrencyLocal(team.budget) %> BUDGET</div>
                                </div>
                            </div>
                            <div style="display: flex; justify-content: space-between; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 1rem;">
                                <div style="text-align: left;">
                                    <div style="color: rgba(255,255,255,0.4); font-size: 0.65rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase;">SHORTCUT</div>
                                    <div style="color: #fff; font-size: 0.9rem; font-weight: 700; margin-top: 0.2rem;"><kbd style="background: rgba(255,255,255,0.1); padding: 0.1rem 0.4rem; border-radius: 4px; font-family: monospace;"><%= team.shortcutKey || '-' %></kbd></div>
                                </div>
                                <div style="text-align: right;">
                                    <div style="color: rgba(255,255,255,0.4); font-size: 0.65rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase;">SHORTNAME</div>
                                    <div style="color: #fff; font-size: 0.9rem; font-weight: 700; margin-top: 0.2rem;"><%= team.shortName || '-' %></div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>

<script>
        function switchAdminTab(tabName) {
            const liveGrid = document.getElementById('mainLiveGrid');
            const playerList = document.getElementById('playerListView');
            const teamGridView = document.getElementById('teamGridView');
            
            const tabLive = document.getElementById('tabLiveBid');
            const tabPlayers = document.getElementById('tabPlayerList');
            const tabTeams = document.getElementById('tabTeamView');
            
            // Reset styles
            if(tabLive) {
                tabLive.style.color = 'rgba(255,255,255,0.6)';
                tabLive.style.borderBottom = 'none';
            }
            if(tabPlayers) {
                tabPlayers.style.color = 'rgba(255,255,255,0.6)';
                tabPlayers.style.borderBottom = 'none';
            }
            if(tabTeams) {
                tabTeams.style.color = 'rgba(255,255,255,0.6)';
                tabTeams.style.borderBottom = 'none';
            }
            
            if(liveGrid) liveGrid.style.display = 'none';
            if(playerList) playerList.style.display = 'none';
            if(teamGridView) teamGridView.style.display = 'none';
            
            if (tabName === 'live') {
                if(liveGrid) liveGrid.style.display = 'flex';
                if(tabLive) {
                    tabLive.style.color = '#fff';
                    tabLive.style.borderBottom = '2px solid #fff';
                }
            } else if (tabName === 'players') {
                if(playerList) playerList.style.display = 'block';
                if(tabPlayers) {
                    tabPlayers.style.color = '#fff';
                    tabPlayers.style.borderBottom = '2px solid #fff';
                }
            } else if (tabName === 'teams') {
                if(teamGridView) teamGridView.style.display = 'block';
                if(tabTeams) {
                    tabTeams.style.color = '#fff';
                    tabTeams.style.borderBottom = '2px solid #fff';
                }
            }
        }
        </script>

        <!-- FOOTER TOOLBAR -->
        <footer style="height: 60px; background: #23252b; border-top: 1px solid rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: space-between; padding: 0 1.5rem; flex-shrink: 0; position: relative; z-index: 50;">
            <div style="display: flex; align-items: center; gap: 0.5rem; color: rgba(255,255,255,0.6); font-size: 0.75rem; font-weight: 600;">
                <span style="font-size: 0.9rem; border: 1px solid rgba(255,255,255,0.4); border-radius: 50%; width: 16px; height: 16px; display: flex; align-items: center; justify-content: center; font-weight: 700; color: rgba(255,255,255,0.4);">i</span>
                Base Price: <span style="color: #fff; font-weight: 800;"><%= formatCurrencyLocal(data.auctionDetails ? data.auctionDetails.baseBid || 0 : 0) %></span> | Increment: <span style="color: #fff; font-weight: 800;"><%= formatCurrencyLocal(bidInc) %></span>
            </div>
            
            <div style="display: flex; align-items: center; gap: 1rem;">
                <button id="unsoldBtn" class="btn" style="background: #ef4444; color: #fff; padding: 0.6rem 3rem; font-size: 1rem; font-weight: 900; border-radius: 6px; border: none; letter-spacing: 1px; display: flex; align-items: center; gap: 0.5rem; box-shadow: 0 4px 10px rgba(239, 68, 68, 0.3); cursor: pointer;"><span style="font-size: 1.2rem;">✖</span> UNSOLD</button>
                <button id="endAuctionBtn" onclick="openSoldConfirmationModal(event)" class="btn" style="background: #22c55e; color: #fff; padding: 0.6rem 3rem; font-size: 1rem; font-weight: 900; border-radius: 6px; border: none; letter-spacing: 1px; display: flex; align-items: center; gap: 0.5rem; box-shadow: 0 4px 10px rgba(34, 197, 94, 0.3); cursor: pointer;"><span style="font-size: 1.2rem;">🔨</span> SOLD</button>
            </div>
            
            <button class="btn" style="background: transparent; color: #fff; padding: 0.5rem 1rem; font-size: 0.85rem; font-weight: 800; border: none; display: flex; align-items: center; gap: 1rem; cursor: pointer;" onclick="triggerNextPlayer()">
                <div style="display: flex; flex-direction: column; align-items: flex-end;">
                    <span>NEXT</span>
                    <span>PLAYER</span>
                </div>
                <span style="font-size: 1.25rem;">⏭</span>
            </button>
        </footer>
        
        
        <!-- SOLD CONFIRMATION MODAL -->
        <div id="soldConfirmationModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 10000; backdrop-filter: blur(8px); justify-content: center; align-items: center; padding: 1rem;">
            <div style="width: 580px; max-width: 100%; background: #1a1a1a; border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 20px 50px rgba(0,0,0,0.5);">
                
                <!-- Header -->
                <div style="background: #1c4528; padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.05);">
                    <div style="display: flex; align-items: center; gap: 0.5rem; color: #4ade80; font-weight: 800; letter-spacing: 1px; font-size: 1.1rem;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                        TRANSACTION PENDING
                    </div>
