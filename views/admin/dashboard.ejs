                                         <input type="number" name="reserveBid" value="0" class="form-control" style="border-radius: 8px !important;">
                                     </div>

                                     <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Highest Bid (per Player):</label>
                                         <input type="number" name="highestBidPerPlayer" value="0" class="form-control" style="border-radius: 8px !important;">
                                     </div>

                                     <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                                         <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Category Highest Bid (all Players):</label>
                                         <input type="number" name="categoryHighestBidAll" value="0" class="form-control" style="border-radius: 8px !important;">
                                     </div>

                                     <div style="display: flex; flex-direction: column; gap: 0.3rem; width: 100px;">
                                         <label style="font-size: 0.76rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Category Color:</label>
                                         <div style="display: flex; align-items: center; justify-content: center; background: var(--bg-dark); border: 1px solid var(--border-color); padding: 0.3rem; border-radius: 8px; height: 38px;">
                                             <input type="color" name="color" value="#ffffff" style="border: none; background: none; width: 28px; height: 28px; cursor: pointer; padding: 0;" title="Category Color">
                                         </div>
                                     </div>

                                     <div style="display: flex; gap: 0.5rem; margin-top: 1rem;">
                                         <button type="submit" id="saveNewCategoryBtn" onclick="document.getElementById('categorySubmitAction').value='add_and_new'" class="btn btn-primary" style="flex: 1.2; padding: 0.55rem; font-size: 0.8rem;">SAVE & NEW</button>
                                         <button type="submit" id="addCategoryBtn" onclick="document.getElementById('categorySubmitAction').value='add'" class="btn btn-secondary" style="flex: 1; padding: 0.55rem; font-size: 0.8rem;">SAVE</button>
                                     </div>
                                 </form>
                             </div>
                             <div class="panel" style="background: rgba(15, 23, 42, 0.3); padding: 1.25rem; overflow-y: auto; max-height: 70vh; border-radius: 12px;">
                                 <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.4rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">
                                     <h3 style="margin: 0; font-size: 1rem; color: var(--primary); font-weight: 800; text-transform: uppercase;">Existing Categories</h3>
                                     <div style="display: flex; gap: 0.35rem;">
                                         <button type="button" onclick="openBulkAddModal()" class="btn btn-secondary" style="padding: 0.3rem 0.65rem; font-size: 0.72rem; font-weight: 700; border-radius: 6px;">📁 Bulk Add</button>
                                         <button type="button" onclick="openBulkRemoveModal()" class="btn btn-danger" style="padding: 0.3rem 0.65rem; font-size: 0.72rem; font-weight: 700; background: rgba(239,68,68,0.12); color: #f87171; border: 1px solid rgba(239,68,68,0.25); border-radius: 6px;">🗑️ Bulk Remove</button>
                                     </div>
                                 </div>
                                 <div id="modalCategoryList" style="display: flex; flex-direction: column; gap: 0.5rem;">
                                     <% data.categories.forEach(cat => { %>
                                         <% 
                                             const catPlayers = cat.id.startsWith('cat_all_')
                                                 ? data.players.filter(p => p.status === 'sold')
                                                 : data.players.filter(p => p.category_id === cat.id && p.status === 'sold');
                                             const totalSold = catPlayers.reduce((sum, p) => sum + (p.soldPrice || 0), 0);
                                             const soldCount = catPlayers.length;
                                             const avgPrice = soldCount > 0 ? (totalSold / soldCount) : 0;
                                             const currency = data.auctionDetails && data.auctionDetails.units ? data.auctionDetails.units : '₹';
                                             
                                             const minPlayers = cat.id.startsWith('cat_all_') 
                                                 ? (data.auctionDetails ? (data.auctionDetails.playersPerTeamMin || 0) : 0)
                                                 : (cat.minPlayers || 0);
                                             const maxPlayers = cat.id.startsWith('cat_all_') 
                                                 ? (data.auctionDetails ? (data.auctionDetails.playersPerTeamMax || 0) : 0)
                                                 : (cat.maxPlayers || 0);
                                             const baseBid = cat.id.startsWith('cat_all_') 
                                                 ? (data.auctionDetails ? (data.auctionDetails.baseBid || 0) : 0)
                                                 : (cat.baseBid || 0);
                                         %>
                                         <div class="list-item" style="display: flex; justify-content: space-between; align-items: center; padding: 0.65rem 0.85rem; background: rgba(15, 23, 42, 0.45); border-radius: 8px; border-left: 4px solid <%= cat.color %>; border: 1px solid var(--border-color);">
                                             <div style="display: flex; flex-direction: column; gap: 0.15rem; text-align: left;">
