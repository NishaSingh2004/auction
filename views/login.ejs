<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Live Auction - Login</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        @keyframes pulseDot {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.3); opacity: 0.6; }
        }
        .live-btn-glow {
            animation: pulseDot 2s ease-in-out infinite;
        }
    </style>
</head>
<body style="display: flex; flex-direction: column; min-height: 100vh; justify-content: center; align-items: center; padding: 1.5rem; background-color: var(--bg-dark);">
    <div class="glow-orb orb-1"></div>
    <div class="glow-orb orb-2"></div>
    
    <div class="login-container panel animate-fade-in" style="width: 100%; max-width: 420px; text-align: center; border: 1px solid var(--border-color); background: rgba(17, 24, 39, 0.85); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); padding: 2.5rem 2rem; box-shadow: var(--shadow-luxury); border-radius: 20px;">
        
        <!-- Live Spectator Quick Action -->
        <a href="/live" style="display: flex; align-items: center; justify-content: center; gap: 0.6rem; padding: 0.8rem 1rem; border-radius: 12px; background: linear-gradient(135deg, rgba(239, 68, 68, 0.18), rgba(245, 158, 11, 0.15)); border: 1px solid rgba(239, 68, 68, 0.4); color: #fca5a5; text-decoration: none; font-weight: 800; font-size: 0.9rem; letter-spacing: 0.5px; margin-bottom: 1.8rem; box-shadow: 0 4px 15px rgba(239, 68, 68, 0.15); transition: transform 0.2s ease;">
            <span class="live-btn-glow" style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: #ef4444; box-shadow: 0 0 10px #ef4444;"></span>
            <span>WATCH LIVE DASHBOARD</span>
            <span style="font-size: 0.72rem; padding: 0.15rem 0.5rem; border-radius: 999px; background: #ef4444; color: #fff; margin-left: 0.25rem;">LIVE</span>
        </a>

        <div class="brand-logo" style="width: 52px; height: 52px; border-radius: 14px; box-shadow: 0 4px 15px rgba(212, 175, 55, 0.25); margin: 0 auto 0.75rem;">
            <span style="font-size: 1.5rem;">⚡</span>
        </div>
        <h1 style="font-size: 1.75rem; font-weight: 800; margin-bottom: 0.35rem; letter-spacing: -0.5px; font-family: 'Plus Jakarta Sans', sans-serif;">Auction Portal</h1>
        <p class="subtitle" style="color: var(--text-muted); margin-bottom: 1.8rem; font-size: 0.86rem; font-weight: 500;">Enter your credentials to access your dashboard.</p>
        
        <form action="/login" method="POST" class="stacked-form" id="loginForm">
            <div class="form-group" style="text-align: left; display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1rem;">
                <label for="username" style="font-size: 0.76rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px;">Username</label>
                <input type="text" id="username" name="username" required placeholder="Enter username" class="form-control form-control-lg" style="border-radius: 10px !important;">
            </div>
            <div class="form-group" style="text-align: left; display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1.6rem;">
                <label for="password" style="font-size: 0.76rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px;">Password</label>
                <input type="password" id="password" name="password" required placeholder="Enter password" class="form-control form-control-lg" style="border-radius: 10px !important;">
            </div>
            
            <button type="submit" class="btn btn-primary btn-lg btn-block" style="border-radius: 12px; font-weight: 700; font-size: 0.95rem; padding: 0.85rem; width: 100%;">Sign In</button>
        </form>

        <div style="margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border-color); display: flex; justify-content: center; gap: 1rem; font-size: 0.8rem;">
            <a href="/docs" target="_blank" style="color: var(--text-muted); text-decoration: none; display: flex; align-items: center; gap: 0.35rem; transition: color 0.2s;" onmouseover="this.style.color='#fbbf24'" onmouseout="this.style.color='var(--text-muted)'">
                <span>📖</span> Deployment Manual
            </a>
            <span style="color: rgba(255,255,255,0.2);">•</span>
            <a href="/docs/download" style="color: var(--text-muted); text-decoration: none; display: flex; align-items: center; gap: 0.35rem; transition: color 0.2s;" onmouseover="this.style.color='#38bdf8'" onmouseout="this.style.color='var(--text-muted)'">
                <span>📥</span> Download Docs
            </a>
        </div>
    </div>
</body>
</html>
